// Automobilista 2 - "Endurance Weather Board". Military / aerospace HUD: deep navy #0A192F,
// blueprint grid, technical panels framed by corner crosshairs, Share Tech Mono + Russo One.
// Pages: DASH (flags, gear, delta, fuel), WEATHER DESK, STRATEGY (map, pit plan, leaderboard).
// AMS2's UDP feed has rain density (not puddle depth) and no pit-menu settings, so "water on
// track" shows rain density and the pit plan is calculated from fuel use.

import { Sim, SimData, SimRow } from "../sim/sim_state.slint";
import { DashShell, DeltaStrip, RowItem } from "../sim/sim_widgets.slint";
import { Fonts, Texture } from "../kit.slint";
import { TrackMap } from "../map.slint";

global HudTheme {
    out property <color> navy: #0a192f;
    out property <color> panel: #0d2240cc;
    out property <color> line: #1f3a5f;
    out property <color> mint: #64ffda;
    out property <color> cyan: #4fc3f7;
    out property <color> text: #e6f1ff;
    out property <color> dim: #8892b0;
}

// Panel with crosshair corner marks.
component Tech inherits Rectangle {
    in property <string> title;
    min-height: 0px;
    preferred-height: 0px;
    min-width: 0px;
    preferred-width: 100px;
    background: HudTheme.panel;
    border-width: 1px;
    border-color: HudTheme.line;
    // Corner crosshairs.
    Rectangle { x: 0px; y: 0px; width: 30px; height: 4px; background: HudTheme.mint; }
    Rectangle { x: 0px; y: 0px; width: 4px; height: 30px; background: HudTheme.mint; }
    Rectangle { x: parent.width - 30px; y: 0px; width: 30px; height: 4px; background: HudTheme.mint; }
    Rectangle { x: parent.width - 4px; y: 0px; width: 4px; height: 30px; background: HudTheme.mint; }
    Rectangle { x: 0px; y: parent.height - 4px; width: 30px; height: 4px; background: HudTheme.mint; }
    Rectangle { x: 0px; y: parent.height - 30px; width: 4px; height: 30px; background: HudTheme.mint; }
    Rectangle { x: parent.width - 30px; y: parent.height - 4px; width: 30px; height: 4px; background: HudTheme.mint; }
    Rectangle { x: parent.width - 4px; y: parent.height - 30px; width: 4px; height: 30px; background: HudTheme.mint; }
    if root.title != "" : Text {
        x: 40px;
        y: 10px;
        text: "// " + root.title;
        color: HudTheme.mint;
        font-family: Fonts.mono;
        font-size: 26px;
    }
}

// Flag status square.
component FlagSquare inherits Rectangle {
    property <bool> active: Sim.data.banner-text != "" && !Sim.data.pit-limiter;
    background: self.active ? Sim.data.banner-color : #102a4a;
    border-width: 4px;
    border-color: self.active ? #ffffff : HudTheme.line;
    drop-shadow-blur: self.active ? 40px : 0px;
    drop-shadow-color: Sim.data.banner-color;
    opacity: self.active && !Sim.data.blink ? 0.75 : 1.0;
    Text {
        width: parent.width;
        height: parent.height;
        text: root.active ? Sim.data.banner-text : "GREEN";
        color: root.active ? Sim.data.banner-text-color : #2bd47a;
        font-family: Fonts.mono;
        font-size: 30px;
        wrap: word-wrap;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component HudValue inherits Tech {
    in property <string> value;
    in property <string> sub;
    in property <color> value-color: HudTheme.text;
    in property <length> size: 110px;
    VerticalLayout {
        padding: 20px;
        padding-top: 44px;
        alignment: center;
        Text { text: root.value; color: root.value-color; font-family: Fonts.russo; font-size: root.size; horizontal-alignment: center; overflow: elide; }
        if root.sub != "" : Text { text: root.sub; color: HudTheme.dim; font-family: Fonts.mono; font-size: 28px; horizontal-alignment: center; overflow: elide; }
    }
}

component HudDash inherits Rectangle {
    property <SimData> d: Sim.data;
    VerticalLayout {
        padding: 18px;
        spacing: 18px;
        // Gear / RPM between flag squares
        Tech {
            vertical-stretch: 7;
            title: "POWERTRAIN";
            HorizontalLayout {
                padding: 20px;
                padding-top: 50px;
                spacing: 20px;
                VerticalLayout {
                    width: 200px;
                    FlagSquare { height: 200px; }
                    Rectangle { vertical-stretch: 1; }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    Text { text: root.d.gear; color: HudTheme.text; font-family: Fonts.russo; font-size: 300px; horizontal-alignment: center; }
                    Rectangle {
                        height: 26px;
                        background: #061226;
                        border-width: 1px;
                        border-color: HudTheme.line;
                        Rectangle {
                            x: 0px;
                            height: parent.height;
                            width: parent.width * root.d.rpm-pct;
                            background: root.d.shift ? (root.d.blink ? #ff4d4d : #ffb000) : @linear-gradient(90deg, #1d6fa3 0%, #64ffda 100%);
                            animate width { duration: 60ms; }
                        }
                    }
                    Text { text: "\{root.d.rpm} RPM   ·   \{root.d.speed} " + root.d.speed-unit; color: HudTheme.cyan; font-family: Fonts.mono; font-size: 36px; horizontal-alignment: center; }
                }
                VerticalLayout {
                    width: 200px;
                    FlagSquare { height: 200px; }
                    Rectangle { vertical-stretch: 1; }
                }
            }
        }
        // Delta + position
        HorizontalLayout {
            vertical-stretch: 3;
            min-height: 0px;
            preferred-height: 0px;
            spacing: 18px;
            DeltaStrip {
                horizontal-stretch: 2;
                title: "// LAP DELTA";
                delta: root.d.delta;
                valid: root.d.has-delta;
                text: root.d.delta-text;
                bg: HudTheme.panel;
                faster: #1f9e6a;
                slower: #b3263b;
                title-color: HudTheme.mint;
                font: Fonts.russo;
                radius: 0px;
                font-size: 80px;
            }
            HudValue { horizontal-stretch: 1; title: "POSITION"; value: root.d.pos-text; size: 72px; }
        }
        // Fuel
        HorizontalLayout {
            vertical-stretch: 4;
            min-height: 0px;
            preferred-height: 0px;
            spacing: 18px;
            HudValue { title: "FUEL REMAINING"; value: root.d.fuel; sub: root.d.fuel-per-lap + " / LAP"; size: 90px; }
            HudValue {
                title: "LAPS OF FUEL";
                value: root.d.fuel-laps;
                sub: "ADD " + root.d.fuel-to-add;
                size: 110px;
                value-color: root.d.fuel-laps-num >= 0 && root.d.fuel-laps-num < 2 ? #ff4d4d : HudTheme.mint;
            }
        }
    }
}

component HudWeather inherits Rectangle {
    property <SimData> d: Sim.data;
    VerticalLayout {
        padding: 18px;
        spacing: 18px;
        HorizontalLayout {
            vertical-stretch: 4;
            min-height: 0px;
            preferred-height: 0px;
            spacing: 18px;
            HudValue { title: "TRACK SURFACE"; value: root.d.track-temp; size: 130px; value-color: #ffb36b; }
            HudValue { title: "AMBIENT"; value: root.d.air-temp; size: 130px; value-color: HudTheme.cyan; }
        }
        // Water on track tank
        Tech {
            vertical-stretch: 6;
            title: "WATER ON TRACK  ·  " + root.d.weather;
            HorizontalLayout {
                padding: 26px;
                padding-top: 56px;
                spacing: 30px;
                Rectangle {
                    width: 280px;
                    background: #06162e;
                    border-width: 3px;
                    border-color: HudTheme.cyan;
                    clip: true;
                    Rectangle {
                        x: 0px;
                        width: parent.width;
                        height: parent.height * root.d.rain-pct / 100;
                        y: parent.height - self.height;
                        background: @linear-gradient(0deg, #0b4fa8 0%, #4fc3f7 100%);
                        animate height { duration: 600ms; easing: ease-out; }
                    }
                    for i in 4 : Rectangle { x: 0px; y: parent.height * (i + 1) / 5; width: 40px; height: 2px; background: #ffffff55; }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    Text { text: "\{root.d.rain-pct}%"; color: root.d.rain-pct > 40 ? HudTheme.cyan : HudTheme.text; font-family: Fonts.russo; font-size: 160px; }
                    Text { text: root.d.rain-pct > 40 ? "WETS ADVISED" : (root.d.rain-pct > 10 ? "MONITOR" : "DRY RUNNING"); color: root.d.rain-pct > 40 ? #ffb000 : HudTheme.mint; font-family: Fonts.mono; font-size: 40px; }
                }
            }
        }
        // Wind
        Tech {
            vertical-stretch: 5;
            title: "WIND";
            HorizontalLayout {
                padding: 26px;
                padding-top: 50px;
                spacing: 30px;
                Rectangle {
                    width: 300px;
                    property <length> side: min(self.width, self.height);
                    Rectangle {
                        x: (parent.width - parent.side) / 2;
                        y: (parent.height - parent.side) / 2;
                        width: parent.side;
                        height: parent.side;
                        border-radius: parent.side / 2;
                        background: #06162e;
                        border-width: 3px;
                        border-color: HudTheme.line;
                        Text { y: 6px; width: parent.width; text: "N"; color: HudTheme.mint; font-family: Fonts.mono; font-size: 28px; horizontal-alignment: center; }
                        Image {
                            x: parent.width * 0.15;
                            y: parent.height * 0.15;
                            width: parent.width * 0.7;
                            height: parent.height * 0.7;
                            source: @image-url("../img/arrow.svg");
                            rotation-angle: root.d.wind-deg * 1deg;
                            opacity: root.d.has-wind-dir ? 1.0 : 0.25;
                            animate rotation-angle { duration: 800ms; }
                        }
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    Text { text: root.d.wind; color: HudTheme.text; font-family: Fonts.russo; font-size: 110px; overflow: elide; }
                    Text { text: root.d.has-wind-dir ? "DIRECTION SHOWN" : "NO DIRECTION DATA"; color: HudTheme.dim; font-family: Fonts.mono; font-size: 28px; }
                }
            }
        }
    }
}

component HudStrategy inherits Rectangle {
    property <SimData> d: Sim.data;
    VerticalLayout {
        padding: 18px;
        spacing: 18px;
        Tech {
            vertical-stretch: 6;
            title: "TRACK";
            TrackMap {
                width: parent.width;
                height: parent.height;
                path: Sim.map-path;
                dots: Sim.map-dots;
                note: Sim.data.map-note;
                track-color: HudTheme.cyan;
                track-edge: #000000;
                player-color: HudTheme.mint;
                car-color: #ffffff;
                note-color: HudTheme.dim;
                line-width: 10px;
                dot-size: 30px;
            }
        }
        // Pit planner
        Tech {
            vertical-stretch: 3;
            title: "PIT STOP PLANNER";
            GridLayout {
                padding: 20px;
                padding-top: 48px;
                spacing: 8px;
                Row {
                    Text { text: "FUEL TO ADD"; color: HudTheme.dim; font-family: Fonts.mono; font-size: 24px; }
                    Text { text: "FUEL / LAP"; color: HudTheme.dim; font-family: Fonts.mono; font-size: 24px; }
                    Text { text: "TYRE WEAR"; color: HudTheme.dim; font-family: Fonts.mono; font-size: 24px; }
                }
                Row {
                    Text { text: root.d.fuel-to-add; color: HudTheme.mint; font-family: Fonts.russo; font-size: 48px; overflow: elide; }
                    Text { text: root.d.fuel-per-lap; color: HudTheme.text; font-family: Fonts.russo; font-size: 48px; overflow: elide; }
                    Text { text: root.d.fl.wear + " / " + root.d.rr.wear; color: HudTheme.text; font-family: Fonts.russo; font-size: 48px; overflow: elide; }
                }
            }
        }
        // Leaderboard
        Tech {
            vertical-stretch: 7;
            title: "LEADERBOARD";
            VerticalLayout {
                padding: 14px;
                padding-top: 48px;
                spacing: 4px;
                for r in Sim.standings : RowItem {
                    vertical-stretch: 1;
                    item: r;
                    bg: #0a1c36;
                    player-bg: #64ffda44;
                    dim: HudTheme.dim;
                    font: Fonts.mono;
                    font-size: 26px;
                    radius: 0px;
                }
                Rectangle { vertical-stretch: 0.01; }
            }
        }
        // Stint progress
        Rectangle {
            vertical-stretch: 1;
            min-height: 0px;
            preferred-height: 0px;
            background: #06162e;
            border-width: 1px;
            border-color: HudTheme.line;
            Rectangle {
                x: 0px;
                height: parent.height;
                width: parent.width * root.d.stint-pct;
                background: @linear-gradient(90deg, #1d6fa3 0%, #64ffda 100%);
                animate width { duration: 400ms; }
            }
            Text {
                width: parent.width;
                height: parent.height;
                text: "STINT " + root.d.stint-time + "   ·   SESSION LEFT " + root.d.time-left;
                color: #ffffff;
                font-family: Fonts.mono;
                font-size: 28px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}

export component Ams2Dash inherits DashShell {
    background: HudTheme.navy;
    tabs: [
        { label: "DASH", icon: @image-url("../img/icons/gauge.svg") },
        { label: "WEATHER", icon: @image-url("../img/icons/cloud.svg") },
        { label: "STRATEGY", icon: @image-url("../img/icons/list.svg") }
    ];
    accent: HudTheme.mint;
    dock-bg: #071326;
    dock-idle: #0d2240;
    dock-text: HudTheme.text;
    dock-active-text: #001a14;
    pill-idle: #0d2240;
    pill-idle-text: HudTheme.dim;
    font: Fonts.mono;
    radius: 0px;

    Texture { width: parent.width; height: parent.height; source: @image-url("../img/blueprint.svg"); }
    if Sim.layout == 0 : HudDash { width: parent.width; height: parent.height; }
    if Sim.layout == 1 : HudWeather { width: parent.width; height: parent.height; }
    if Sim.layout >= 2 : HudStrategy { width: parent.width; height: parent.height; }
}
