// Automobilista 2 - "Endurance Weather Board". Military / aerospace HUD: deep navy #0A192F,
// blueprint grid, technical panels framed by corner crosshairs, Share Tech Mono + Russo One.
// Pages: DASH (flags, gear, delta, fuel), WEATHER DESK, STRATEGY (map, pit plan, leaderboard).
// AMS2's UDP feed has rain density (not puddle depth) and no pit-menu settings, so "water on
// track" shows rain density and the pit plan is calculated from fuel use.

import { Sim, SimData, SimRow } from "../sim/sim_state.slint";
import { DashShell, DeltaStrip, RowItem } from "../sim/sim_widgets.slint";
import { Fonts, Texture, StatStrip, Stat, FadePage } from "../kit.slint";
import { AppState } from "../globals.slint";
import { TrackMap } from "../map.slint";
import { Art } from "../art.slint";

global HudTheme {
    out property <color> navy: #0a192f;
    // Panel fills, see-through per the PANELS setting.
    out property <color> panel: rgba(13, 34, 64, 0.8 * AppState.panel);
    out property <color> well: rgba(6, 22, 46, AppState.panel);
    out property <color> cell: rgba(16, 42, 74, AppState.panel);
    out property <color> row: rgba(10, 28, 54, AppState.panel);
    out property <color> line: #1f3a5f;
    out property <color> mint: #64ffda;
    out property <color> cyan: #4fc3f7;
    out property <color> text: #e6f1ff;
    out property <color> dim: #8892b0;
}

// Panel with crosshair corner marks.
component Tech inherits Rectangle {
    in property <string> title;
    min-height: 0px;
    preferred-height: 0px;
    min-width: 0px;
    preferred-width: 100px;
    background: HudTheme.panel;
    border-width: 1px;
    border-color: HudTheme.line;
    if Art.panel-ams2-custom : Image { width: parent.width; height: parent.height; source: Art.panel-ams2; image-fit: cover; opacity: 0.25; }
    // Corner crosshairs.
    Rectangle { x: 0px; y: 0px; width: 30px; height: 4px; background: HudTheme.mint; }
    Rectangle { x: 0px; y: 0px; width: 4px; height: 30px; background: HudTheme.mint; }
    Rectangle { x: parent.width - 30px; y: 0px; width: 30px; height: 4px; background: HudTheme.mint; }
    Rectangle { x: parent.width - 4px; y: 0px; width: 4px; height: 30px; background: HudTheme.mint; }
    Rectangle { x: 0px; y: parent.height - 4px; width: 30px; height: 4px; background: HudTheme.mint; }
    Rectangle { x: 0px; y: parent.height - 30px; width: 4px; height: 30px; background: HudTheme.mint; }
    Rectangle { x: parent.width - 30px; y: parent.height - 4px; width: 30px; height: 4px; background: HudTheme.mint; }
    Rectangle { x: parent.width - 4px; y: parent.height - 30px; width: 4px; height: 30px; background: HudTheme.mint; }
    if root.title != "" : Text {
        x: 40px;
        y: 10px;
        text: "// " + root.title;
        color: HudTheme.mint;
        font-family: Fonts.mono;
        font-size: 26px;
    }
}

// HUD-style stat strip.
component HudStrip inherits StatStrip {
    texture: Art.panel-ams2;
    textured: Art.panel-ams2-custom;
    cell-bg: HudTheme.panel;
    edge: HudTheme.line;
    label-color: HudTheme.mint;
    value-color: HudTheme.text;
    font: Fonts.russo;
    label-font: Fonts.mono;
    value-size: 34px;
    label-size: 18px;
    radius: 0px;
    gap: 12px;
}

// Flag status square.
component FlagSquare inherits Rectangle {
    property <bool> active: Sim.data.banner-text != "" && !Sim.data.pit-limiter;
    background: self.active ? Sim.data.banner-color : HudTheme.cell;
    border-width: 4px;
    border-color: self.active ? #ffffff : HudTheme.line;
    drop-shadow-blur: self.active ? 40px : 0px;
    drop-shadow-color: Sim.data.banner-color;
    opacity: self.active && !Sim.data.blink ? 0.75 : 1.0;
    Text {
        width: parent.width;
        height: parent.height;
        text: root.active ? Sim.data.banner-text : "GREEN";
        color: root.active ? Sim.data.banner-text-color : #2bd47a;
        font-family: Fonts.mono;
        font-size: 24px;
        wrap: word-wrap;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component HudValue inherits Tech {
    in property <string> value;
    in property <string> sub;
    in property <color> value-color: HudTheme.text;
    in property <length> size: 72px;
    VerticalLayout {
        padding: 14px;
        padding-top: 38px;
        alignment: center;
        Text { text: root.value; color: root.value-color; font-family: Fonts.russo; font-size: root.size; horizontal-alignment: center; overflow: elide; }
        if root.sub != "" : Text { text: root.sub; color: HudTheme.dim; font-family: Fonts.mono; font-size: 22px; horizontal-alignment: center; overflow: elide; }
    }
}

component HudDash inherits FadePage {
    property <SimData> d: Sim.data;
    VerticalLayout {
        padding: 18px;
        spacing: 18px;
        // Gear / RPM between flag squares
        Tech {
            vertical-stretch: 5;
            title: "POWERTRAIN";
            HorizontalLayout {
                padding: 20px;
                padding-top: 50px;
                spacing: 20px;
                VerticalLayout {
                    width: 170px;
                    FlagSquare { height: 150px; }
                    Rectangle { vertical-stretch: 1; }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    Text { text: root.d.gear; color: HudTheme.text; font-family: Fonts.russo; font-size: 200px; horizontal-alignment: center; }
                    Rectangle {
                        height: 26px;
                        background: HudTheme.well;
                        border-width: 1px;
                        border-color: HudTheme.line;
                        Rectangle {
                            x: 0px;
                            height: parent.height;
                            width: parent.width * root.d.rpm-pct;
                            background: root.d.shift ? (root.d.blink ? #ff4d4d : #ffb000) : @linear-gradient(90deg, #1d6fa3 0%, #64ffda 100%);
                            animate width { duration: 60ms; }
                        }
                    }
                    Text { text: "\{root.d.rpm} RPM   ·   \{root.d.speed} " + root.d.speed-unit; color: HudTheme.cyan; font-family: Fonts.mono; font-size: 30px; horizontal-alignment: center; }
                }
                VerticalLayout {
                    width: 170px;
                    FlagSquare { height: 150px; }
                    Rectangle { vertical-stretch: 1; }
                }
            }
        }
        // Delta + position
        HorizontalLayout {
            vertical-stretch: 2;
            min-height: 0px;
            preferred-height: 0px;
            spacing: 18px;
            DeltaStrip {
                horizontal-stretch: 2;
                title: "// LAP DELTA";
                delta: root.d.delta;
                valid: root.d.has-delta;
                text: root.d.delta-text;
                bg: HudTheme.panel;
                faster: #1f9e6a;
                slower: #b3263b;
                title-color: HudTheme.mint;
                font: Fonts.russo;
                radius: 0px;
                font-size: 60px;
            }
            HudValue { horizontal-stretch: 1; title: "POSITION"; value: root.d.pos-text; size: 56px; }
        }
        // Lap times
        HudStrip {
            vertical-stretch: 1.3;
            stats: [
                { label: root.d.lap-invalid ? "CURRENT · INV" : "CURRENT", value: root.d.current-lap, tint: root.d.lap-invalid ? #ff4d4d : transparent },
                { label: "LAST", value: root.d.last-lap, tint: transparent },
                { label: "BEST", value: root.d.best-lap, tint: HudTheme.mint },
                { label: "ALL-TIME", value: root.d.pb-lap, tint: #c08bff },
                { label: "LAST VS PB", value: root.d.pb-gap == "" ? "--" : root.d.pb-gap, tint: root.d.pb-gap == "" ? HudTheme.dim : (root.d.pb-gap-good ? HudTheme.mint : #ff4d4d) }
            ];
        }
        // Tyres
        HudStrip {
            vertical-stretch: 1.3;
            stats: [
                { label: "FL", value: root.d.fl.temp, tint: root.d.fl.temp-color },
                { label: "FR", value: root.d.fr.temp, tint: root.d.fr.temp-color },
                { label: "RL", value: root.d.rl.temp, tint: root.d.rl.temp-color },
                { label: "RR", value: root.d.rr.temp, tint: root.d.rr.temp-color },
                { label: "AHEAD", value: root.d.gap-ahead, tint: transparent },
                { label: "BEHIND", value: root.d.gap-behind, tint: transparent }
            ];
        }
        // Fuel
        HorizontalLayout {
            vertical-stretch: 3;
            min-height: 0px;
            preferred-height: 0px;
            spacing: 18px;
            HudValue { title: "FUEL REMAINING"; value: root.d.fuel; sub: root.d.fuel-per-lap + " / LAP"; size: 64px; }
            HudValue {
                title: "LAPS OF FUEL";
                value: root.d.fuel-laps;
                sub: "ADD " + root.d.fuel-to-add;
                size: 72px;
                value-color: root.d.fuel-laps-num >= 0 && root.d.fuel-laps-num < 2 ? #ff4d4d : HudTheme.mint;
            }
        }
    }
}

component HudWeather inherits FadePage {
    property <SimData> d: Sim.data;
    // Weather icon (only if the matching AI icon exists in the art folder).
    property <bool> snow: root.d.weather == "SNOW";
    property <int> level: root.snow ? 4 : (root.d.rain-pct > 60 ? 3 : (root.d.rain-pct > 20 ? 2 : (root.d.rain-pct > 2 ? 1 : 0)));
    property <image> icon: root.level == 4 ? Art.weather-snow : (root.level == 3 ? Art.weather-storm : (root.level == 2 ? Art.weather-rain : (root.level == 1 ? Art.weather-cloud : Art.weather-clear)));
    property <bool> has-icon: root.level == 4 ? Art.weather-snow-custom : (root.level == 3 ? Art.weather-storm-custom : (root.level == 2 ? Art.weather-rain-custom : (root.level == 1 ? Art.weather-cloud-custom : Art.weather-clear-custom)));
    VerticalLayout {
        padding: 18px;
        spacing: 18px;
        HorizontalLayout {
            vertical-stretch: 3;
            min-height: 0px;
            preferred-height: 0px;
            spacing: 18px;
            HudValue { title: "TRACK SURFACE"; value: root.d.track-temp; size: 80px; value-color: #ffb36b; }
            HudValue { title: "AMBIENT"; value: root.d.air-temp; size: 80px; value-color: HudTheme.cyan; }
        }
        // Water on track tank
        Tech {
            vertical-stretch: 6;
            title: "WATER ON TRACK  ·  " + root.d.weather;
            HorizontalLayout {
                padding: 26px;
                padding-top: 56px;
                spacing: 30px;
                Rectangle {
                    width: 280px;
                    background: HudTheme.well;
                    border-width: 3px;
                    border-color: HudTheme.cyan;
                    clip: true;
                    Rectangle {
                        x: 0px;
                        width: parent.width;
                        height: parent.height * root.d.rain-pct / 100;
                        y: parent.height - self.height;
                        background: @linear-gradient(0deg, #0b4fa8 0%, #4fc3f7 100%);
                        animate height { duration: 600ms; easing: ease-out; }
                    }
                    for i in 4 : Rectangle { x: 0px; y: parent.height * (i + 1) / 5; width: 40px; height: 2px; background: #ffffff55; }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    if root.has-icon : Image { height: 150px; source: root.icon; image-fit: contain; }
                    Text { text: "\{root.d.rain-pct}%"; color: root.d.rain-pct > 40 ? HudTheme.cyan : HudTheme.text; font-family: Fonts.russo; font-size: 100px; }
                    Text { text: root.d.rain-pct > 40 ? "WETS ADVISED" : (root.d.rain-pct > 10 ? "MONITOR" : "DRY RUNNING"); color: root.d.rain-pct > 40 ? #ffb000 : HudTheme.mint; font-family: Fonts.mono; font-size: 30px; }
                }
            }
        }
        // Wind
        Tech {
            vertical-stretch: 4;
            title: "WIND";
            HorizontalLayout {
                padding: 26px;
                padding-top: 50px;
                spacing: 30px;
                Rectangle {
                    width: 300px;
                    property <length> side: min(self.width, self.height);
                    Rectangle {
                        x: (parent.width - parent.side) / 2;
                        y: (parent.height - parent.side) / 2;
                        width: parent.side;
                        height: parent.side;
                        border-radius: parent.side / 2;
                        background: HudTheme.well;
                        border-width: 3px;
                        border-color: HudTheme.line;
                        Text { y: 6px; width: parent.width; text: "N"; color: HudTheme.mint; font-family: Fonts.mono; font-size: 28px; horizontal-alignment: center; }
                        Image {
                            x: parent.width * 0.15;
                            y: parent.height * 0.15;
                            width: parent.width * 0.7;
                            height: parent.height * 0.7;
                            source: @image-url("../img/arrow.svg");
                            transform-rotation: root.d.wind-deg * 1deg;
                            opacity: root.d.has-wind-dir ? 1.0 : 0.25;
                            animate transform-rotation { duration: 800ms; }
                        }
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    Text { text: root.d.wind; color: HudTheme.text; font-family: Fonts.russo; font-size: 72px; overflow: elide; }
                    Text { text: root.d.has-wind-dir ? "DIRECTION SHOWN" : "NO DIRECTION DATA"; color: HudTheme.dim; font-family: Fonts.mono; font-size: 24px; }
                }
            }
        }
        HudStrip {
            vertical-stretch: 1.3;
            stats: [
                { label: "SESSION LEFT", value: root.d.time-left == "" ? "--" : root.d.time-left, tint: transparent },
                { label: "STINT", value: root.d.stint-time, tint: transparent },
                { label: "FUEL LAPS", value: root.d.fuel-laps, tint: transparent },
                { label: "POSITION", value: root.d.pos-text, tint: transparent },
                { label: "LAST", value: root.d.last-lap, tint: transparent }
            ];
        }    }
}

component HudStrategy inherits FadePage {
    property <SimData> d: Sim.data;
    VerticalLayout {
        padding: 18px;
        spacing: 18px;
        Tech {
            vertical-stretch: 6;
            title: "TRACK";
            TrackMap {
                width: parent.width;
                height: parent.height;
                path: Sim.map-path;
                dots: Sim.map-dots;
                note: Sim.data.map-note;
                track-color: HudTheme.cyan;
                track-edge: #000000;
                player-color: HudTheme.mint;
                car-color: #ffffff;
                note-color: HudTheme.dim;
                line-width: 10px;
                dot-size: 30px;
            }
        }
        // Pit planner
        Tech {
            vertical-stretch: 3;
            title: "PIT STOP PLANNER";
            GridLayout {
                padding: 20px;
                padding-top: 48px;
                spacing: 8px;
                Row {
                    Text { text: "FUEL TO ADD"; color: HudTheme.dim; font-family: Fonts.mono; font-size: 24px; }
                    Text { text: "FUEL / LAP"; color: HudTheme.dim; font-family: Fonts.mono; font-size: 24px; }
                    Text { text: "TYRE WEAR"; color: HudTheme.dim; font-family: Fonts.mono; font-size: 24px; }
                }
                Row {
                    Text { text: root.d.fuel-to-add; color: HudTheme.mint; font-family: Fonts.russo; font-size: 40px; overflow: elide; }
                    Text { text: root.d.fuel-per-lap; color: HudTheme.text; font-family: Fonts.russo; font-size: 40px; overflow: elide; }
                    Text { text: root.d.fl.wear + " / " + root.d.rr.wear; color: HudTheme.text; font-family: Fonts.russo; font-size: 40px; overflow: elide; }
                }
            }
        }
        // Leaderboard
        Tech {
            vertical-stretch: 7;
            title: "LEADERBOARD";
            VerticalLayout {
                padding: 14px;
                padding-top: 48px;
                spacing: 4px;
                if Sim.standings.length == 0 : VerticalLayout {
                    vertical-stretch: 1;
                    alignment: center;
                    spacing: 8px;
                    Text { text: "// AWAITING TIMING FEED"; color: HudTheme.mint; font-family: Fonts.mono; font-size: 28px; horizontal-alignment: center; }
                    Text { text: "THE FIELD APPEARS ONCE THE SESSION STARTS"; color: HudTheme.dim; font-family: Fonts.mono; font-size: 20px; horizontal-alignment: center; }
                }
                for r in Sim.standings : RowItem {
                    vertical-stretch: 1;
                    item: r;
                    bg: HudTheme.row;
                    player-bg: #64ffda44;
                    dim: HudTheme.dim;
                    font: Fonts.mono;
                    font-size: 30px;
                    radius: 0px;
                }
                Rectangle { vertical-stretch: 0.01; }
            }
        }
        // Stint progress
        Rectangle {
            vertical-stretch: 1;
            min-height: 0px;
            preferred-height: 0px;
            background: HudTheme.well;
            border-width: 1px;
            border-color: HudTheme.line;
            Rectangle {
                x: 0px;
                height: parent.height;
                width: parent.width * root.d.stint-pct;
                background: @linear-gradient(90deg, #1d6fa3 0%, #64ffda 100%);
                animate width { duration: 400ms; }
            }
            Text {
                width: parent.width;
                height: parent.height;
                text: "STINT " + root.d.stint-time + "   ·   SESSION LEFT " + root.d.time-left;
                color: #ffffff;
                font-family: Fonts.mono;
                font-size: 28px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}

export component Ams2Dash inherits DashShell {
    waiting-art: Art.tile-ams2;
    waiting-has-art: Art.tile-ams2-custom;
    waiting-emblem: Art.emblem-ams2;
    waiting-card: #0a192f;
    background: HudTheme.navy;
    tabs: [
        { label: "DASH", icon: @image-url("../img/icons/gauge.svg") },
        { label: "WEATHER", icon: @image-url("../img/icons/cloud.svg") },
        { label: "STRATEGY", icon: @image-url("../img/icons/list.svg") }
    ];
    accent: HudTheme.mint;
    dock-bg: #071326;
    dock-idle: #0d2240;
    dock-text: HudTheme.text;
    dock-active-text: #001a14;
    pill-idle: #0d2240;
    pill-idle-text: HudTheme.dim;
    font: Fonts.mono;
    radius: 0px;

    Texture { y: 0px; width: root.width; height: root.page-height; source: Art.bg-ams2; }
    if Sim.layout == 0 : HudDash { y: 0px; width: root.width; height: root.page-height; }
    if Sim.layout == 1 : HudWeather { y: 0px; width: root.width; height: root.page-height; }
    if Sim.layout >= 2 : HudStrategy { y: 0px; width: root.width; height: root.page-height; }
}
