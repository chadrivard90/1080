// NASCAR 26 - "Spotter & Strategy". TV broadcast HUD: clean white, racing blue #0033A0, red
// #DA291C, metallic banners with heavy 3D drop shadows, Anton / Bebas Neue type.
// Pages: THE PACK (radar, speed, gear, RPM), THE DRAFT (pylon, map, caution), PIT BOX.

import { Sim, SimData, Corner } from "../sim/sim_state.slint";
import { DashShell, ShiftLights, RowItem } from "../sim/sim_widgets.slint";
import { Fonts, StatStrip, Stat, FadePage, LapChart } from "../kit.slint";
import { AppState } from "../globals.slint";
import { TrackMap } from "../map.slint";
import { Art } from "../art.slint";

global NascarTheme {
    out property <color> blue: #0033a0;
    out property <color> deep: #001a57;
    out property <color> red: #da291c;
    out property <color> yellow: #ffd400;
    out property <color> paper: #f4f5f8;
    out property <color> ink: #0b1430;
    // Banner opacity: light panels keep more body than dark ones so the ink text stays crisp.
    out property <float> a: 0.3 + 0.7 * AppState.panel;
    out property <brush> metal: @linear-gradient(180deg, rgba(255, 255, 255, root.a) 0%, rgba(212, 217, 226, root.a) 55%, rgba(247, 248, 251, root.a) 100%);
    out property <brush> blue-fill: @linear-gradient(180deg, rgba(29, 79, 196, root.a) 0%, rgba(0, 51, 160, root.a) 60%, rgba(0, 26, 87, root.a) 100%);
    out property <brush> red-fill: @linear-gradient(180deg, rgba(240, 71, 58, root.a) 0%, rgba(218, 41, 28, root.a) 60%, rgba(143, 21, 12, root.a) 100%);
    out property <brush> map-fill: @linear-gradient(180deg, rgba(10, 42, 122, AppState.panel) 0%, rgba(0, 26, 87, AppState.panel) 100%);
    out property <color> ink-fill: rgba(11, 20, 48, AppState.panel);
    out property <color> row-a: rgba(221, 226, 234, root.a);
    out property <color> row-b: rgba(244, 245, 248, root.a);
    out property <color> shadow: rgba(11, 20, 48, 0.53 * AppState.shade);
}

// Metallic broadcast banner with a hard offset shadow.
component Banner inherits Rectangle {
    in property <brush> fill: NascarTheme.metal;
    min-height: 0px;
    preferred-height: 0px;
    min-width: 0px;
    preferred-width: 100px;
    background: root.fill;
    border-radius: 6px;
    border-width: 3px;
    border-color: NascarTheme.ink;
    drop-shadow-offset-x: 8px;
    drop-shadow-offset-y: 10px;
    drop-shadow-color: NascarTheme.shadow;
    drop-shadow-blur: 0px;
    clip: true;
    if Art.panel-nascar-custom : Image { width: parent.width; height: parent.height; source: Art.panel-nascar; image-fit: cover; opacity: 0.25; }
}

// Broadcast-style stat strip (metal cells, ink digits).
component NascarStrip inherits StatStrip {
    texture: Art.panel-nascar;
    textured: Art.panel-nascar-custom;
    cell-bg: NascarTheme.metal;
    edge: NascarTheme.ink;
    label-color: NascarTheme.red;
    value-color: NascarTheme.ink;
    font: Fonts.anton;
    label-font: Fonts.bebas;
    value-size: 40px;
    label-size: 24px;
    radius: 4px;
    gap: 12px;
}

// Blind-spot radar strip on the screen edge.
component RadarEdge inherits Rectangle {
    in property <int> cars;
    in property <string> side;
    border-radius: 10px;
    background: root.cars == 0 ? NascarTheme.row-a : (root.cars >= 2 ? #ff8a00 : NascarTheme.yellow);
    opacity: root.cars > 0 && !Sim.data.blink ? 0.55 : 1.0;
    border-width: 4px;
    border-color: NascarTheme.ink;
    drop-shadow-offset-x: 6px;
    drop-shadow-offset-y: 8px;
    drop-shadow-color: NascarTheme.shadow;
    VerticalLayout {
        alignment: center;
        spacing: 10px;
        // A car alongside: the stock-car art if present, otherwise the letters C A R.
        if root.cars > 0 && Art.car-stock-custom : Image { height: 240px; source: Art.car-stock; image-fit: contain; }
        for ch in ["C", "A", "R"] : Text {
            text: root.cars == 0 || Art.car-stock-custom ? "" : ch;
            color: NascarTheme.ink;
            font-family: Fonts.anton;
            font-size: 56px;
            horizontal-alignment: center;
        }
        Text {
            text: root.cars >= 2 ? "x2" : root.side;
            color: root.cars == 0 ? #9aa3b5 : NascarTheme.ink;
            font-family: Fonts.anton;
            font-size: 40px;
            horizontal-alignment: center;
        }
    }
}

component PackPage inherits FadePage {
    property <SimData> d: Sim.data;
    HorizontalLayout {
        padding: 16px;
        spacing: 16px;
        RadarEdge { width: 100px; cars: root.d.spotter-left; side: "L"; }
        VerticalLayout {
            spacing: 20px;
            // Speedometer
            Banner {
                vertical-stretch: 4;
                VerticalLayout {
                    alignment: center;
                    Text { text: "\{root.d.speed}"; color: NascarTheme.ink; font-family: Fonts.anton; font-size: 180px; horizontal-alignment: center; }
                    Text { text: root.d.speed-unit; color: NascarTheme.red; font-family: Fonts.bebas; font-size: 40px; letter-spacing: 10px; horizontal-alignment: center; }
                }
            }
            // Gear + position
            HorizontalLayout {
                vertical-stretch: 4;
                min-height: 0px;
                preferred-height: 0px;
                spacing: 20px;
                Banner {
                    fill: NascarTheme.blue-fill;
                    VerticalLayout {
                        alignment: center;
                        Text { text: "GEAR"; color: #ffffffbb; font-family: Fonts.bebas; font-size: 30px; letter-spacing: 6px; horizontal-alignment: center; }
                        Text { text: root.d.gear; color: #ffffff; font-family: Fonts.anton; font-size: 190px; horizontal-alignment: center; }
                    }
                }
                Banner {
                    fill: NascarTheme.red-fill;
                    VerticalLayout {
                        alignment: center;
                        Text { text: "POS"; color: #ffffffbb; font-family: Fonts.bebas; font-size: 30px; letter-spacing: 6px; horizontal-alignment: center; }
                        Text { text: root.d.position > 0 ? "\{root.d.position}" : "--"; color: #ffffff; font-family: Fonts.anton; font-size: 140px; horizontal-alignment: center; }
                        Text { text: root.d.lap-text; color: #ffffffcc; font-family: Fonts.bebas; font-size: 32px; horizontal-alignment: center; }
                        Text { text: "OF \{root.d.num-cars}"; color: #ffffff99; font-family: Fonts.bebas; font-size: 26px; horizontal-alignment: center; }
                    }
                }
            }
            // Lap times, gaps, fuel
            NascarStrip {
                vertical-stretch: 2;
                stats: [
                    { label: "LAST", value: root.d.last-lap, tint: transparent },
                    { label: "BEST", value: root.d.best-lap, tint: transparent },
                    { label: "AHEAD", value: root.d.gap-ahead, tint: transparent },
                    { label: "FUEL LAPS", value: root.d.fuel-laps, tint: root.d.fuel-laps-num >= 0 && root.d.fuel-laps-num < 2 ? NascarTheme.red : transparent }
                ];
            }
            // RPM light bar
            Banner {
                vertical-stretch: 2;
                fill: NascarTheme.ink-fill;
                VerticalLayout {
                    padding: 14px;
                    spacing: 6px;
                    ShiftLights { vertical-stretch: 1; low: #22c55e; mid: NascarTheme.yellow; high: NascarTheme.red; flash: NascarTheme.red; off: #1a2440; radius: 6px; gap: 6px; }
                    Text { text: "\{root.d.rpm} RPM"; color: #ffffff; font-family: Fonts.bebas; font-size: 32px; letter-spacing: 4px; horizontal-alignment: center; }
                }
            }
        }
        RadarEdge { width: 100px; cars: root.d.spotter-right; side: "R"; }
    }
}

component DraftPage inherits FadePage {
    property <SimData> d: Sim.data;
    property <bool> caution: root.d.banner-text == "CAUTION" || root.d.banner-text == "YELLOW FLAG";
    VerticalLayout {
        padding: 20px;
        spacing: 22px;
        // The pylon: 3 ahead, you, 3 behind.
        Banner {
            vertical-stretch: 7;
            fill: NascarTheme.ink-fill;
            VerticalLayout {
                padding: 10px;
                spacing: 6px;
                Rectangle {
                    height: 52px;
                    background: NascarTheme.red;
                    Text { width: parent.width; height: parent.height; text: "THE PYLON  ·  RELATIVE"; color: #ffffff; font-family: Fonts.bebas; font-size: 36px; letter-spacing: 4px; horizontal-alignment: center; vertical-alignment: center; }
                }
                for r[i] in Sim.relative : RowItem {
                    vertical-stretch: 1;
                    item: r;
                    bg: i == 1 || i == 3 || i == 5 ? NascarTheme.row-a : NascarTheme.row-b;
                    player-bg: NascarTheme.blue;
                    player-text: #ffffff;
                    text-color: NascarTheme.ink;
                    dim: #5b6680;
                    pit-color: NascarTheme.red;
                    font: Fonts.bebas;
                    font-size: 40px;
                    radius: 2px;
                }
            }
        }
        // Map + gaps
        HorizontalLayout {
            vertical-stretch: 5;
            min-height: 0px;
            preferred-height: 0px;
            spacing: 22px;
            Banner {
                horizontal-stretch: 3;
                fill: NascarTheme.map-fill;
                TrackMap {
                    width: parent.width;
                    height: parent.height;
                    path: Sim.map-path;
                    dots: Sim.map-dots;
                    note: Sim.data.map-note;
                    track-color: #e8ecf8;
                    track-edge: #000000;
                    player-color: NascarTheme.red;
                    car-color: NascarTheme.yellow;
                    note-color: #c9d3ee;
                    line-width: 20px;
                    dot-size: 34px;
                }
            }
            Banner {
                horizontal-stretch: 2;
                VerticalLayout {
                    alignment: center;
                    Text { text: "CAR AHEAD"; color: NascarTheme.red; font-family: Fonts.bebas; font-size: 32px; letter-spacing: 4px; horizontal-alignment: center; }
                    Text { text: root.d.gap-ahead; color: NascarTheme.ink; font-family: Fonts.anton; font-size: 64px; horizontal-alignment: center; overflow: elide; }
                    Text { text: "BEHIND  " + root.d.gap-behind; color: #5b6680; font-family: Fonts.bebas; font-size: 32px; horizontal-alignment: center; overflow: elide; }
                    Text { text: "LAST  " + root.d.last-lap; color: NascarTheme.ink; font-family: Fonts.bebas; font-size: 32px; horizontal-alignment: center; overflow: elide; }
                    Text { text: "BEST  " + root.d.best-lap; color: NascarTheme.ink; font-family: Fonts.bebas; font-size: 32px; horizontal-alignment: center; overflow: elide; }
                    Text { text: "ALL-TIME  " + root.d.pb-lap; color: #7a2cff; font-family: Fonts.bebas; font-size: 32px; horizontal-alignment: center; overflow: elide; }
                }
            }
        }
        // Full-width caution flag
        Rectangle {
            vertical-stretch: 1.6;
            min-height: 0px;
            preferred-height: 0px;
            border-radius: 6px;
            background: root.caution ? (Sim.data.blink ? NascarTheme.yellow : #ffe866) : #1f7a35;
            border-width: 4px;
            border-color: NascarTheme.ink;
            drop-shadow-offset-x: 8px;
            drop-shadow-offset-y: 10px;
            drop-shadow-color: NascarTheme.shadow;
            // Waving flag art at the left of the panel, when it exists.
            if (root.caution && Art.flag-yellow-custom) || (!root.caution && Art.flag-green-custom) : Image {
                x: 20px;
                y: 10px;
                width: parent.height * 1.3;
                height: parent.height - 20px;
                source: root.caution ? Art.flag-yellow : Art.flag-green;
                image-fit: contain;
                transform-rotation: (AppState.pulse - 0.5) * 8deg;
            }
            Text {
                width: parent.width;
                height: parent.height;
                text: root.caution ? "CAUTION" : "GREEN FLAG";
                color: root.caution ? NascarTheme.ink : #ffffff;
                font-family: Fonts.anton;
                font-size: 90px;
                letter-spacing: 14px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}

component WearBar inherits Rectangle {
    in property <string> label;
    in property <Corner> c;
    min-height: 0px;
    preferred-height: 0px;
    HorizontalLayout {
        spacing: 20px;
        Text { width: 90px; text: root.label; color: NascarTheme.ink; font-family: Fonts.anton; font-size: 52px; vertical-alignment: center; }
        Rectangle {
            horizontal-stretch: 1;
            min-width: 0px;
            border-radius: 6px;
            background: NascarTheme.row-a;
            border-width: 4px;
            border-color: NascarTheme.ink;
            clip: true;
            Rectangle {
                x: 0px;
                height: parent.height;
                width: parent.width * (1.0 - root.c.wear-pct);
                background: root.c.wear-pct > 0.6 ? @linear-gradient(90deg, #8f150c 0%, #da291c 100%)
                    : (root.c.wear-pct > 0.35 ? @linear-gradient(90deg, #c79a00 0%, #ffd400 100%) : @linear-gradient(90deg, #00237a 0%, #1d4fc4 100%));
                animate width { duration: 200ms; easing: ease-out; }
            }
            Text {
                width: parent.width;
                height: parent.height;
                text: root.c.wear != "" ? root.c.wear + " WORN" : "--";
                color: #ffffff;
                font-family: Fonts.anton;
                font-size: 44px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}

component PitPage inherits FadePage {
    property <SimData> d: Sim.data;
    VerticalLayout {
        padding: 20px;
        spacing: 20px;
        Banner {
            vertical-stretch: 4;
            fill: NascarTheme.blue-fill;
            VerticalLayout {
                alignment: center;
                Text { text: "FUEL - LAPS REMAINING"; color: NascarTheme.yellow; font-family: Fonts.bebas; font-size: 38px; letter-spacing: 6px; horizontal-alignment: center; }
                Text { text: root.d.fuel-laps; color: #ffffff; font-family: Fonts.anton; font-size: 180px; horizontal-alignment: center; }
                Text { text: root.d.fuel + "   ·   " + root.d.fuel-per-lap + " / LAP   ·   ADD " + root.d.fuel-to-add; color: #ffffffcc; font-family: Fonts.bebas; font-size: 38px; horizontal-alignment: center; overflow: elide; }
            }
        }
        Banner {
            vertical-stretch: 5;
            VerticalLayout {
                padding: 24px;
                spacing: 24px;
                Text { text: "TIRE WEAR"; color: NascarTheme.red; font-family: Fonts.bebas; font-size: 36px; letter-spacing: 6px; horizontal-alignment: center; }
                WearBar { vertical-stretch: 1; label: "LF"; c: root.d.fl; }
                WearBar { vertical-stretch: 1; label: "RF"; c: root.d.fr; }
                WearBar { vertical-stretch: 1; label: "LR"; c: root.d.rl; }
                WearBar { vertical-stretch: 1; label: "RR"; c: root.d.rr; }
            }
        }
        Banner {
            vertical-stretch: 2.4;
            LapChart {
                width: parent.width;
                height: parent.height;
                path: root.d.lap-chart;
                count: root.d.lap-chart-count;
                best: root.d.lap-chart-best;
                worst: root.d.lap-chart-worst;
                line-color: NascarTheme.blue;
                best-color: NascarTheme.blue;
                text-color: NascarTheme.red;
                grid-color: #0b143033;
                font: Fonts.bebas;
            }
        }
        HorizontalLayout {
            vertical-stretch: 2.4;
            min-height: 0px;
            preferred-height: 0px;
            spacing: 24px;
            Banner {
                VerticalLayout {
                    alignment: center;
                    Text { text: "TRACK TEMP"; color: NascarTheme.red; font-family: Fonts.bebas; font-size: 30px; letter-spacing: 4px; horizontal-alignment: center; }
                    Text { text: root.d.track-temp; color: NascarTheme.ink; font-family: Fonts.anton; font-size: 80px; horizontal-alignment: center; }
                }
            }
            Banner {
                VerticalLayout {
                    alignment: center;
                    Text { text: "BEST LAP"; color: NascarTheme.red; font-family: Fonts.bebas; font-size: 30px; letter-spacing: 4px; horizontal-alignment: center; }
                    Text { text: root.d.best-lap; color: NascarTheme.ink; font-family: Fonts.anton; font-size: 64px; horizontal-alignment: center; overflow: elide; }
                    Text { text: "ALL-TIME  " + root.d.pb-lap; color: #7a2cff; font-family: Fonts.bebas; font-size: 30px; horizontal-alignment: center; overflow: elide; }
                }
            }
        }
    }
}

export component NascarDash inherits DashShell {
    waiting-art: Art.tile-nascar;
    dock-texture: Art.dock-nascar;
    dock-textured: Art.dock-nascar-custom;
    waiting-has-art: Art.tile-nascar-custom;
    waiting-emblem: Art.emblem-nascar;
    waiting-card: #0b1838;
    background: NascarTheme.paper;
    tabs: [
        { label: "THE PACK", icon: @image-url("../img/icons/radar.svg") },
        { label: "THE DRAFT", icon: @image-url("../img/icons/list.svg") },
        { label: "PIT BOX", icon: @image-url("../img/icons/fuel.svg") }
    ];
    accent: NascarTheme.red;
    dock-bg: NascarTheme.deep;
    dock-idle: NascarTheme.blue;
    dock-text: #ffffff;
    pill-idle: #0a2a7a;
    pill-idle-text: #c9d3ee;
    font: Fonts.bebas;
    radius: 6px;

    Rectangle {
        y: 0px;
        width: root.width;
        height: root.page-height;
        background: @linear-gradient(180deg, #ffffff 0%, #e9ecf2 100%);
    }
    if Art.bg-nascar-custom : Image { y: 0px; width: root.width; height: root.page-height; source: Art.bg-nascar; image-fit: cover; }
    if Sim.layout == 0 : PackPage { y: 0px; width: root.width; height: root.page-height; }
    if Sim.layout == 1 : DraftPage { y: 0px; width: root.width; height: root.page-height; }
    if Sim.layout >= 2 : PitPage { y: 0px; width: root.width; height: root.page-height; }
}
