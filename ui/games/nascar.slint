// NASCAR 26 - "Spotter & Strategy". TV broadcast HUD: clean white, racing blue #0033A0, red
// #DA291C, metallic banners with heavy 3D drop shadows, Anton / Bebas Neue type.
// Pages: THE PACK (radar, speed, gear, RPM), THE DRAFT (pylon, map, caution), PIT BOX.

import { Sim, SimData, Corner } from "../sim/sim_state.slint";
import { DashShell, ShiftLights, RowItem } from "../sim/sim_widgets.slint";
import { Fonts } from "../kit.slint";
import { TrackMap } from "../map.slint";
import { Art } from "../art.slint";

global NascarTheme {
    out property <color> blue: #0033a0;
    out property <color> deep: #001a57;
    out property <color> red: #da291c;
    out property <color> yellow: #ffd400;
    out property <color> paper: #f4f5f8;
    out property <color> ink: #0b1430;
}

// Metallic broadcast banner with a hard offset shadow.
component Banner inherits Rectangle {
    in property <brush> fill: @linear-gradient(180deg, #ffffff 0%, #d4d9e2 55%, #f7f8fb 100%);
    min-height: 0px;
    preferred-height: 0px;
    min-width: 0px;
    preferred-width: 100px;
    background: root.fill;
    border-radius: 6px;
    border-width: 3px;
    border-color: NascarTheme.ink;
    drop-shadow-offset-x: 8px;
    drop-shadow-offset-y: 10px;
    drop-shadow-color: #0b143088;
    drop-shadow-blur: 0px;
}

// Blind-spot radar strip on the screen edge.
component RadarEdge inherits Rectangle {
    in property <int> cars;
    in property <string> side;
    border-radius: 10px;
    background: root.cars == 0 ? #dfe3ea : (root.cars >= 2 ? #ff8a00 : NascarTheme.yellow);
    opacity: root.cars > 0 && !Sim.data.blink ? 0.55 : 1.0;
    border-width: 4px;
    border-color: NascarTheme.ink;
    drop-shadow-offset-x: 6px;
    drop-shadow-offset-y: 8px;
    drop-shadow-color: #0b143066;
    VerticalLayout {
        alignment: center;
        spacing: 10px;
        for ch in ["C", "A", "R"] : Text {
            text: root.cars == 0 ? "" : ch;
            color: NascarTheme.ink;
            font-family: Fonts.anton;
            font-size: 72px;
            horizontal-alignment: center;
        }
        Text {
            text: root.cars >= 2 ? "x2" : root.side;
            color: root.cars == 0 ? #9aa3b5 : NascarTheme.ink;
            font-family: Fonts.anton;
            font-size: 48px;
            horizontal-alignment: center;
        }
    }
}

component PackPage inherits Rectangle {
    property <SimData> d: Sim.data;
    HorizontalLayout {
        padding: 16px;
        spacing: 16px;
        RadarEdge { width: 130px; cars: root.d.spotter-left; side: "L"; }
        VerticalLayout {
            spacing: 26px;
            // Speedometer
            Banner {
                vertical-stretch: 5;
                VerticalLayout {
                    alignment: center;
                    Text { text: "\{root.d.speed}"; color: NascarTheme.ink; font-family: Fonts.anton; font-size: 280px; horizontal-alignment: center; }
                    Text { text: root.d.speed-unit; color: NascarTheme.red; font-family: Fonts.bebas; font-size: 60px; letter-spacing: 10px; horizontal-alignment: center; }
                }
            }
            // Gear + position
            HorizontalLayout {
                vertical-stretch: 5;
                min-height: 0px;
                preferred-height: 0px;
                spacing: 24px;
                Banner {
                    fill: @linear-gradient(180deg, #1d4fc4 0%, #0033a0 60%, #001a57 100%);
                    VerticalLayout {
                        alignment: center;
                        Text { text: "GEAR"; color: #ffffffbb; font-family: Fonts.bebas; font-size: 44px; letter-spacing: 6px; horizontal-alignment: center; }
                        Text { text: root.d.gear; color: #ffffff; font-family: Fonts.anton; font-size: 300px; horizontal-alignment: center; }
                    }
                }
                Banner {
                    fill: @linear-gradient(180deg, #f0473a 0%, #da291c 60%, #8f150c 100%);
                    VerticalLayout {
                        alignment: center;
                        Text { text: "POS"; color: #ffffffbb; font-family: Fonts.bebas; font-size: 44px; letter-spacing: 6px; horizontal-alignment: center; }
                        Text { text: root.d.position > 0 ? "\{root.d.position}" : "--"; color: #ffffff; font-family: Fonts.anton; font-size: 200px; horizontal-alignment: center; }
                        Text { text: root.d.lap-text; color: #ffffffcc; font-family: Fonts.bebas; font-size: 40px; horizontal-alignment: center; }
                    }
                }
            }
            // RPM light bar
            Banner {
                vertical-stretch: 2;
                fill: NascarTheme.ink;
                VerticalLayout {
                    padding: 14px;
                    spacing: 6px;
                    ShiftLights { vertical-stretch: 1; low: #22c55e; mid: NascarTheme.yellow; high: NascarTheme.red; flash: NascarTheme.red; off: #1a2440; radius: 6px; gap: 6px; }
                    Text { text: "\{root.d.rpm} RPM"; color: #ffffff; font-family: Fonts.bebas; font-size: 40px; letter-spacing: 4px; horizontal-alignment: center; }
                }
            }
        }
        RadarEdge { width: 130px; cars: root.d.spotter-right; side: "R"; }
    }
}

component DraftPage inherits Rectangle {
    property <SimData> d: Sim.data;
    property <bool> caution: root.d.banner-text == "CAUTION" || root.d.banner-text == "YELLOW FLAG";
    VerticalLayout {
        padding: 20px;
        spacing: 22px;
        // The pylon: 3 ahead, you, 3 behind.
        Banner {
            vertical-stretch: 8;
            fill: NascarTheme.ink;
            VerticalLayout {
                padding: 10px;
                spacing: 6px;
                Rectangle {
                    height: 64px;
                    background: NascarTheme.red;
                    Text { width: parent.width; height: parent.height; text: "THE PYLON  ·  RELATIVE"; color: #ffffff; font-family: Fonts.bebas; font-size: 46px; letter-spacing: 4px; horizontal-alignment: center; vertical-alignment: center; }
                }
                for r[i] in Sim.relative : RowItem {
                    vertical-stretch: 1;
                    item: r;
                    bg: i == 1 || i == 3 || i == 5 ? #dde2ea : NascarTheme.paper;
                    player-bg: NascarTheme.blue;
                    player-text: #ffffff;
                    text-color: NascarTheme.ink;
                    dim: #5b6680;
                    pit-color: NascarTheme.red;
                    font: Fonts.bebas;
                    font-size: 48px;
                    radius: 2px;
                }
            }
        }
        // Map + gaps
        HorizontalLayout {
            vertical-stretch: 5;
            min-height: 0px;
            preferred-height: 0px;
            spacing: 22px;
            Banner {
                horizontal-stretch: 3;
                fill: @linear-gradient(180deg, #0a2a7a 0%, #001a57 100%);
                TrackMap {
                    width: parent.width;
                    height: parent.height;
                    path: Sim.map-path;
                    dots: Sim.map-dots;
                    note: Sim.data.map-note;
                    track-color: #e8ecf8;
                    track-edge: #000000;
                    player-color: NascarTheme.red;
                    car-color: NascarTheme.yellow;
                    note-color: #c9d3ee;
                    line-width: 20px;
                    dot-size: 34px;
                }
            }
            Banner {
                horizontal-stretch: 2;
                VerticalLayout {
                    alignment: center;
                    Text { text: "CAR AHEAD"; color: NascarTheme.red; font-family: Fonts.bebas; font-size: 44px; letter-spacing: 4px; horizontal-alignment: center; }
                    Text { text: root.d.gap-ahead; color: NascarTheme.ink; font-family: Fonts.anton; font-size: 90px; horizontal-alignment: center; overflow: elide; }
                    Text { text: "BEHIND  " + root.d.gap-behind; color: #5b6680; font-family: Fonts.bebas; font-size: 36px; horizontal-alignment: center; overflow: elide; }
                }
            }
        }
        // Full-width caution flag
        Rectangle {
            vertical-stretch: 3;
            min-height: 0px;
            preferred-height: 0px;
            border-radius: 6px;
            background: root.caution ? (Sim.data.blink ? NascarTheme.yellow : #ffe866) : #1f7a35;
            border-width: 4px;
            border-color: NascarTheme.ink;
            drop-shadow-offset-x: 8px;
            drop-shadow-offset-y: 10px;
            drop-shadow-color: #0b143088;
            Text {
                width: parent.width;
                height: parent.height;
                text: root.caution ? "CAUTION" : "GREEN FLAG";
                color: root.caution ? NascarTheme.ink : #ffffff;
                font-family: Fonts.anton;
                font-size: 150px;
                letter-spacing: 14px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}

component WearBar inherits Rectangle {
    in property <string> label;
    in property <Corner> c;
    min-height: 0px;
    preferred-height: 0px;
    HorizontalLayout {
        spacing: 20px;
        Text { width: 120px; text: root.label; color: NascarTheme.ink; font-family: Fonts.anton; font-size: 72px; vertical-alignment: center; }
        Rectangle {
            horizontal-stretch: 1;
            min-width: 0px;
            border-radius: 6px;
            background: #dfe3ea;
            border-width: 4px;
            border-color: NascarTheme.ink;
            clip: true;
            Rectangle {
                x: 0px;
                height: parent.height;
                width: parent.width * (1.0 - root.c.wear-pct);
                background: root.c.wear-pct > 0.6 ? @linear-gradient(90deg, #8f150c 0%, #da291c 100%)
                    : (root.c.wear-pct > 0.35 ? @linear-gradient(90deg, #c79a00 0%, #ffd400 100%) : @linear-gradient(90deg, #00237a 0%, #1d4fc4 100%));
                animate width { duration: 200ms; easing: ease-out; }
            }
            Text {
                width: parent.width;
                height: parent.height;
                text: root.c.wear != "" ? root.c.wear + " WORN" : "--";
                color: #ffffff;
                font-family: Fonts.anton;
                font-size: 60px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}

component PitPage inherits Rectangle {
    property <SimData> d: Sim.data;
    VerticalLayout {
        padding: 24px;
        spacing: 30px;
        Banner {
            vertical-stretch: 6;
            fill: @linear-gradient(180deg, #1d4fc4 0%, #0033a0 60%, #001a57 100%);
            VerticalLayout {
                alignment: center;
                Text { text: "FUEL - LAPS REMAINING"; color: NascarTheme.yellow; font-family: Fonts.bebas; font-size: 54px; letter-spacing: 6px; horizontal-alignment: center; }
                Text { text: root.d.fuel-laps; color: #ffffff; font-family: Fonts.anton; font-size: 300px; horizontal-alignment: center; }
                Text { text: root.d.fuel + "   ·   ADD " + root.d.fuel-to-add; color: #ffffffcc; font-family: Fonts.bebas; font-size: 48px; horizontal-alignment: center; }
            }
        }
        Banner {
            vertical-stretch: 5;
            VerticalLayout {
                padding: 24px;
                spacing: 24px;
                Text { text: "RIGHT-SIDE TIRE WEAR"; color: NascarTheme.red; font-family: Fonts.bebas; font-size: 50px; letter-spacing: 6px; horizontal-alignment: center; }
                WearBar { vertical-stretch: 1; label: "RF"; c: root.d.fr; }
                WearBar { vertical-stretch: 1; label: "RR"; c: root.d.rr; }
            }
        }
        HorizontalLayout {
            vertical-stretch: 3;
            min-height: 0px;
            preferred-height: 0px;
            spacing: 24px;
            Banner {
                VerticalLayout {
                    alignment: center;
                    Text { text: "TRACK TEMP"; color: NascarTheme.red; font-family: Fonts.bebas; font-size: 44px; letter-spacing: 4px; horizontal-alignment: center; }
                    Text { text: root.d.track-temp; color: NascarTheme.ink; font-family: Fonts.anton; font-size: 130px; horizontal-alignment: center; }
                }
            }
            Banner {
                VerticalLayout {
                    alignment: center;
                    Text { text: "BEST LAP"; color: NascarTheme.red; font-family: Fonts.bebas; font-size: 44px; letter-spacing: 4px; horizontal-alignment: center; }
                    Text { text: root.d.best-lap; color: NascarTheme.ink; font-family: Fonts.anton; font-size: 90px; horizontal-alignment: center; overflow: elide; }
                }
            }
        }
    }
}

export component NascarDash inherits DashShell {
    background: NascarTheme.paper;
    tabs: [
        { label: "THE PACK", icon: @image-url("../img/icons/radar.svg") },
        { label: "THE DRAFT", icon: @image-url("../img/icons/list.svg") },
        { label: "PIT BOX", icon: @image-url("../img/icons/fuel.svg") }
    ];
    accent: NascarTheme.red;
    dock-bg: NascarTheme.deep;
    dock-idle: NascarTheme.blue;
    dock-text: #ffffff;
    pill-idle: #0a2a7a;
    pill-idle-text: #c9d3ee;
    font: Fonts.bebas;
    radius: 6px;

    Rectangle {
        y: 0px;
        width: root.width;
        height: root.page-height;
        background: @linear-gradient(180deg, #ffffff 0%, #e9ecf2 100%);
    }
    if Art.bg-nascar-custom : Image { y: 0px; width: root.width; height: root.page-height; source: Art.bg-nascar; image-fit: cover; }
    if Sim.layout == 0 : PackPage { y: 0px; width: root.width; height: root.page-height; }
    if Sim.layout == 1 : DraftPage { y: 0px; width: root.width; height: root.page-height; }
    if Sim.layout >= 2 : PitPage { y: 0px; width: root.width; height: root.page-height; }
}
