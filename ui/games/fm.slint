// Forza Motorsport - "Turn 10 Telemetry". Clean modern sim-cade: slate #2B2E33, glass panels
// (#2B2E3388 with a thin white edge, 25 px corners), magenta -> cyan gradients, and smooth
// eased animation on everything that moves.
// Pages: THE APEX (RPM arc, split, friction circle), PHYSICS LAB (tyres), THE DYNO.
// Forza only sends the player's car, so the map shows you only.

import { Sim, SimData, Corner, SimRow, DynoBar } from "../sim/sim_state.slint";
import { DashShell, GMeter, DeltaStrip, RowItem } from "../sim/sim_widgets.slint";
import { Fonts, StatStrip, Stat, FadePage, LapChart } from "../kit.slint";
import { AppState } from "../globals.slint";
import { TrackMap } from "../map.slint";
import { Art } from "../art.slint";

global FmTheme {
    out property <color> slate: #2b2e33;
    // Fills, see-through per the PANELS setting.
    out property <color> glass: rgba(43, 46, 51, 0.85 * AppState.panel);
    out property <color> well: rgba(31, 34, 39, AppState.panel);
    out property <color> shadow: rgba(0, 0, 0, 0.4 * AppState.shade);
    out property <color> edge: #ffffff33;
    out property <color> magenta: #e6007e;
    out property <color> cyan: #00d1ff;
    out property <color> violet: #7a3cff;
    out property <color> text: #f5f7fb;
    out property <color> dim: #9aa3b2;
    out property <brush> sweep: @linear-gradient(90deg, #00d1ff 0%, #7a3cff 55%, #e6007e 100%);
}

component FmGlass inherits Rectangle {
    in property <string> title;
    min-height: 0px;
    preferred-height: 0px;
    min-width: 0px;
    preferred-width: 100px;
    background: FmTheme.glass;
    border-radius: 25px;
    border-width: 1px;
    border-color: FmTheme.edge;
    drop-shadow-blur: 30px;
    drop-shadow-color: FmTheme.shadow;
    clip: true;
    if Art.panel-fm-custom : Image { width: parent.width; height: parent.height; source: Art.panel-fm; image-fit: cover; opacity: 0.25; }
    if root.title != "" : Text {
        x: 24px;
        y: 14px;
        text: root.title;
        color: FmTheme.dim;
        font-family: Fonts.titillium;
        font-size: 18px;
        font-weight: 900;
        letter-spacing: 3px;
    }
}

// Glass stat strip.
component FmStrip inherits StatStrip {
    texture: Art.panel-fm;
    textured: Art.panel-fm-custom;
    cell-bg: FmTheme.glass;
    edge: FmTheme.edge;
    label-color: FmTheme.dim;
    value-color: FmTheme.text;
    font: Fonts.titillium;
    value-size: 34px;
    label-size: 17px;
    radius: 18px;
    gap: 14px;
}

component FmApexPage inherits FadePage {
    property <SimData> d: Sim.data;
    VerticalLayout {
        padding: 20px;
        spacing: 20px;
        // Sleek RPM arc with gear + speed
        FmGlass {
            vertical-stretch: 5;
            Rectangle {
                property <length> side: min(self.width, self.height) * 1.05;
                width: parent.width;
                height: parent.height;
                // Printed dial face (optional art) behind the arc.
                if Art.fm-gauge-face-custom : Rectangle {
                    x: (parent.width - parent.side) / 2;
                    y: (parent.height - parent.side) / 2 + 30px;
                    width: parent.side;
                    height: parent.side;
                    border-radius: parent.side / 2;
                    clip: true;
                    Image { width: parent.width; height: parent.height; source: Art.fm-gauge-face; image-fit: cover; }
                }
                Path {
                    x: (parent.width - parent.side) / 2;
                    y: (parent.height - parent.side) / 2 + 30px;
                    width: parent.side;
                    height: parent.side;
                    viewbox-width: 200;
                    viewbox-height: 200;
                    commands: Sim.dial-track;
                    stroke: #ffffff14;
                    stroke-width: 34px;
                    fill: transparent;
                }
                if root.d.rpm-arc != "" : Path {
                    x: (parent.width - parent.side) / 2;
                    y: (parent.height - parent.side) / 2 + 30px;
                    width: parent.side;
                    height: parent.side;
                    viewbox-width: 200;
                    viewbox-height: 200;
                    commands: root.d.rpm-arc;
                    stroke: root.d.shift ? @linear-gradient(90deg, #e6007e 0%, #ff4fb0 100%) : FmTheme.sweep;
                    stroke-width: 34px;
                    fill: transparent;
                }
                VerticalLayout {
                    width: parent.width;
                    height: parent.height;
                    alignment: center;
                    Text { text: root.d.gear; color: FmTheme.text; font-family: Fonts.titillium; font-size: 170px; font-weight: 900; horizontal-alignment: center; }
                    Text { text: "\{root.d.speed} " + root.d.speed-unit; color: FmTheme.cyan; font-family: Fonts.titillium; font-size: 44px; font-weight: 900; horizontal-alignment: center; }
                }
            }
        }
        DeltaStrip {
            vertical-stretch: 1.4;
            title: "SPLIT VS BEST LAP";
            delta: root.d.delta;
            valid: root.d.has-delta;
            text: root.d.delta-text;
            bg: FmTheme.glass;
            faster: FmTheme.cyan;
            slower: FmTheme.magenta;
            radius: 25px;
            font: Fonts.titillium;
            font-size: 60px;
        }
        FmStrip {
            vertical-stretch: 1.2;
            stats: [
                { label: root.d.lap-invalid ? "CURRENT · INVALID" : "CURRENT", value: root.d.current-lap, tint: root.d.lap-invalid ? FmTheme.magenta : transparent },
                { label: "LAST VS ALL-TIME", value: root.d.pb-gap == "" ? "--" : root.d.pb-gap, tint: root.d.pb-gap == "" ? FmTheme.dim : (root.d.pb-gap-good ? FmTheme.cyan : FmTheme.magenta) },
                { label: "LAP", value: root.d.lap-text == "" ? "--" : root.d.lap-text, tint: transparent },
                { label: "FUEL", value: root.d.fuel, tint: transparent },
                { label: "TOP SPEED", value: root.d.max-speed, tint: transparent }
            ];
        }
        FmStrip {
            vertical-stretch: 1.2;
            stats: [
                { label: "FL", value: root.d.fl.temp == "" ? "--" : root.d.fl.temp, tint: root.d.fl.temp-color },
                { label: "FR", value: root.d.fr.temp == "" ? "--" : root.d.fr.temp, tint: root.d.fr.temp-color },
                { label: "RL", value: root.d.rl.temp == "" ? "--" : root.d.rl.temp, tint: root.d.rl.temp-color },
                { label: "RR", value: root.d.rr.temp == "" ? "--" : root.d.rr.temp, tint: root.d.rr.temp-color },
                { label: "BOOST", value: root.d.has-boost ? root.d.boost : "--", tint: transparent }
            ];
        }
        // Friction circle
        HorizontalLayout {
            vertical-stretch: 5;
            min-height: 0px;
            preferred-height: 0px;
            spacing: 20px;
            FmGlass {
                horizontal-stretch: 3;
                title: "FRICTION CIRCLE";
                GMeter {
                    width: parent.width;
                    height: parent.height - 60px;
                    y: 46px;
                    lat: root.d.g-lat;
                    long: root.d.g-long;
                    ring: #ffffff26;
                    dot: FmTheme.magenta;
                    face: @radial-gradient(circle, #3a3f47 0%, #1f2227 100%);
                }
            }
            VerticalLayout {
                horizontal-stretch: 2;
                min-width: 0px;
                preferred-width: 100px;
                spacing: 20px;
                FmGlass {
                    title: "LAST LAP";
                    Text { width: parent.width; height: parent.height; text: root.d.last-lap; color: root.d.last-lap == "NO TIME" ? FmTheme.dim : FmTheme.text; font-family: Fonts.titillium; font-size: root.d.last-lap == "NO TIME" ? 28px : 42px; font-weight: 900; horizontal-alignment: center; vertical-alignment: center; }
                }
                FmGlass {
                    title: "BEST LAP";
                    Text { width: parent.width; height: parent.height; text: root.d.best-lap; color: root.d.best-lap == "NO TIME" ? FmTheme.dim : FmTheme.magenta; font-family: Fonts.titillium; font-size: root.d.best-lap == "NO TIME" ? 28px : 42px; font-weight: 900; horizontal-alignment: center; vertical-alignment: center; }
                }
                FmGlass {
                    title: "ALL-TIME BEST";
                    Text { width: parent.width; height: parent.height; text: root.d.pb-lap; color: root.d.pb-lap == "NO TIME" ? FmTheme.dim : #b98cff; font-family: Fonts.titillium; font-size: root.d.pb-lap == "NO TIME" ? 28px : 42px; font-weight: 900; horizontal-alignment: center; vertical-alignment: center; }
                }
                FmGlass {
                    title: "POSITION";
                    Text { width: parent.width; height: parent.height; text: root.d.pos-text; color: FmTheme.cyan; font-family: Fonts.titillium; font-size: 42px; font-weight: 900; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
        }
    }
}

// Slip circle: dark when gripping, cyan as it slides.
component SlipCircle inherits Rectangle {
    in property <Corner> c;
    in property <string> label;
    min-width: 0px;
    preferred-width: 100px;
    property <length> side: min(self.width, self.height);
    Rectangle {
        x: (parent.width - parent.side) / 2;
        y: (parent.height - parent.side) / 2;
        width: parent.side;
        height: parent.side;
        border-radius: parent.side / 2;
        background: root.c.slip-color;
        border-width: 3px;
        border-color: root.c.slip > 1.0 ? FmTheme.cyan : #ffffff33;
        drop-shadow-blur: root.c.slip > 1.0 ? 30px : 0px;
        drop-shadow-color: FmTheme.cyan;
        animate background { duration: 150ms; easing: ease-out; }
        Text { width: parent.width; height: parent.height; text: root.label; color: #ffffff; font-family: Fonts.titillium; font-size: 30px; font-weight: 900; horizontal-alignment: center; vertical-alignment: center; }
    }
}

// Tyre heat: core colour in the centre fading to surface colour at the edge.
component HeatTile inherits Rectangle {
    in property <Corner> c;
    in property <string> label;
    min-width: 0px;
    preferred-width: 100px;
    // Dark glass tile: surface colour on the ring, core colour glowing from the centre.
    border-radius: 25px;
    background: FmTheme.glass;
    border-width: 3px;
    border-color: root.c.temp-color;
    clip: true;
    Rectangle {
        width: parent.width;
        height: parent.height;
        background: @radial-gradient(circle, root.c.inner-color.transparentize(0.6) 0%, root.c.temp-color.transparentize(0.85) 55%, transparent 100%);
    }
    VerticalLayout {
        alignment: center;
        Text { text: root.label; color: FmTheme.dim; font-family: Fonts.titillium; font-size: 20px; font-weight: 900; letter-spacing: 2px; horizontal-alignment: center; }
        Text { text: root.c.temp != "" ? root.c.temp : "--"; color: root.c.temp-color.brighter(0.25); font-family: Fonts.titillium; font-size: 52px; font-weight: 900; horizontal-alignment: center; }
        Text { text: root.c.inner != "" ? "CORE " + root.c.inner : ""; color: root.c.inner-color.brighter(0.25); font-family: Fonts.titillium; font-size: 20px; font-weight: 900; horizontal-alignment: center; }
        Text { text: root.c.wear != "" ? root.c.wear + " WORN" : ""; color: FmTheme.text; font-family: Fonts.titillium; font-size: 19px; font-weight: 800; horizontal-alignment: center; }
        Text { text: root.c.pressure != "" ? root.c.pressure + " PSI" : ""; color: FmTheme.dim; font-family: Fonts.titillium; font-size: 19px; font-weight: 800; horizontal-alignment: center; }
        // 30-second temperature trend
        Rectangle {
            height: 30px;
            if root.c.trend != "" : Path {
                x: parent.width * 0.15;
                width: parent.width * 0.7;
                height: parent.height;
                viewbox-width: 300;
                viewbox-height: 60;
                commands: root.c.trend;
                stroke: root.c.temp-color;
                stroke-width: 3px;
                fill: transparent;
            }
        }
    }
}
component LoadBar inherits Rectangle {
    in property <Corner> c;
    in property <string> label;
    min-width: 0px;
    preferred-width: 100px;
    VerticalLayout {
        spacing: 8px;
        Rectangle {
            vertical-stretch: 1;
            min-height: 0px;
            border-radius: 18px;
            background: FmTheme.well;
            clip: true;
            Rectangle {
                x: 0px;
                width: parent.width;
                height: parent.height * root.c.susp;
                y: parent.height - self.height;
                border-radius: 18px;
                background: @linear-gradient(0deg, #e6007e 0%, #7a3cff 60%, #00d1ff 100%);
                animate height { duration: 150ms; easing: ease-out; }
            }
        }
        Text { text: root.label; color: FmTheme.dim; font-family: Fonts.titillium; font-size: 24px; font-weight: 900; horizontal-alignment: center; }
    }
}

component FmPhysicsPage inherits FadePage {
    property <SimData> d: Sim.data;
    VerticalLayout {
        padding: 20px;
        spacing: 20px;
        FmGlass {
            vertical-stretch: 4;
            title: "TYRE SLIP";
            HorizontalLayout {
                padding: 20px;
                padding-top: 50px;
                spacing: 20px;
                SlipCircle { c: root.d.fl; label: "FL"; }
                SlipCircle { c: root.d.fr; label: "FR"; }
                SlipCircle { c: root.d.rl; label: "RL"; }
                SlipCircle { c: root.d.rr; label: "RR"; }
            }
        }
        FmGlass {
            vertical-stretch: 6;
            title: "TYRE HEAT  ·  CORE TO SURFACE";
            HorizontalLayout {
                padding: 20px;
                padding-top: 50px;
                spacing: 20px;
                VerticalLayout {
                    spacing: 20px;
                    HeatTile { c: root.d.fl; label: "FL"; }
                    HeatTile { c: root.d.rl; label: "RL"; }
                }
                Image { width: 140px; source: Art.car-gt; image-fit: contain; }
                VerticalLayout {
                    spacing: 20px;
                    HeatTile { c: root.d.fr; label: "FR"; }
                    HeatTile { c: root.d.rr; label: "RR"; }
                }
            }
        }
        FmGlass {
            vertical-stretch: 4;
            title: "SUSPENSION LOAD";
            HorizontalLayout {
                padding: 20px;
                padding-top: 50px;
                spacing: 30px;
                LoadBar { c: root.d.fl; label: "FL"; }
                LoadBar { c: root.d.fr; label: "FR"; }
                LoadBar { c: root.d.rl; label: "RL"; }
                LoadBar { c: root.d.rr; label: "RR"; }
            }
        }
    }
}

component PedalBar inherits Rectangle {
    in property <string> label;
    in property <float> value;
    in property <brush> fill;
    min-height: 0px;
    preferred-height: 0px;
    HorizontalLayout {
        spacing: 16px;
        Text { width: 130px; text: root.label; color: FmTheme.dim; font-family: Fonts.titillium; font-size: 22px; font-weight: 900; vertical-alignment: center; }
        Rectangle {
            horizontal-stretch: 1;
            border-radius: 20px;
            background: FmTheme.well;
            clip: true;
            Rectangle {
                x: 0px;
                height: parent.height;
                width: parent.width * root.value;
                border-radius: 20px;
                background: root.fill;
                animate width { duration: 150ms; easing: ease-out; }
            }
        }
    }
}

component FmDynoPage inherits FadePage {
    property <SimData> d: Sim.data;
    VerticalLayout {
        padding: 20px;
        spacing: 20px;
        // Power band equalizer
        FmGlass {
            vertical-stretch: 3.6;
            title: "POWER BAND";
            Text { x: parent.width - 420px; y: 12px; width: 400px; text: root.d.power + "   " + root.d.torque; color: FmTheme.cyan; font-family: Fonts.titillium; font-size: 30px; font-weight: 900; horizontal-alignment: right; }
            HorizontalLayout {
                padding: 24px;
                padding-top: 60px;
                spacing: 6px;
                for b in Sim.dyno : Rectangle {
                    preferred-width: 10px;
                    Rectangle {
                        x: 0px;
                        width: parent.width;
                        height: parent.height * max(0.02, b.h);
                        y: parent.height - self.height;
                        border-radius: 6px;
                        background: b.active ? @linear-gradient(0deg, #e6007e 0%, #ff8fd0 100%) : @linear-gradient(0deg, #3a2d6b 0%, #00d1ff 100%);
                        animate height { duration: 150ms; easing: ease-out; }
                    }
                }
            }
        }
        FmGlass {
            vertical-stretch: 2.4;
            LapChart {
                width: parent.width;
                height: parent.height;
                path: root.d.lap-chart;
                count: root.d.lap-chart-count;
                best: root.d.lap-chart-best;
                worst: root.d.lap-chart-worst;
                line-color: FmTheme.cyan;
                best-color: FmTheme.cyan;
                text-color: FmTheme.dim;
                font: Fonts.titillium;
            }
        }
        // Lap history + map
        HorizontalLayout {
            vertical-stretch: 6;
            min-height: 0px;
            preferred-height: 0px;
            spacing: 20px;
            FmGlass {
                horizontal-stretch: 1;
                title: "SESSION LAPS";
                VerticalLayout {
                    padding: 16px;
                    padding-top: 50px;
                    spacing: 6px;
                    if Sim.lap-list.length == 0 : VerticalLayout {
                        vertical-stretch: 1;
                        alignment: center;
                        spacing: 8px;
                        Text { text: "NO LAPS YET"; color: FmTheme.text; font-family: Fonts.titillium; font-size: 30px; font-weight: 900; horizontal-alignment: center; }
                        Text { text: "Complete a lap to start the list"; color: FmTheme.dim; font-family: Fonts.titillium; font-size: 20px; font-weight: 700; horizontal-alignment: center; wrap: word-wrap; }
                    }
                    for l in Sim.lap-list : RowItem {
                        vertical-stretch: 1;
                        item: l;
                        bg: #ffffff0a;
                        player-bg: #e6007e66;
                        font: Fonts.titillium;
                        font-size: 26px;
                        radius: 12px;
                    }
                    Rectangle { vertical-stretch: 0.01; }
                }
            }
            FmGlass {
                horizontal-stretch: 1;
                title: "TRACK";
                TrackMap {
                    width: parent.width;
                    height: parent.height;
                    path: Sim.map-path;
                    dots: Sim.map-dots;
                    note: Sim.data.map-note;
                    track-color: FmTheme.cyan;
                    track-edge: #1f2227;
                    player-color: FmTheme.magenta;
                    note-color: FmTheme.dim;
                    line-width: 10px;
                    dot-size: 30px;
                }
            }
        }
        // Throttle / brake trace
        FmGlass {
            vertical-stretch: 3;
            VerticalLayout {
                padding: 24px;
                spacing: 18px;
                PedalBar { vertical-stretch: 1; label: "THROTTLE"; value: root.d.throttle; fill: @linear-gradient(90deg, #0a7a3a 0%, #22e07a 100%); }
                PedalBar { vertical-stretch: 1; label: "BRAKE"; value: root.d.brake; fill: @linear-gradient(90deg, #7a0a1a 0%, #ff3b5c 100%); }
            }
        }
    }
}

export component FmDash inherits DashShell {
    waiting-art: Art.tile-fm;
    dock-texture: Art.dock-fm;
    dock-textured: Art.dock-fm-custom;
    waiting-has-art: Art.tile-fm-custom;
    waiting-emblem: Art.emblem-fm;
    waiting-card: #22252a;
    background: FmTheme.slate;
    tabs: [
        { label: "THE APEX", icon: @image-url("../img/icons/gauge.svg") },
        { label: "PHYSICS", icon: @image-url("../img/icons/tyre.svg") },
        { label: "THE DYNO", icon: @image-url("../img/icons/bars.svg") }
    ];
    accent: FmTheme.magenta;
    dock-bg: #1f2227;
    dock-idle: #33373e;
    dock-text: #dfe3ea;
    pill-idle: #2b2e33;
    pill-idle-text: FmTheme.dim;
    font: Fonts.titillium;
    radius: 25px;

    Rectangle {
        y: 0px;
        width: root.width;
        height: root.page-height;
        background: @radial-gradient(circle, #3a3f47 0%, #2b2e33 55%, #1c1e22 100%);
    }
    if Art.bg-fm-custom : Image { y: 0px; width: root.width; height: root.page-height; source: Art.bg-fm; image-fit: cover; }
    if Sim.layout == 0 : FmApexPage { y: 0px; width: root.width; height: root.page-height; }
    if Sim.layout == 1 : FmPhysicsPage { y: 0px; width: root.width; height: root.page-height; }
    if Sim.layout >= 2 : FmDynoPage { y: 0px; width: root.width; height: root.page-height; }
}
