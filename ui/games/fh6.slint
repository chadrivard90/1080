// Forza Horizon 6 - "The Festival Cruiser". Vibrant neon festival: pink -> yellow -> mint
// gradient with light streaks that drift as you turn, frosted panels, Permanent Marker headers.
// Pages: CRUISE (speedo, RPM equalizer, car card), DRIFT ZONE, EXPLORER (compass, map, stats).
// FH6 telemetry has no music metadata, so the bottom card shows the car you're driving.

import { Sim, SimData } from "../sim/sim_state.slint";
import { DashShell } from "../sim/sim_widgets.slint";
import { Fonts } from "../kit.slint";
import { TrackMap } from "../map.slint";

global FestTheme {
    out property <brush> sky: @linear-gradient(155deg, #ff2d87 0%, #ff7a59 30%, #ffe14d 60%, #3dffc5 100%);
    out property <color> frost: #1a0b2e8c;
    out property <color> frost-edge: #ffffff66;
    out property <color> pink: #ff2d87;
    out property <color> yellow: #ffe14d;
    out property <color> mint: #3dffc5;
    out property <color> text: #ffffff;
    out property <color> dim: #ffe6f2;
}

component Frost inherits Rectangle {
    in property <string> title;
    min-height: 0px;
    preferred-height: 0px;
    min-width: 0px;
    preferred-width: 100px;
    background: FestTheme.frost;
    border-radius: 34px;
    border-width: 2px;
    border-color: FestTheme.frost-edge;
    drop-shadow-blur: 30px;
    drop-shadow-color: #3a005a55;
    clip: true;
    if root.title != "" : Text {
        x: 28px;
        y: 10px;
        text: root.title;
        color: FestTheme.yellow;
        font-family: Fonts.marker;
        font-size: 36px;
    }
}

component FestCruise inherits Rectangle {
    property <SimData> d: Sim.data;
    VerticalLayout {
        padding: 22px;
        spacing: 22px;
        // Stylised speedometer
        Frost {
            vertical-stretch: 8;
            Rectangle {
                property <length> side: min(self.width, self.height) * 1.02;
                width: parent.width;
                height: parent.height;
                Path {
                    x: (parent.width - parent.side) / 2;
                    y: (parent.height - parent.side) / 2 + 40px;
                    width: parent.side;
                    height: parent.side;
                    viewbox-width: 200;
                    viewbox-height: 200;
                    commands: Sim.dial-track;
                    stroke: #ffffff26;
                    stroke-width: 44px;
                    fill: transparent;
                }
                if root.d.speed-arc != "" : Path {
                    x: (parent.width - parent.side) / 2;
                    y: (parent.height - parent.side) / 2 + 40px;
                    width: parent.side;
                    height: parent.side;
                    viewbox-width: 200;
                    viewbox-height: 200;
                    commands: root.d.speed-arc;
                    stroke: @linear-gradient(90deg, #3dffc5 0%, #ffe14d 50%, #ff2d87 100%);
                    stroke-width: 44px;
                    fill: transparent;
                }
                VerticalLayout {
                    width: parent.width;
                    height: parent.height;
                    alignment: center;
                    spacing: 0px;
                    Text { text: "\{root.d.speed}"; color: FestTheme.text; font-family: Fonts.russo; font-size: 270px; font-italic: true; horizontal-alignment: center; }
                    Text { text: root.d.speed-unit; color: FestTheme.yellow; font-family: Fonts.marker; font-size: 72px; horizontal-alignment: center; }
                }
            }
        }
        // RPM DJ equalizer
        Frost {
            vertical-stretch: 4;
            title: "RPM";
            HorizontalLayout {
                padding: 26px;
                padding-top: 60px;
                spacing: 8px;
                for h[i] in Sim.eq-bars : Rectangle {
                    preferred-width: 10px;
                    Rectangle {
                        x: 0px;
                        width: parent.width;
                        height: parent.height * h;
                        y: parent.height - self.height;
                        border-radius: 8px;
                        background: i < 8 ? FestTheme.mint : (i < 15 ? FestTheme.yellow : FestTheme.pink);
                        opacity: h > 0.1 ? 1.0 : 0.35;
                        drop-shadow-blur: h > 0.1 ? 14px : 0px;
                        drop-shadow-color: i < 8 ? FestTheme.mint : (i < 15 ? FestTheme.yellow : FestTheme.pink);
                        animate height { duration: 90ms; }
                    }
                }
            }
        }
        // Car card (media-player style)
        Frost {
            vertical-stretch: 3;
            HorizontalLayout {
                padding: 24px;
                spacing: 24px;
                Rectangle {
                    width: 200px;
                    border-radius: 24px;
                    background: @linear-gradient(135deg, #ff2d87 0%, #ffe14d 100%);
                    Image { width: parent.width * 0.6; height: parent.height * 0.8; x: parent.width * 0.2; y: parent.height * 0.1; source: @image-url("../img/car_drift.svg"); image-fit: contain; }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    Text { text: "NOW DRIVING"; color: FestTheme.yellow; font-family: Fonts.marker; font-size: 34px; }
                    Text { text: root.d.car-info; color: FestTheme.text; font-family: Fonts.russo; font-size: 56px; overflow: elide; }
                    Text { text: "GEAR " + root.d.gear + "   ·   \{root.d.rpm} RPM"; color: FestTheme.dim; font-family: Fonts.russo; font-size: 30px; overflow: elide; }
                }
            }
        }
    }
}

component FestDrift inherits Rectangle {
    property <SimData> d: Sim.data;
    VerticalLayout {
        padding: 22px;
        spacing: 22px;
        // Top-down car rotated by the drift angle.
        Frost {
            vertical-stretch: 8;
            title: "DRIFT ZONE";
            Rectangle {
                property <length> side: min(parent.width, parent.height) - 80px;
                x: (parent.width - self.side) / 2;
                y: (parent.height - self.side) / 2 + 20px;
                width: self.side;
                height: self.side;
                border-radius: self.side / 2;
                background: @radial-gradient(circle, #ffffff22 0%, #ffffff05 70%);
                border-width: 3px;
                border-color: #ffffff55;
                // Direction of travel.
                Image { x: parent.width / 2 - 40px; y: 6px; width: 80px; height: 80px; source: @image-url("../img/arrow.svg"); colorize: FestTheme.mint; }
                Image {
                    x: parent.width * 0.25;
                    y: parent.height * 0.12;
                    width: parent.width * 0.5;
                    height: parent.height * 0.76;
                    source: @image-url("../img/car_drift.svg");
                    image-fit: contain;
                    transform-rotation: root.d.drift-deg * 1deg;
                    animate transform-rotation { duration: 80ms; }
                }
            }
            Text {
                x: parent.width - 260px;
                y: 20px;
                width: 230px;
                text: root.d.drift-text;
                color: FestTheme.text;
                font-family: Fonts.russo;
                font-size: 80px;
                font-italic: true;
                horizontal-alignment: right;
            }
        }
        // Drift score
        Frost {
            vertical-stretch: 3;
            border-color: root.d.drifting ? FestTheme.pink : FestTheme.frost-edge;
            drop-shadow-color: root.d.drifting ? FestTheme.pink : #3a005a55;
            HorizontalLayout {
                padding: 24px;
                Text { text: root.d.drifting ? "DRIFT!" : "SCORE"; color: root.d.drifting ? FestTheme.pink : FestTheme.yellow; font-family: Fonts.marker; font-size: 64px; vertical-alignment: center; }
                Text { horizontal-stretch: 1; text: root.d.drift-score; color: FestTheme.text; font-family: Fonts.russo; font-size: 130px; font-italic: true; horizontal-alignment: right; vertical-alignment: center; overflow: elide; }
            }
        }
        HorizontalLayout {
            vertical-stretch: 3;
            min-height: 0px;
            preferred-height: 0px;
            spacing: 22px;
            Frost {
                title: "PEAK LATERAL G";
                Text { y: 40px; width: parent.width; height: parent.height - 40px; text: root.d.peak-lat-g; color: FestTheme.text; font-family: Fonts.russo; font-size: 84px; horizontal-alignment: center; vertical-alignment: center; }
            }
            Frost {
                title: "LIVE G";
                Text { y: 40px; width: parent.width; height: parent.height - 40px; text: root.d.g-text; color: FestTheme.mint; font-family: Fonts.russo; font-size: 84px; horizontal-alignment: center; vertical-alignment: center; }
            }
        }
    }
}

component FestExplorer inherits Rectangle {
    property <SimData> d: Sim.data;
    VerticalLayout {
        padding: 22px;
        spacing: 22px;
        // Scrolling compass tape
        Frost {
            vertical-stretch: 2;
            Image {
                property <length> tape: parent.width * 4;
                x: parent.width / 2 - (root.d.heading-deg + 180) / 720 * self.tape;
                y: parent.height - 70px;
                width: self.tape;
                height: 60px;
                source: @image-url("../img/compass_tape.svg");
                image-fit: fill;
            }
            for m in Sim.compass : Text {
                x: parent.width * m.x - 60px;
                y: 14px;
                width: 120px;
                height: 60px;
                text: m.label;
                color: m.major ? FestTheme.yellow : #ffffffaa;
                font-family: m.major ? Fonts.marker : Fonts.russo;
                font-size: m.major ? 44px : 24px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            Rectangle { x: parent.width / 2 - 3px; y: 0px; width: 6px; height: parent.height; background: FestTheme.pink; }
        }
        // Map trail
        Frost {
            vertical-stretch: 8;
            title: "EXPLORER  ·  " + root.d.heading;
            TrackMap {
                width: parent.width;
                height: parent.height;
                path: Sim.map-path;
                dots: Sim.map-dots;
                note: Sim.data.map-note;
                track-color: FestTheme.yellow;
                track-edge: #3a005a;
                player-color: FestTheme.pink;
                note-color: FestTheme.dim;
                line-width: 12px;
                dot-size: 40px;
            }
        }
        HorizontalLayout {
            vertical-stretch: 3;
            min-height: 0px;
            preferred-height: 0px;
            spacing: 22px;
            Frost {
                title: "TOP SPEED";
                Text { y: 40px; width: parent.width; height: parent.height - 40px; text: root.d.max-speed + " " + root.d.speed-unit; color: FestTheme.text; font-family: Fonts.russo; font-size: 64px; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
            }
            Frost {
                title: "ELEVATION";
                Text { y: 40px; width: parent.width; height: parent.height - 40px; text: root.d.elevation; color: FestTheme.mint; font-family: Fonts.russo; font-size: 64px; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
            }
        }
    }
}

export component Fh6Dash inherits DashShell {
    background: #2a0632;
    tabs: [
        { label: "CRUISE", icon: @image-url("../img/icons/music.svg") },
        { label: "DRIFT", icon: @image-url("../img/icons/drift.svg") },
        { label: "EXPLORER", icon: @image-url("../img/icons/compass.svg") }
    ];
    accent: FestTheme.pink;
    dock-bg: #1a0b2e;
    dock-idle: #33124d;
    dock-text: #ffe6f2;
    pill-idle: #2a0e45;
    pill-idle-text: FestTheme.dim;
    font: Fonts.russo;
    radius: 30px;

    Rectangle { width: parent.width; height: parent.height; background: FestTheme.sky; }
    // Light streaks drift with your heading.
    Image {
        x: -200px - (Sim.data.heading-deg / 360) * 400px;
        width: parent.width + 400px;
        height: parent.height;
        source: @image-url("../img/festival.svg");
        image-fit: fill;
    }
    if Sim.layout == 0 : FestCruise { width: parent.width; height: parent.height; }
    if Sim.layout == 1 : FestDrift { width: parent.width; height: parent.height; }
    if Sim.layout >= 2 : FestExplorer { width: parent.width; height: parent.height; }
}
