// DiRT Rally 2.0 - "Group B Analog". Physical 1980s dashboard: matte #111111 with a grunge
// overlay, a colossal printed tachometer with an orange needle that shakes with the engine,
// glass-glare survival gauges, and a backlit green LCD stage timer.
// DR2 sends no oil / water / boost data; the survival gauges show brake temps and speed.
// Pages: TACH, SURVIVAL, PHYSICS.

import { Sim, SimData, Corner, DialLabel } from "../sim/sim_state.slint";
import { DashShell, Dial, GMeter } from "../sim/sim_widgets.slint";
import { Fonts, Texture, StatStrip, Stat, FadePage } from "../kit.slint";
import { AppState } from "../globals.slint";
import { TrackMap } from "../map.slint";
import { Art } from "../art.slint";

global Dr2Theme {
    out property <color> base: #111111;
    out property <color> plate: #1a1a18;
    out property <color> cream: #efe7cf;
    out property <color> orange: #ff7a0a;
    out property <color> dim: #8a8573;
    out property <color> lcd: #7dff7a;
    // Fills, see-through per the PANELS setting (the LCD keeps a little more body).
    out property <color> lcd-bg: rgba(10, 22, 10, 0.2 + 0.8 * AppState.panel);
    out property <color> well: rgba(11, 11, 10, AppState.panel);
    out property <color> plate-bg: rgba(13, 13, 12, AppState.panel);
}

struct LabelPos {
    x: float,
    y: float,
    t: string,
}

// Printed-plate stat strip.
component Dr2Strip inherits StatStrip {
    texture: Art.panel-dr2;
    textured: Art.panel-dr2-custom;
    cell-bg: Dr2Theme.plate-bg;
    edge: #3a362a;
    label-color: Dr2Theme.dim;
    value-color: Dr2Theme.cream;
    font: Fonts.russo;
    value-size: 32px;
    label-size: 17px;
    radius: 10px;
    gap: 12px;
}

// Backlit LCD readout.
component Lcd inherits Rectangle {
    in property <string> text;
    in property <string> label;
    in property <length> size: 150px;
    min-height: 0px;
    preferred-height: 0px;
    background: Dr2Theme.lcd-bg;
    border-radius: 14px;
    border-width: 10px;
    border-color: #262622;
    drop-shadow-blur: 30px;
    drop-shadow-color: #00ff0044;
    clip: true;
    // Backlight glow behind the digits.
    Rectangle {
        x: parent.width * 0.1;
        y: parent.height * 0.25;
        width: parent.width * 0.8;
        height: parent.height * 0.5;
        border-radius: self.height / 2;
        background: #00ff000a;
        drop-shadow-blur: 30px;
        drop-shadow-color: #00ff0026;
    }
    Text { x: 24px; y: 14px; text: root.label; color: #3f7f3c; font-family: Fonts.mono; font-size: 24px; }
    Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: Dr2Theme.lcd;
        font-family: Fonts.mono;
        font-size: root.size;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component Dr2TachPage inherits FadePage {
    property <SimData> d: Sim.data;
    // Number positions on the 800 x 800 dial face (0..9 x1000 rpm).
    property <[LabelPos]> nums: [
        { x: 248.0, y: 552.0, t: "0" }, { x: 192.3, y: 455.6, t: "1" }, { x: 192.3, y: 344.4, t: "2" },
        { x: 248.0, y: 248.0, t: "3" }, { x: 344.4, y: 192.3, t: "4" }, { x: 455.6, y: 192.3, t: "5" },
        { x: 552.0, y: 248.0, t: "6" }, { x: 607.7, y: 344.4, t: "7" }, { x: 607.7, y: 455.6, t: "8" },
        { x: 552.0, y: 552.0, t: "9" }
    ];
    VerticalLayout {
        padding: 18px;
        spacing: 22px;
        Rectangle {
            vertical-stretch: 9;
            min-height: 0px;
            preferred-height: 0px;
            property <length> side: min(self.width, self.height);
            property <length> ox: (self.width - self.side) / 2;
            property <length> oy: (self.height - self.side) / 2;
            property <float> k: self.side / 800px;
            // Round clip hides the black corners of an AI tach face.
            Rectangle {
                x: parent.ox;
                y: parent.oy;
                width: parent.side;
                height: parent.side;
                border-radius: parent.side / 2;
                clip: true;
                Image { width: parent.width; height: parent.height; source: Art.dr2-tach-face; image-fit: contain; }
            }
            Image { x: parent.ox; y: parent.oy; width: parent.side; height: parent.side; source: @image-url("../img/tach_ticks.svg"); }
            for n in root.nums : Text {
                x: parent.ox + (n.x - 45) * parent.k * 1px;
                y: parent.oy + (n.y - 40) * parent.k * 1px;
                width: 90px * parent.k;
                height: 80px * parent.k;
                text: n.t;
                color: n.t == "8" || n.t == "9" ? #ff5a3a : Dr2Theme.cream;
                font-family: Fonts.russo;
                font-size: 64px * parent.k;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            Text {
                x: parent.ox;
                y: parent.oy + parent.side * 0.62;
                width: parent.side;
                height: parent.side * 0.16;
                text: root.d.gear;
                color: Dr2Theme.cream;
                font-family: Fonts.russo;
                font-size: 120px * parent.k;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            Text {
                x: parent.ox;
                y: parent.oy + parent.side * 0.36;
                width: parent.side;
                height: 40px;
                text: "RPM x1000";
                color: Dr2Theme.dim;
                font-family: Fonts.russo;
                font-size: 26px * parent.k;
                horizontal-alignment: center;
            }
            // Shift lamp
            Rectangle {
                x: parent.ox + parent.side * 0.465;
                y: parent.oy + parent.side * 0.27;
                width: parent.side * 0.07;
                height: self.width;
                border-radius: self.width / 2;
                background: root.d.shift ? (root.d.blink ? #ff3b1a : #5a1408) : #2a1a14;
                border-width: 4px;
                border-color: #3a362a;
                drop-shadow-blur: root.d.shift ? 40px : 0px;
                drop-shadow-color: #ff3b1a;
            }
            Image {
                x: parent.ox;
                y: parent.oy;
                width: parent.side;
                height: parent.side;
                source: Art.dr2-needle;
                image-fit: contain;
                transform-rotation: root.d.tach9-angle * 1deg;
                animate transform-rotation { duration: 40ms; }
            }
        }
        HorizontalLayout {
            vertical-stretch: 2.4;
            min-height: 0px;
            preferred-height: 0px;
            spacing: 18px;
            Lcd { horizontal-stretch: 3; label: "STAGE"; text: root.d.stage-time; size: 92px; }
            Lcd { horizontal-stretch: 2; label: root.d.speed-unit; text: "\{root.d.speed}"; size: 92px; }
        }
        Dr2Strip {
            vertical-stretch: 1.4;
            stats: [
                { label: "PROGRESS", value: root.d.has-stage ? root.d.stage-pct : "--", tint: transparent },
                { label: "DISTANCE", value: root.d.has-stage ? root.d.stage-text : "--", tint: transparent },
                { label: "POSITION", value: root.d.pos-text, tint: transparent },
                { label: "LAST STAGE", value: root.d.last-lap, tint: transparent },
                { label: "ALL-TIME", value: root.d.pb-lap, tint: Dr2Theme.orange }
            ];
        }
    }
}

// Analog gauge with curved-glass glare.
component GlassGauge inherits Rectangle {
    in property <string> title;
    in property <string> value;
    in property <string> needle;
    in property <string> ticks;
    in property <[DialLabel]> labels;
    min-height: 0px;
    preferred-height: 0px;
    HorizontalLayout {
        spacing: 26px;
        Rectangle {
            property <length> side: min(self.width, self.height);
            width: root.height;
            // Clipped to a circle so the AI image's square corners don't show.
            if Art.dr2-gauge-face-custom : Rectangle {
                x: (parent.width - parent.side) / 2;
                y: (parent.height - parent.side) / 2;
                width: parent.side;
                height: parent.side;
                border-radius: parent.side / 2;
                clip: true;
                Image { width: parent.width; height: parent.height; source: Art.dr2-gauge-face; image-fit: contain; }
            }
            Dial {
                show-face: !Art.dr2-gauge-face-custom;
                width: parent.width;
                height: parent.height;
                ticks: root.ticks;
                labels: root.labels;
                arc: "";
                needle: root.needle;
                value: "";
                unit: "";
                face: @radial-gradient(circle, #22211d 0%, #0a0a09 100%);
                rim: #6c685e;
                // Dark markings on a custom (cream) gauge face, cream on the built-in black one.
                tick-color: Art.dr2-gauge-face-custom ? #2a2620 : Dr2Theme.cream;
                label-color: Art.dr2-gauge-face-custom ? #2a2620 : Dr2Theme.cream;
                track-color: Art.dr2-gauge-face-custom ? transparent : #2a2720;
                needle-color: Dr2Theme.orange;
                label-size: 20px;
                font: Fonts.russo;
            }
            // Glass glare over the left half.
            Rectangle {
                x: (parent.width - parent.side) / 2;
                y: (parent.height - parent.side) / 2;
                width: parent.side;
                height: parent.side;
                border-radius: parent.side / 2;
                background: @linear-gradient(90deg, #ffffff40 0%, #ffffff10 40%, transparent 55%);
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            Text { text: root.title; color: Dr2Theme.dim; font-family: Fonts.russo; font-size: 24px; }
            Text { text: root.value; color: Dr2Theme.cream; font-family: Fonts.russo; font-size: 64px; overflow: elide; }
        }
    }
}

component Dr2SurvivalPage inherits FadePage {
    property <SimData> d: Sim.data;
    VerticalLayout {
        padding: 20px;
        spacing: 18px;
        GlassGauge { vertical-stretch: 1; title: "BRAKES FRONT"; value: root.d.brake-front; needle: root.d.brake-front-needle; ticks: Sim.speed-ticks; labels: []; }
        GlassGauge { vertical-stretch: 1; title: "BRAKES REAR"; value: root.d.brake-rear; needle: root.d.brake-rear-needle; ticks: Sim.speed-ticks; labels: []; }
        GlassGauge { vertical-stretch: 1; title: "SPEED  " + root.d.speed-unit; value: "\{root.d.speed}"; needle: root.d.speed-needle; ticks: Sim.speed-ticks; labels: Sim.speed-labels; }
        Dr2Strip {
            vertical-stretch: 0.32;
            stats: [
                { label: "FL BRAKE", value: root.d.fl.brake == "" ? "--" : root.d.fl.brake, tint: root.d.fl.brake-color },
                { label: "FR BRAKE", value: root.d.fr.brake == "" ? "--" : root.d.fr.brake, tint: root.d.fr.brake-color },
                { label: "RL BRAKE", value: root.d.rl.brake == "" ? "--" : root.d.rl.brake, tint: root.d.rl.brake-color },
                { label: "RR BRAKE", value: root.d.rr.brake == "" ? "--" : root.d.rr.brake, tint: root.d.rr.brake-color }
            ];
        }
        Dr2Strip {
            vertical-stretch: 0.32;
            stats: [
                { label: "GEAR", value: root.d.gear, tint: transparent },
                { label: "RPM", value: "\{root.d.rpm}", tint: root.d.shift ? #ff5a3a : transparent },
                { label: "TOP SPEED", value: root.d.max-speed, tint: transparent },
                { label: "STAGE TIME", value: root.d.stage-time, tint: Dr2Theme.lcd }
            ];
        }
    }
}

component Dr2Bar inherits Rectangle {
    in property <string> label;
    in property <float> value;
    in property <color> fill: Dr2Theme.orange;
    preferred-width: 100px;
    min-width: 0px;
    VerticalLayout {
        spacing: 8px;
        Rectangle {
            vertical-stretch: 1;
            min-height: 0px;
            background: Dr2Theme.well;
            border-radius: 8px;
            border-width: 3px;
            border-color: #3a362a;
            clip: true;
            Rectangle {
                x: 6px;
                width: parent.width - 12px;
                height: (parent.height - 12px) * max(0.0, min(1.0, root.value));
                y: parent.height - 6px - self.height;
                border-radius: 4px;
                background: root.fill;
                animate height { duration: 80ms; }
            }
        }
        Text { text: root.label; color: Dr2Theme.dim; font-family: Fonts.russo; font-size: 22px; horizontal-alignment: center; }
    }
}

component Dr2PhysicsPage inherits FadePage {
    property <SimData> d: Sim.data;
    VerticalLayout {
        padding: 20px;
        spacing: 20px;
        HorizontalLayout {
            vertical-stretch: 6;
            min-height: 0px;
            preferred-height: 0px;
            spacing: 20px;
            GMeter {
                horizontal-stretch: 3;
                lat: root.d.g-lat;
                long: root.d.g-long;
                ring: #4a463a;
                dot: Dr2Theme.orange;
                face: @radial-gradient(circle, #1f1e1a 0%, #0a0a09 100%);
            }
            VerticalLayout {
                horizontal-stretch: 2;
                alignment: center;
                spacing: 10px;
                Text { text: "LATERAL"; color: Dr2Theme.dim; font-family: Fonts.russo; font-size: 22px; }
                Text { text: root.d.g-text; color: Dr2Theme.cream; font-family: Fonts.russo; font-size: 56px; }
                Text { text: "PEAK  " + root.d.peak-lat-g; color: Dr2Theme.orange; font-family: Fonts.russo; font-size: 30px; }
            }
        }
        Dr2Strip {
            vertical-stretch: 1.1;
            stats: [
                { label: "YAW RATE", value: root.d.yaw-rate, tint: transparent },
                { label: "DRIFT", value: root.d.drift-text, tint: transparent },
                { label: "TOP SPEED", value: root.d.max-speed, tint: transparent },
                { label: "DISTANCE", value: root.d.distance, tint: transparent }
            ];
        }
        // Suspension compression + wheel slip
        HorizontalLayout {
            vertical-stretch: 4;
            min-height: 0px;
            preferred-height: 0px;
            spacing: 14px;
            Dr2Bar { label: "SUS FL"; value: root.d.fl.susp; fill: Dr2Theme.cream; }
            Dr2Bar { label: "SUS FR"; value: root.d.fr.susp; fill: Dr2Theme.cream; }
            Dr2Bar { label: "SUS RL"; value: root.d.rl.susp; fill: Dr2Theme.cream; }
            Dr2Bar { label: "SUS RR"; value: root.d.rr.susp; fill: Dr2Theme.cream; }
            Rectangle { width: 10px; }
            Dr2Bar { label: "SLIP FL"; value: root.d.fl.slip * 0.5; }
            Dr2Bar { label: "SLIP FR"; value: root.d.fr.slip * 0.5; }
            Dr2Bar { label: "SLIP RL"; value: root.d.rl.slip * 0.5; }
            Dr2Bar { label: "SLIP RR"; value: root.d.rr.slip * 0.5; }
        }
        Rectangle {
            vertical-stretch: 5;
            min-height: 0px;
            preferred-height: 0px;
            background: Dr2Theme.plate-bg;
            border-radius: 14px;
            border-width: 3px;
            border-color: #3a362a;
            TrackMap {
                width: parent.width;
                height: parent.height;
                path: Sim.map-path;
                dots: Sim.map-dots;
                note: Sim.data.map-note;
                track-color: Dr2Theme.cream;
                track-edge: #000000;
                player-color: Dr2Theme.orange;
                note-color: Dr2Theme.dim;
                line-width: 9px;
            }
        }
    }
}

export component Dr2Dash inherits DashShell {
    waiting-art: Art.tile-dr2;
    dock-texture: Art.dock-dr2;
    dock-textured: Art.dock-dr2-custom;
    waiting-has-art: Art.tile-dr2-custom;
    waiting-emblem: Art.emblem-dr2;
    waiting-card: #141412;
    background: Dr2Theme.base;
    tabs: [
        { label: "TACH", icon: @image-url("../img/icons/gauge.svg") },
        { label: "SURVIVAL", icon: @image-url("../img/icons/thermo.svg") },
        { label: "PHYSICS", icon: @image-url("../img/icons/target.svg") }
    ];
    accent: Dr2Theme.orange;
    dock-bg: #0b0b0a;
    dock-idle: #1d1c19;
    dock-text: Dr2Theme.cream;
    pill-idle: #161614;
    pill-idle-text: Dr2Theme.dim;
    font: Fonts.russo;
    radius: 10px;

    Texture { y: 0px; width: root.width; height: root.page-height; source: Art.bg-dr2; opacity: Art.bg-dr2-custom ? 1.0 : 0.85; }
    if Sim.layout == 0 : Dr2TachPage { y: 0px; width: root.width; height: root.page-height; }
    if Sim.layout == 1 : Dr2SurvivalPage { y: 0px; width: root.width; height: root.page-height; }
    if Sim.layout >= 2 : Dr2PhysicsPage { y: 0px; width: root.width; height: root.page-height; }
}
