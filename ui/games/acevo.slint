// Assetto Corsa EVO - "MoTeC C127". Anti-aliased GT3 data logger: pure black, white digits with
// dim "8888" ghost segments behind them (so digits never jump), flat colour, zero fluff.
// Pages: DASH (shift lights, gear, TC / ABS, map, fuel), THE RIG (suspension, pressures, bias),
// PIT BOX (stint, lap matrix, pit macro).

import { Sim, SimData, Corner, SimRow } from "../sim/sim_state.slint";
import { DashShell, DeltaStrip } from "../sim/sim_widgets.slint";
import { Fonts, GhostText, StatStrip, Stat, FadePage } from "../kit.slint";
import { AppState } from "../globals.slint";
import { TrackMap } from "../map.slint";
import { Art } from "../art.slint";

global EvoTheme {
    out property <color> black: #000000;
    out property <color> line: #262626;
    out property <color> white: #ffffff;
    out property <color> dim: #7a7a7a;
    // Faint white so the unlit segments read on top of any background art.
    out property <color> ghost: rgba(255, 255, 255, 0.07);
    // Cell fills, see-through per the PANELS setting.
    out property <color> cell: rgba(0, 0, 0, AppState.panel);
    out property <color> well: rgba(7, 7, 7, AppState.panel);
    out property <color> row: rgba(11, 11, 11, AppState.panel);
    out property <color> pit: rgba(0, 8, 20, AppState.panel);
    out property <color> red: #ff1a1a;
    out property <color> blue: #1e90ff;
    out property <color> yellow: #ffd600;
}

// Thin-bordered black cell with a caption.
component Cell inherits Rectangle {
    in property <string> caption;
    min-height: 0px;
    preferred-height: 0px;
    min-width: 0px;
    preferred-width: 100px;
    background: EvoTheme.cell;
    border-width: 2px;
    border-color: EvoTheme.line;
    if Art.panel-acevo-custom : Image { width: parent.width; height: parent.height; source: Art.panel-acevo; image-fit: cover; opacity: 0.25; }
    if root.caption != "" : Text {
        x: 12px;
        y: 6px;
        text: root.caption;
        color: EvoTheme.dim;
        font-family: Fonts.mono;
        font-size: 22px;
    }
}

// MoTeC-style stat strip.
component EvoStrip inherits StatStrip {
    texture: Art.panel-acevo;
    textured: Art.panel-acevo-custom;
    cell-bg: EvoTheme.cell;
    edge: EvoTheme.line;
    label-color: EvoTheme.dim;
    font: Fonts.mono;
    value-size: 40px;
    label-size: 18px;
    radius: 0px;
    gap: 12px;
}

// TC / ABS intervention square: snaps to yellow while the system acts.
component AssistSquare inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    in property <string> level;
    min-height: 0px;
    preferred-height: 0px;
    background: root.active ? EvoTheme.yellow : EvoTheme.cell;
    border-width: 6px;
    border-color: root.active ? EvoTheme.yellow : #3a3a3a;
    VerticalLayout {
        alignment: center;
        Text { text: root.label; color: root.active ? #000000 : EvoTheme.yellow; font-family: Fonts.mono; font-size: 52px; horizontal-alignment: center; }
        Text { text: "LVL " + root.level; color: root.active ? #000000 : EvoTheme.dim; font-family: Fonts.mono; font-size: 22px; horizontal-alignment: center; }
    }
}

component EvoDash inherits FadePage {
    property <SimData> d: Sim.data;
    VerticalLayout {
        padding: 14px;
        spacing: 12px;
        // 15 shift lights, zero spacing.
        HorizontalLayout {
            vertical-stretch: 1;
            min-height: 0px;
            preferred-height: 0px;
            spacing: 0px;
            for i in 15 : Rectangle {
                preferred-width: 10px;
                border-width: 1px;
                border-color: #000000;
                background: root.d.shift ? (root.d.blink ? EvoTheme.blue : #000000)
                    : (i < root.d.rev-count ? (i < 6 ? #00c853 : (i < 11 ? EvoTheme.yellow : EvoTheme.red)) : #111111);
            }
        }
        // Gear + speed + position
        HorizontalLayout {
            vertical-stretch: 4;
            min-height: 0px;
            preferred-height: 0px;
            spacing: 12px;
            Cell {
                horizontal-stretch: 3;
                caption: "GEAR";
                GhostText { width: parent.width; height: parent.height; text: root.d.gear; ghost: "8"; size: 270px; color-on: EvoTheme.white; color-off: EvoTheme.ghost; }
            }
            VerticalLayout {
                horizontal-stretch: 2;
                min-width: 0px;
                preferred-width: 100px;
                spacing: 12px;
                Cell {
                    caption: root.d.speed-unit;
                    GhostText { width: parent.width; height: parent.height; text: "\{root.d.speed}"; ghost: "888"; size: 96px; color-off: EvoTheme.ghost; }
                }
                Cell {
                    caption: "POS";
                    GhostText { width: parent.width; height: parent.height; text: root.d.pos-text; ghost: "P88/88"; size: 56px; color-off: EvoTheme.ghost; }
                }
                Cell {
                    caption: "RPM";
                    GhostText { width: parent.width; height: parent.height; text: "\{root.d.rpm}"; ghost: "88888"; size: 56px; color-on: root.d.shift ? EvoTheme.red : EvoTheme.white; color-off: EvoTheme.ghost; }
                }
            }
        }
        // Delta
        DeltaStrip {
            vertical-stretch: 1;
            title: "DELTA";
            delta: root.d.delta;
            valid: root.d.has-delta;
            text: root.d.delta-text;
            bg: EvoTheme.cell;
            faster: #00a844;
            slower: #c41212;
            font: Fonts.mono;
            radius: 0px;
            font-size: 48px;
        }
        // Lap times
        EvoStrip {
            vertical-stretch: 1.3;
            stats: [
                { label: root.d.lap-invalid ? "CURRENT INV" : "CURRENT", value: root.d.current-lap, tint: root.d.lap-invalid ? EvoTheme.red : transparent },
                { label: "LAST", value: root.d.last-lap, tint: transparent },
                { label: "BEST", value: root.d.best-lap, tint: #00c853 },
                { label: "ALL-TIME", value: root.d.pb-lap, tint: #b04bff },
                { label: "LAST VS PB", value: root.d.pb-gap == "" ? "--" : root.d.pb-gap, tint: root.d.pb-gap == "" ? EvoTheme.dim : (root.d.pb-gap-good ? #00c853 : EvoTheme.red) }
            ];
        }        // TC / map / ABS
        HorizontalLayout {
            vertical-stretch: 4;
            min-height: 0px;
            preferred-height: 0px;
            spacing: 12px;
            VerticalLayout {
                width: 180px;
                spacing: 12px;
                AssistSquare { vertical-stretch: 1; label: "TC"; active: root.d.tc-active; level: root.d.tc-level; }
                AssistSquare { vertical-stretch: 1; label: "ABS"; active: root.d.abs-active; level: root.d.abs-level; }
            }
            Cell {
                caption: "TRACK";
                TrackMap {
                    width: parent.width;
                    height: parent.height;
                    path: Sim.map-path;
                    dots: Sim.map-dots;
                    note: Sim.data.map-note;
                    track-color: EvoTheme.white;
                    track-edge: #000000;
                    player-color: EvoTheme.red;
                    car-color: EvoTheme.blue;
                    label-color: #ffffff;
                    note-color: EvoTheme.dim;
                    line-width: 6px;
                    dot-size: 26px;
                }
            }
        }
        // Fuel
        HorizontalLayout {
            vertical-stretch: 1.6;
            min-height: 0px;
            preferred-height: 0px;
            spacing: 12px;
            Cell {
                caption: "FUEL / LAP AVG";
                GhostText { width: parent.width; height: parent.height; text: root.d.fuel-per-lap; ghost: "88.88 L"; size: 46px; color-off: EvoTheme.ghost; }
            }
            Cell {
                caption: "IN TANK";
                GhostText { width: parent.width; height: parent.height; text: root.d.fuel; ghost: "88.8 L"; size: 46px; color-off: EvoTheme.ghost; }
            }
            Cell {
                caption: "LAPS REMAINING";
                GhostText {
                    width: parent.width;
                    height: parent.height;
                    text: root.d.fuel-laps;
                    ghost: "88.8";
                    size: 60px;
                    color-on: root.d.fuel-laps-num >= 0 && root.d.fuel-laps-num < 2 ? EvoTheme.red : EvoTheme.white;
                    color-off: EvoTheme.ghost;
                }
            }
        }
    }
}

// Live suspension travel: a thin white bar that rides up and down inside a dark box.
component SuspGauge inherits Rectangle {
    in property <string> label;
    in property <Corner> c;
    min-width: 0px;
    preferred-width: 100px;
    VerticalLayout {
        spacing: 10px;
        Rectangle {
            vertical-stretch: 1;
            min-height: 0px;
            background: EvoTheme.well;
            border-width: 2px;
            border-color: EvoTheme.line;
            clip: true;
            for i in 5 : Rectangle { x: 0px; y: parent.height * (i + 1) / 6; width: parent.width; height: 1px; background: #1a1a1a; }
            Rectangle {
                x: 12px;
                width: parent.width - 24px;
                height: 8px;
                y: (parent.height - self.height) * (1.0 - root.c.susp);
                background: EvoTheme.white;
                animate y { duration: 60ms; }
            }
        }
        Text { text: root.label; color: EvoTheme.dim; font-family: Fonts.mono; font-size: 28px; horizontal-alignment: center; }
    }
}

component EvoRig inherits FadePage {
    property <SimData> d: Sim.data;
    VerticalLayout {
        padding: 14px;
        spacing: 14px;
        Cell {
            vertical-stretch: 4;
            caption: "SUSPENSION TRAVEL";
            HorizontalLayout {
                padding: 20px;
                padding-top: 44px;
                spacing: 28px;
                SuspGauge { label: "FL"; c: root.d.fl; }
                SuspGauge { label: "FR"; c: root.d.fr; }
                SuspGauge { label: "RL"; c: root.d.rl; }
                SuspGauge { label: "RR"; c: root.d.rr; }
            }
        }
        // Tyre pressures
        GridLayout {
            vertical-stretch: 3;
            min-height: 0px;
            preferred-height: 0px;
            spacing: 12px;
            Row {
                Cell { caption: "FL PSI"; GhostText { width: parent.width; height: parent.height; text: root.d.fl.pressure; ghost: "88.8"; size: 96px; color-on: root.d.fl.pressure-color; color-off: EvoTheme.ghost; } }
                Cell { caption: "FR PSI"; GhostText { width: parent.width; height: parent.height; text: root.d.fr.pressure; ghost: "88.8"; size: 96px; color-on: root.d.fr.pressure-color; color-off: EvoTheme.ghost; } }
            }
            Row {
                Cell { caption: "RL PSI"; GhostText { width: parent.width; height: parent.height; text: root.d.rl.pressure; ghost: "88.8"; size: 96px; color-on: root.d.rl.pressure-color; color-off: EvoTheme.ghost; } }
                Cell { caption: "RR PSI"; GhostText { width: parent.width; height: parent.height; text: root.d.rr.pressure; ghost: "88.8"; size: 96px; color-on: root.d.rr.pressure-color; color-off: EvoTheme.ghost; } }
            }
        }
        // Tyre and brake temperatures
        EvoStrip {
            vertical-stretch: 1.4;
            stats: [
                { label: "FL TYRE", value: root.d.fl.temp, tint: root.d.fl.temp-color },
                { label: "FR TYRE", value: root.d.fr.temp, tint: root.d.fr.temp-color },
                { label: "RL TYRE", value: root.d.rl.temp, tint: root.d.rl.temp-color },
                { label: "RR TYRE", value: root.d.rr.temp, tint: root.d.rr.temp-color }
            ];
        }
        EvoStrip {
            vertical-stretch: 1.4;
            stats: [
                { label: "FL BRAKE", value: root.d.fl.brake, tint: root.d.fl.brake-color },
                { label: "FR BRAKE", value: root.d.fr.brake, tint: root.d.fr.brake-color },
                { label: "RL BRAKE", value: root.d.rl.brake, tint: root.d.rl.brake-color },
                { label: "RR BRAKE", value: root.d.rr.brake, tint: root.d.rr.brake-color }
            ];
        }
        // Brake bias: car silhouette with a front (blue) / rear (red) bias bar across the wheels.
        Cell {
            vertical-stretch: 4;
            caption: "BRAKE BIAS";
            HorizontalLayout {
                padding: 20px;
                padding-top: 44px;
                spacing: 30px;
                Rectangle {
                    width: 240px;
                    Image { width: parent.width; height: parent.height; source: Art.car-gt; image-fit: contain; }
                    // Bias bar: front share in blue from the nose, rear share in red.
                    Rectangle {
                        x: parent.width * 0.42;
                        y: parent.height * 0.04;
                        width: parent.width * 0.16;
                        height: parent.height * 0.92;
                        border-radius: 6px;
                        background: #c41212cc;
                        Rectangle {
                            x: 0px;
                            y: 0px;
                            width: parent.width;
                            height: parent.height * max(0.0, min(1.0, 0.4 + root.d.bias-pct * 0.3));
                            border-radius: 6px;
                            background: #1e90ffdd;
                            animate height { duration: 150ms; }
                        }
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 10px;
                    Text { text: "FRONT"; color: EvoTheme.blue; font-family: Fonts.mono; font-size: 28px; }
                    GhostText { height: 110px; text: root.d.brake-bias; ghost: "88.8%"; size: 96px; color-on: EvoTheme.white; color-off: EvoTheme.ghost; align: left; }
                    Text { text: "TC " + root.d.tc-level + "   ABS " + root.d.abs-level; color: EvoTheme.dim; font-family: Fonts.mono; font-size: 28px; }
                }
            }
        }
    }
}

component EvoPitBox inherits FadePage {
    property <SimData> d: Sim.data;
    VerticalLayout {
        padding: 14px;
        spacing: 14px;
        HorizontalLayout {
            vertical-stretch: 3;
            min-height: 0px;
            preferred-height: 0px;
            spacing: 12px;
            Cell { caption: "STINT"; GhostText { width: parent.width; height: parent.height; text: root.d.stint-time; ghost: "8:88:88"; size: 60px; color-off: EvoTheme.ghost; } }
            Cell { caption: "SESSION LEFT"; GhostText { width: parent.width; height: parent.height; text: root.d.time-left; ghost: "88:88"; size: 60px; color-on: EvoTheme.yellow; color-off: EvoTheme.ghost; } }
        }
        EvoStrip {
            vertical-stretch: 1.4;
            stats: [
                { label: "POS", value: root.d.pos-text, tint: transparent },
                { label: "BEST", value: root.d.best-lap, tint: #00c853 },
                { label: "ALL-TIME", value: root.d.pb-lap, tint: #b04bff },
                { label: "FUEL/LAP", value: root.d.fuel-per-lap, tint: transparent }
            ];
        }
        // Lap matrix: lap / time / gap to best, best lap on purple.
        Cell {
            vertical-stretch: 7;
            caption: "LAP MATRIX";
            VerticalLayout {
                padding: 14px;
                padding-top: 40px;
                spacing: 6px;
                HorizontalLayout {
                    height: 36px;
                    Text { width: 160px; text: "LAP"; color: EvoTheme.dim; font-family: Fonts.mono; font-size: 26px; }
                    Text { horizontal-stretch: 1; text: "TIME"; color: EvoTheme.dim; font-family: Fonts.mono; font-size: 26px; horizontal-alignment: center; }
                    Text { width: 260px; text: "GAP"; color: EvoTheme.dim; font-family: Fonts.mono; font-size: 26px; horizontal-alignment: right; }
                }
                if Sim.lap-list.length == 0 : Rectangle {
                    vertical-stretch: 1;
                    border-width: 1px;
                    border-color: EvoTheme.line;
                    VerticalLayout {
                        alignment: center;
                        spacing: 8px;
                        Text { text: "NO COMPLETED LAPS YET"; color: EvoTheme.white; font-family: Fonts.mono; font-size: 32px; horizontal-alignment: center; }
                        Text { text: "EACH LAP IS LISTED HERE AS YOU CROSS THE LINE"; color: EvoTheme.dim; font-family: Fonts.mono; font-size: 20px; horizontal-alignment: center; }
                    }
                }
                for l in Sim.lap-list : Rectangle {
                    vertical-stretch: 1;
                    min-height: 0px;
                    preferred-height: 0px;
                    background: l.player ? #800080 : EvoTheme.row;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        Text { width: 150px; text: "L\{l.pos}"; color: EvoTheme.white; font-family: Fonts.mono; font-size: 32px; vertical-alignment: center; }
                        Text { horizontal-stretch: 1; text: l.name; color: EvoTheme.white; font-family: Fonts.mono; font-size: 38px; horizontal-alignment: center; vertical-alignment: center; }
                        Text { width: 260px; text: l.gap; color: l.player ? #ffffff : EvoTheme.dim; font-family: Fonts.mono; font-size: 32px; horizontal-alignment: right; vertical-alignment: center; }
                    }
                }
                Rectangle { vertical-stretch: 0.01; }
            }
        }
        // Pit macro
        Rectangle {
            vertical-stretch: 4;
            min-height: 0px;
            preferred-height: 0px;
            background: EvoTheme.pit;
            border-width: 8px;
            border-color: #0055ff;
            VerticalLayout {
                padding: 22px;
                spacing: 8px;
                Text { text: "PIT STOP PREP"; color: #6f9bff; font-family: Fonts.mono; font-size: 30px; }
                HorizontalLayout {
                    spacing: 20px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        preferred-width: 10px;
                        Text { text: "FUEL TO ADD"; color: EvoTheme.dim; font-family: Fonts.mono; font-size: 24px; }
                        Text { text: root.d.fuel-to-add; color: EvoTheme.white; font-family: Fonts.mono; font-size: 56px; overflow: elide; }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        preferred-width: 10px;
                        Text { text: "IN TANK"; color: EvoTheme.dim; font-family: Fonts.mono; font-size: 24px; }
                        Text { text: root.d.fuel; color: EvoTheme.white; font-family: Fonts.mono; font-size: 56px; overflow: elide; }
                    }
                }
                Text {
                    text: "TYRES  FL " + root.d.fl.temp + "  FR " + root.d.fr.temp + "  RL " + root.d.rl.temp + "  RR " + root.d.rr.temp;
                    color: EvoTheme.dim;
                    font-family: Fonts.mono;
                    font-size: 28px;
                    overflow: elide;
                }
            }
        }
    }
}

export component AcEvoDash inherits DashShell {
    waiting-art: Art.tile-acevo;
    waiting-has-art: Art.tile-acevo-custom;
    waiting-emblem: Art.emblem-acevo;
    waiting-card: #0a0a0a;
    background: EvoTheme.black;
    tabs: [
        { label: "DASH", icon: @image-url("../img/icons/gauge.svg") },
        { label: "THE RIG", icon: @image-url("../img/icons/tyre.svg") },
        { label: "PIT BOX", icon: @image-url("../img/icons/stopwatch.svg") }
    ];
    accent: EvoTheme.red;
    dock-bg: #000000;
    dock-idle: #0f0f0f;
    dock-text: #bbbbbb;
    pill-idle: #0a0a0a;
    pill-idle-text: EvoTheme.dim;
    font: Fonts.mono;
    radius: 0px;

    if Art.bg-acevo-custom : Image { y: 0px; width: root.width; height: root.page-height; source: Art.bg-acevo; image-fit: cover; }
    if Sim.layout == 0 : EvoDash { y: 0px; width: root.width; height: root.page-height; }
    if Sim.layout == 1 : EvoRig { y: 0px; width: root.width; height: root.page-height; }
    if Sim.layout >= 2 : EvoPitBox { y: 0px; width: root.width; height: root.page-height; }
}
