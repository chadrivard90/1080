// EA SPORTS WRC - "The Stage Navigator". Gritty, high-contrast, angular: #2C2C2C base with a
// grunge overlay, chopped-corner polygon panels edged in magenta #FF0055, Russo One type.
// Pages: STAGE (progress, gear, handbrake, RPM gauge), SERVICE PARK (vehicle matrix),
// SPLITS (stage times, live RPM trace, stage map).
// WRC's default UDP packet has no turbo, damage, water or oil channels; the gauges and health
// zones show RPM, brake temperatures, suspension and engine load instead.

import { Sim, SimData, Corner } from "../sim/sim_state.slint";
import { DashShell, ShiftLights, Dial } from "../sim/sim_widgets.slint";
import { Fonts, Texture, StatStrip, Stat } from "../kit.slint";
import { AppState } from "../globals.slint";
import { TrackMap } from "../map.slint";
import { Art } from "../art.slint";

global WrcTheme {
    out property <color> base: #2c2c2c;
    out property <color> panel: #1f1f1f;
    out property <color> magenta: #ff0055;
    out property <color> cyan: #00e5ff;
    out property <color> text: #f2f2f2;
    out property <color> dim: #9a9a9a;
    // Fills, see-through per the PANELS setting.
    out property <brush> chop-fill: @linear-gradient(160deg, rgba(38, 38, 38, AppState.panel) 0%, rgba(23, 23, 23, AppState.panel) 100%);
    out property <color> well: rgba(22, 22, 22, AppState.panel);
    out property <color> idle: rgba(26, 26, 26, AppState.panel);
}

// Polygon panel with chopped corners.
component Chop inherits Rectangle {
    in property <brush> fill: WrcTheme.chop-fill;
    in property <color> edge: WrcTheme.magenta;
    in property <float> cut: 46;
    property <float> w: self.width / 1px;
    property <float> h: self.height / 1px;
    min-height: 0px;
    preferred-height: 0px;
    min-width: 0px;
    preferred-width: 100px;
    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: root.w;
        viewbox-height: root.h;
        commands: "M \{root.cut} 2 L \{root.w - 2} 2 L \{root.w - 2} \{root.h - root.cut} L \{root.w - root.cut} \{root.h - 2} L 2 \{root.h - 2} L 2 \{root.cut} Z";
        fill: root.fill;
        stroke: root.edge;
        stroke-width: 4px;
    }
}

// Angular stat strip.
component WrcStrip inherits StatStrip {
    cell-bg: WrcTheme.idle;
    edge: #4a4a4a;
    label-color: WrcTheme.magenta;
    value-color: WrcTheme.text;
    font: Fonts.russo;
    value-size: 32px;
    label-size: 17px;
    radius: 0px;
    gap: 12px;
    italic: true;
}

// Slanted digital readout.
component Slant inherits Chop {
    in property <string> title;
    in property <string> value;
    in property <color> value-color: WrcTheme.text;
    in property <length> size: 72px;
    VerticalLayout {
        padding: 18px;
        padding-left: 40px;
        alignment: center;
        Text { text: root.title; color: WrcTheme.magenta; font-family: Fonts.russo; font-size: 22px; font-italic: true; }
        Text { text: root.value; color: root.value-color; font-family: Fonts.russo; font-size: root.size; font-italic: true; overflow: elide; }
    }
}

component WrcStagePage inherits Rectangle {
    property <SimData> d: Sim.data;
    HorizontalLayout {
        padding: 18px;
        spacing: 18px;
        // Vertical stage progress bar on the left edge.
        VerticalLayout {
            width: 120px;
            spacing: 10px;
            Rectangle {
                vertical-stretch: 1;
                min-height: 0px;
                background: WrcTheme.well;
                border-width: 3px;
                border-color: #4a4a4a;
                clip: true;
                Rectangle {
                    x: 6px;
                    width: parent.width - 12px;
                    height: (parent.height - 12px) * root.d.stage-progress;
                    y: parent.height - 6px - self.height;
                    background: @linear-gradient(0deg, #8a0030 0%, #ff0055 100%);
                    animate height { duration: 300ms; }
                }
                for i in 9 : Rectangle { x: 0px; y: parent.height * (i + 1) / 10; width: parent.width; height: 2px; background: #00000066; }
            }
            Text { text: root.d.stage-pct == "" ? "0%" : root.d.stage-pct; color: WrcTheme.text; font-family: Fonts.russo; font-size: 34px; font-italic: true; horizontal-alignment: center; }
            Text { text: "STAGE"; color: WrcTheme.magenta; font-family: Fonts.russo; font-size: 20px; horizontal-alignment: center; }
        }
        VerticalLayout {
            spacing: 18px;
            // Gear + speed + shift lights
            Chop {
                vertical-stretch: 5;
                VerticalLayout {
                    padding: 26px;
                    padding-top: 26px;
                    spacing: 6px;
                    ShiftLights { vertical-stretch: 1; low: WrcTheme.cyan; mid: #ffffff; high: WrcTheme.magenta; flash: WrcTheme.magenta; off: #333333; radius: 2px; gap: 6px; }
                    HorizontalLayout {
                        vertical-stretch: 5;
                        min-height: 0px;
                        preferred-height: 0px;
                        Text {
                            horizontal-stretch: 1;
                            text: root.d.gear;
                            color: root.d.shift && root.d.blink ? WrcTheme.magenta : WrcTheme.text;
                            font-family: Fonts.russo;
                            font-size: 230px;
                            font-italic: true;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        VerticalLayout {
                            width: 280px;
                            alignment: center;
                            Text { text: "\{root.d.speed}"; color: WrcTheme.text; font-family: Fonts.russo; font-size: 96px; font-italic: true; horizontal-alignment: right; }
                            Text { text: root.d.speed-unit; color: WrcTheme.magenta; font-family: Fonts.russo; font-size: 26px; font-italic: true; horizontal-alignment: right; }
                            Text { text: root.d.stage-time; color: WrcTheme.cyan; font-family: Fonts.russo; font-size: 36px; font-italic: true; horizontal-alignment: right; }
                        }
                    }
                }
            }
            WrcStrip {
                vertical-stretch: 1.1;
                stats: [
                    { label: "DISTANCE", value: root.d.has-stage ? root.d.stage-text : "--", tint: transparent },
                    { label: "POSITION", value: root.d.pos-text, tint: transparent },
                    { label: "LAST STAGE", value: root.d.last-lap, tint: transparent },
                    { label: "ALL-TIME", value: root.d.pb-lap, tint: WrcTheme.cyan }
                ];
            }
            WrcStrip {
                vertical-stretch: 1.1;
                stats: [
                    { label: "FL BRAKE", value: root.d.fl.brake == "" ? "--" : root.d.fl.brake, tint: root.d.fl.brake-color },
                    { label: "FR BRAKE", value: root.d.fr.brake == "" ? "--" : root.d.fr.brake, tint: root.d.fr.brake-color },
                    { label: "RL BRAKE", value: root.d.rl.brake == "" ? "--" : root.d.rl.brake, tint: root.d.rl.brake-color },
                    { label: "RR BRAKE", value: root.d.rr.brake == "" ? "--" : root.d.rr.brake, tint: root.d.rr.brake-color }
                ];
            }
            // Handbrake warning (shakes while pulled)
            hb := Rectangle {
                vertical-stretch: 1.2;
                min-height: 0px;
                preferred-height: 0px;
                property <bool> pulled: root.d.handbrake > 0.2;
                Rectangle {
                    x: hb.pulled ? (root.d.blink ? 8px : -8px) : 0px;
                    y: hb.pulled ? (root.d.blink ? -5px : 5px) : 0px;
                    width: parent.width;
                    height: parent.height;
                    background: hb.pulled ? #e3001b : WrcTheme.idle;
                    border-width: 4px;
                    border-color: hb.pulled ? #ffffff : #e3001b;
                    drop-shadow-blur: hb.pulled ? 40px : 0px;
                    drop-shadow-color: #ff0033;
                    animate x, y { duration: 40ms; }
                    Text {
                        width: parent.width;
                        height: parent.height;
                        text: "( ! )  HANDBRAKE";
                        color: hb.pulled ? #ffffff : #e3001b;
                        font-family: Fonts.russo;
                        font-size: 48px;
                        font-italic: true;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
            // RPM arc gauge
            Chop {
                vertical-stretch: 4.5;
                edge: WrcTheme.cyan;
                Dial {
                    width: parent.width;
                    height: parent.height - 30px;
                    y: 15px;
                    ticks: Sim.tach-ticks;
                    labels: Sim.tach-labels;
                    arc: root.d.rpm-arc;
                    needle: "";
                    show-face: false;
                    show-hub: false;
                    value: "\{root.d.rpm}";
                    unit: "RPM";
                    track-color: #3a3a3a;
                    arc-color: root.d.shift ? WrcTheme.magenta : WrcTheme.cyan;
                    tick-color: #d0d0d0;
                    label-color: #d0d0d0;
                    value-color: WrcTheme.text;
                    unit-color: WrcTheme.magenta;
                    value-size: 52px;
                    arc-width: 18px;
                    font: Fonts.russo;
                }
            }
        }
    }
}

// Coloured zone on the health matrix car (positions are fractions of the car box).
component Zone inherits Rectangle {
    in property <color> zone-color;
    in property <bool> alarm;
    in property <string> label;
    border-radius: 10px;
    background: root.alarm ? (Sim.data.blink ? #ff8a00 : #ff1f1f) : root.zone-color;
    border-width: 3px;
    border-color: #000000;
    opacity: 0.88;
    Text {
        width: parent.width;
        height: parent.height;
        text: root.label;
        color: #000000;
        font-family: Fonts.russo;
        font-size: 20px;
        horizontal-alignment: center;
        vertical-alignment: center;
        wrap: word-wrap;
    }
}

component WrcServicePage inherits Rectangle {
    property <SimData> d: Sim.data;
    VerticalLayout {
        padding: 18px;
        spacing: 18px;
        Chop {
            vertical-stretch: 10;
            Text { x: 60px; y: 18px; text: "SERVICE PARK  ·  VEHICLE MATRIX"; color: WrcTheme.magenta; font-family: Fonts.russo; font-size: 30px; font-italic: true; }
            // Car with zones
            Rectangle {
                property <length> ch: parent.height - 120px;
                width: self.ch * 0.5;
                height: self.ch;
                x: (parent.width - self.width) / 2;
                y: 80px;
                Image { width: parent.width; height: parent.height; source: Art.car-rally; image-fit: contain; }
                Zone {
                    x: parent.width * 0.30; y: parent.height * 0.035; width: parent.width * 0.40; height: parent.height * 0.06;
                    zone-color: #7a7a7a; alarm: false; label: "RAD";
                }
                Zone {
                    x: parent.width * 0.26; y: parent.height * 0.11; width: parent.width * 0.48; height: parent.height * 0.17;
                    zone-color: root.d.rpm-pct > 0.9 ? #ffb000 : #32d16a; alarm: root.d.shift; label: "ENGINE";
                }
                Zone {
                    x: parent.width * 0.0; y: parent.height * 0.15; width: parent.width * 0.2; height: parent.height * 0.18;
                    zone-color: root.d.fl.brake-color; alarm: root.d.fl.brake-pct > 0.88; label: "FL";
                }
                Zone {
                    x: parent.width * 0.8; y: parent.height * 0.15; width: parent.width * 0.2; height: parent.height * 0.18;
                    zone-color: root.d.fr.brake-color; alarm: root.d.fr.brake-pct > 0.88; label: "FR";
                }
                Zone {
                    x: parent.width * 0.0; y: parent.height * 0.69; width: parent.width * 0.2; height: parent.height * 0.18;
                    zone-color: root.d.rl.brake-color; alarm: root.d.rl.brake-pct > 0.88; label: "RL";
                }
                Zone {
                    x: parent.width * 0.8; y: parent.height * 0.69; width: parent.width * 0.2; height: parent.height * 0.18;
                    zone-color: root.d.rr.brake-color; alarm: root.d.rr.brake-pct > 0.88; label: "RR";
                }
                Zone {
                    x: parent.width * 0.30; y: parent.height * 0.40; width: parent.width * 0.40; height: parent.height * 0.20;
                    zone-color: #5a5a5a; alarm: false; label: "SUSP " + (root.d.fl.slip > 1.0 || root.d.fr.slip > 1.0 ? "LOAD" : "OK");
                }
            }
            // Legend
            VerticalLayout {
                x: 30px;
                y: parent.height - 220px;
                width: 260px;
                height: 200px;
                spacing: 6px;
                Text { text: "WHEELS = BRAKE TEMP"; color: WrcTheme.dim; font-family: Fonts.russo; font-size: 18px; }
                Text { text: "ENGINE = LOAD / RPM"; color: WrcTheme.dim; font-family: Fonts.russo; font-size: 18px; }
                Text { text: "RAD = NO DATA SENT"; color: WrcTheme.dim; font-family: Fonts.russo; font-size: 18px; }
                Text { text: "FLASHING = OVERHEAT"; color: WrcTheme.magenta; font-family: Fonts.russo; font-size: 18px; }
            }
        }
        WrcStrip {
            vertical-stretch: 1.2;
            stats: [
                { label: "GEAR", value: root.d.gear, tint: transparent },
                { label: "RPM", value: "\{root.d.rpm}", tint: root.d.shift ? WrcTheme.magenta : transparent },
                { label: "TOP SPEED", value: root.d.max-speed, tint: transparent },
                { label: "STAGE TIME", value: root.d.stage-time, tint: WrcTheme.cyan }
            ];
        }
        HorizontalLayout {
            vertical-stretch: 2.2;
            min-height: 0px;
            preferred-height: 0px;
            spacing: 18px;
            Slant { title: "BRAKES FRONT"; value: root.d.brake-front; size: 64px; }
            Slant { title: "BRAKES REAR"; value: root.d.brake-rear; size: 64px; edge: WrcTheme.cyan; }
        }
    }
}

component WrcSplitsPage inherits Rectangle {
    property <SimData> d: Sim.data;
    VerticalLayout {
        padding: 18px;
        spacing: 18px;
        HorizontalLayout {
            vertical-stretch: 2.2;
            min-height: 0px;
            preferred-height: 0px;
            spacing: 18px;
            Slant { title: "STAGE TIME"; value: root.d.stage-time; size: 64px; value-color: WrcTheme.cyan; }
            Slant { title: "LAST STAGE"; value: root.d.last-lap; size: 56px; }
        }
        WrcStrip {
            vertical-stretch: 1.1;
            stats: [
                { label: "PROGRESS", value: root.d.has-stage ? root.d.stage-pct : "--", tint: transparent },
                { label: "BEST", value: root.d.best-lap, tint: transparent },
                { label: "ALL-TIME", value: root.d.pb-lap, tint: WrcTheme.cyan },
                { label: "LAST VS PB", value: root.d.pb-gap == "" ? "--" : root.d.pb-gap, tint: root.d.pb-gap == "" ? WrcTheme.dim : (root.d.pb-gap-good ? #32d16a : WrcTheme.magenta) }
            ];
        }
        // Live RPM trace
        Chop {
            vertical-stretch: 5;
            edge: WrcTheme.cyan;
            Text { x: 60px; y: 16px; text: "LIVE RPM TRACE  ·  5 S"; color: WrcTheme.cyan; font-family: Fonts.russo; font-size: 26px; font-italic: true; }
            for i in 4 : Rectangle { x: 30px; y: 70px + (parent.height - 110px) * i / 3; width: parent.width - 60px; height: 1px; background: #ffffff1c; }
            Path {
                x: 30px;
                y: 70px;
                width: parent.width - 60px;
                height: parent.height - 110px;
                viewbox-width: 1000;
                viewbox-height: 300;
                commands: root.d.rpm-trace == "" ? "M 0 290" : root.d.rpm-trace;
                stroke: WrcTheme.magenta;
                stroke-width: 5px;
                fill: transparent;
            }
        }
        // Stage map
        Chop {
            vertical-stretch: 7;
            TrackMap {
                width: parent.width;
                height: parent.height;
                path: Sim.map-path;
                dots: Sim.map-dots;
                note: Sim.data.map-note;
                track-color: WrcTheme.cyan;
                track-edge: #000000;
                player-color: WrcTheme.magenta;
                note-color: WrcTheme.dim;
                line-width: 9px;
            }
        }
    }
}

export component WrcDash inherits DashShell {
    background: WrcTheme.base;
    tabs: [
        { label: "STAGE", icon: @image-url("../img/icons/flag.svg") },
        { label: "SERVICE", icon: @image-url("../img/icons/wrench.svg") },
        { label: "SPLITS", icon: @image-url("../img/icons/chart.svg") }
    ];
    accent: WrcTheme.magenta;
    dock-bg: #161616;
    dock-idle: #262626;
    dock-text: #dddddd;
    pill-idle: #202020;
    pill-idle-text: WrcTheme.dim;
    font: Fonts.russo;
    radius: 0px;

    Texture { y: 0px; width: root.width; height: root.page-height; source: Art.bg-wrc; opacity: Art.bg-wrc-custom ? 1.0 : 0.9; }
    if Sim.layout == 0 : WrcStagePage { y: 0px; width: root.width; height: root.page-height; }
    if Sim.layout == 1 : WrcServicePage { y: 0px; width: root.width; height: root.page-height; }
    if Sim.layout >= 2 : WrcSplitsPage { y: 0px; width: root.width; height: root.page-height; }
}
