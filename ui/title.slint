// Title screen: racing hero header, eight equal game buttons with emblems, telemetry target,
// demo toggle and exit. Rows stretch proportionally so it fits any screen height.

import { AppState, GameInfo } from "globals.slint";
import { Fonts, Texture } from "kit.slint";

component GameButton inherits Rectangle {
    in property <GameInfo> game;
    in property <int> index;
    preferred-width: 100px;
    min-width: 0px;
    preferred-height: 0px;
    min-height: 0px;
    border-radius: 22px;
    clip: true;
    background: @linear-gradient(135deg, root.game.accent.darker(0.65) 0%, #0c0c10 65%);
    border-width: 3px;
    border-color: touch.pressed ? #ffffff : root.game.accent;
    drop-shadow-blur: touch.pressed ? 34px : 16px;
    drop-shadow-color: root.game.accent.transparentize(0.55);

    // Accent slash in the corner.
    Path {
        x: parent.width - 170px;
        y: 0px;
        width: 170px;
        height: parent.height;
        viewbox-width: 170;
        viewbox-height: 300;
        commands: "M 110 0 L 170 0 L 170 0 L 60 300 L 0 300 Z";
        fill: root.game.accent.transparentize(0.82);
    }
    VerticalLayout {
        padding: 18px;
        spacing: 10px;
        alignment: center;
        Image {
            height: min(170px, root.height * 0.52);
            source: root.game.emblem;
            image-fit: contain;
        }
        Text {
            text: root.game.name;
            color: #ffffff;
            font-family: Fonts.russo;
            font-size: 40px;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        Text {
            text: root.game.subtitle;
            color: root.game.accent.brighter(0.5);
            font-family: Fonts.titillium;
            font-size: 22px;
            font-weight: 800;
            letter-spacing: 3px;
            horizontal-alignment: center;
            overflow: elide;
        }
    }
    touch := TouchArea {
        clicked => { AppState.select-game(root.index); }
    }
}

component FooterButton inherits Rectangle {
    in property <string> label;
    in property <string> sub;
    in property <color> accent;
    in property <bool> on;
    callback clicked;
    border-radius: 18px;
    background: touch.pressed ? root.accent.darker(0.4) : (root.on ? root.accent : #15151b);
    border-width: 3px;
    border-color: root.accent;
    drop-shadow-blur: root.on ? 24px : 0px;
    drop-shadow-color: root.accent.transparentize(0.5);
    VerticalLayout {
        alignment: center;
        Text { text: root.label; color: #ffffff; font-family: Fonts.russo; font-size: 40px; horizontal-alignment: center; }
        if root.sub != "" : Text { text: root.sub; color: #ffffffbb; font-family: Fonts.titillium; font-size: 20px; font-weight: 800; horizontal-alignment: center; }
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

export component TitleScreen inherits Rectangle {
    background: #07070a;

    property <[GameInfo]> games: [
        { name: "F1 25", subtitle: "FORMULA 1", accent: #e10600, enabled: true, emblem: @image-url("img/emblems/f1.svg") },
        { name: "NASCAR 26", subtitle: "STOCK CAR", accent: #1f5bd8, enabled: true, emblem: @image-url("img/emblems/nascar.svg") },
        { name: "AC EVO", subtitle: "GT / ROAD", accent: #d7263d, enabled: true, emblem: @image-url("img/emblems/acevo.svg") },
        { name: "AUTOMOBILISTA 2", subtitle: "ENDURANCE", accent: #00b140, enabled: true, emblem: @image-url("img/emblems/ams2.svg") },
        { name: "DIRT RALLY 2.0", subtitle: "RALLY", accent: #ff6a00, enabled: true, emblem: @image-url("img/emblems/dr2.svg") },
        { name: "EA SPORTS WRC", subtitle: "RALLY", accent: #00c2c7, enabled: true, emblem: @image-url("img/emblems/wrc.svg") },
        { name: "FORZA MOTORSPORT", subtitle: "CIRCUIT", accent: #2f7bff, enabled: true, emblem: @image-url("img/emblems/fm.svg") },
        { name: "FORZA HORIZON 6", subtitle: "OPEN WORLD", accent: #ff2d87, enabled: true, emblem: @image-url("img/emblems/fh6.svg") }
    ];

    Texture { width: parent.width; height: parent.height; source: @image-url("img/carbon.svg"); opacity: 0.55; }

    VerticalLayout {
        // Hero header
        Rectangle {
            vertical-stretch: 4;
            min-height: 0px;
            preferred-height: 0px;
            clip: true;
            Image { width: parent.width; height: parent.height; source: @image-url("img/hero.svg"); image-fit: cover; }
            VerticalLayout {
                padding-left: 56px;
                alignment: center;
                spacing: 0px;
                Text { text: "RACE"; color: #ffffff; font-family: Fonts.russo; font-size: 150px; font-italic: true; }
                Text { text: "DASH"; color: #e10600; font-family: Fonts.russo; font-size: 150px; font-italic: true; }
                Text { text: "SIM RACING TELEMETRY"; color: #b8b8c8; font-family: Fonts.titillium; font-size: 30px; font-weight: 800; letter-spacing: 8px; }
            }
            Rectangle { x: 0px; y: parent.height - 5px; width: parent.width; height: 5px; background: #e10600; }
        }

        // Game buttons: 2 x 4, all the same size.
        VerticalLayout {
            vertical-stretch: 11;
            min-height: 0px;
            preferred-height: 0px;
            padding: 28px;
            spacing: 24px;
            HorizontalLayout {
                spacing: 24px;
                GameButton { game: root.games[0]; index: 0; }
                GameButton { game: root.games[1]; index: 1; }
            }
            HorizontalLayout {
                spacing: 24px;
                GameButton { game: root.games[2]; index: 2; }
                GameButton { game: root.games[3]; index: 3; }
            }
            HorizontalLayout {
                spacing: 24px;
                GameButton { game: root.games[4]; index: 4; }
                GameButton { game: root.games[5]; index: 5; }
            }
            HorizontalLayout {
                spacing: 24px;
                GameButton { game: root.games[6]; index: 6; }
                GameButton { game: root.games[7]; index: 7; }
            }
        }

        // Footer
        HorizontalLayout {
            height: 190px;
            padding: 28px;
            padding-top: 6px;
            spacing: 20px;
            Rectangle {
                horizontal-stretch: 1;
                min-width: 0px;
                background: #121218;
                border-radius: 18px;
                border-width: 2px;
                border-color: #2a2a34;
                VerticalLayout {
                    padding: 18px;
                    padding-left: 26px;
                    alignment: center;
                    Text { text: "SEND TELEMETRY TO"; color: #8d8da3; font-family: Fonts.titillium; font-size: 22px; font-weight: 800; letter-spacing: 3px; }
                    Text { text: AppState.ip-address; color: #ffffff; font-family: Fonts.russo; font-size: 50px; overflow: elide; }
                    Text { text: "v" + AppState.version; color: #5c5c6c; font-family: Fonts.titillium; font-size: 18px; font-weight: 800; }
                }
            }
            FooterButton {
                width: 200px;
                label: "DEMO";
                sub: AppState.demo-mode ? "ON" : "OFF";
                accent: #2f7bff;
                on: AppState.demo-mode;
                clicked => {
                    AppState.demo-mode = !AppState.demo-mode;
                    AppState.settings-changed();
                }
            }
            FooterButton {
                width: 200px;
                label: "EXIT";
                sub: "";
                accent: #e10600;
                on: false;
                clicked => { AppState.exit-app(); }
            }
        }
    }
}
