// Themeable building blocks for the shared-engine dashes (every game except F1 25).
//
// Sizing rule: page rows use `vertical-stretch` with zero min / preferred height so a page
// always fits the screen whatever its content; text elides instead of resizing panels.

import { Sim, SimData, Corner, SimRow, DialLabel, TrailDot } from "sim_state.slint";
import { AppState } from "../globals.slint";
import { Dock, FlagFrame, PulseFrame, FlagBadge, TabDef, Fonts } from "../kit.slint";
import { Art } from "../art.slint";
import { HBar, VBar } from "../common.slint";

// Caption + big value (+ optional sub line).
export component Tile inherits Rectangle {
    in property <string> title;
    in property <string> value;
    in property <string> sub;
    in property <color> bg: #1b1c20;
    in property <color> title-color: #9a9ca6;
    in property <color> value-color: #ffffff;
    in property <color> sub-color: #c8cad2;
    in property <length> value-size: 64px;
    in property <length> title-size: 22px;
    in property <bool> italic: false;
    in property <string> font: "";
    in property <string> title-font: root.font;
    in property <length> radius: 16px;
    in property <color> edge: transparent;
    in property <color> glow: transparent;
    preferred-width: 100px;
    min-width: 0px;
    preferred-height: 0px;
    min-height: 0px;
    background: root.bg;
    border-radius: root.radius;
    border-width: 2px;
    border-color: root.edge;
    drop-shadow-blur: root.glow == transparent ? 0px : 24px;
    drop-shadow-color: root.glow;
    clip: true;
    VerticalLayout {
        padding: 10px;
        spacing: 0px;
        Text {
            text: root.title;
            color: root.title-color;
            font-size: root.title-size;
            font-weight: 800;
            letter-spacing: 1.5px;
            font-family: root.title-font;
            horizontal-alignment: center;
            overflow: elide;
        }
        Text {
            vertical-stretch: 1;
            text: root.value;
            color: root.value-color;
            font-size: root.value-size;
            font-weight: 900;
            font-italic: root.italic;
            font-family: root.font;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.sub != "" : Text {
            text: root.sub;
            color: root.sub-color;
            font-size: 22px;
            font-weight: 700;
            font-family: root.font;
            horizontal-alignment: center;
            overflow: elide;
        }
    }
}

// 15-LED shift light strip.
export component ShiftLights inherits Rectangle {
    in property <color> low: #22c55e;
    in property <color> mid: #ff2d2d;
    in property <color> high: #2f7bff;
    in property <color> flash: #2f7bff;
    in property <color> off: #18191c;
    in property <length> radius: 10px;
    in property <length> gap: 8px;
    in property <bool> glow: true;
    min-height: 0px;
    preferred-height: 0px;
    HorizontalLayout {
        padding: 6px;
        spacing: root.gap;
        for i in 15 : Rectangle {
            property <color> on: i < 5 ? root.low : (i < 10 ? root.mid : root.high);
            property <bool> lit: Sim.data.shift || i < Sim.data.rev-count;
            preferred-width: 10px;
            border-radius: root.radius;
            background: Sim.data.shift ? (Sim.data.blink ? root.flash : root.off) : (self.lit ? self.on : root.off);
            drop-shadow-blur: root.glow && self.lit ? 16px : 0px;
            drop-shadow-color: Sim.data.shift ? root.flash : self.on;
            animate background { duration: 70ms; easing: ease-out; }
        }
    }
}

// Analog dial: ticks + labels + value arc + needle, from Rust-made SVG paths (0..200 box).
export component Dial inherits Rectangle {
    in property <string> ticks;
    in property <[DialLabel]> labels;
    in property <string> arc;
    in property <string> needle;
    in property <string> value;
    in property <string> unit;
    in property <brush> face: #141518;
    in property <color> rim: #2c2e34;
    in property <color> track-color: #2a2c31;
    in property <color> arc-color: #e10600;
    in property <color> tick-color: #d8d8de;
    in property <color> label-color: #d8d8de;
    in property <color> needle-color: #ff3b30;
    in property <color> value-color: #ffffff;
    in property <color> unit-color: #9a9ca6;
    in property <length> value-size: 64px;
    in property <length> label-size: 24px;
    in property <length> arc-width: 10px;
    in property <string> font: "";
    in property <bool> show-face: true;
    in property <bool> show-hub: true;
    property <length> side: min(self.width, self.height);
    property <length> ox: (self.width - self.side) / 2;
    property <length> oy: (self.height - self.side) / 2;
    min-height: 0px;
    min-width: 0px;
    preferred-height: 0px;

    if root.show-face : Rectangle {
        x: root.ox;
        y: root.oy;
        width: root.side;
        height: root.side;
        border-radius: root.side / 2;
        background: root.face;
        border-width: 6px;
        border-color: root.rim;
        drop-shadow-blur: 30px;
        drop-shadow-color: #000000aa;
    }
    Path {
        x: root.ox;
        y: root.oy;
        width: root.side;
        height: root.side;
        viewbox-width: 200;
        viewbox-height: 200;
        commands: Sim.dial-track;
        stroke: root.track-color;
        stroke-width: root.arc-width;
        fill: transparent;
    }
    if root.arc != "" : Path {
        x: root.ox;
        y: root.oy;
        width: root.side;
        height: root.side;
        viewbox-width: 200;
        viewbox-height: 200;
        commands: root.arc;
        stroke: root.arc-color;
        stroke-width: root.arc-width;
        fill: transparent;
    }
    if root.ticks != "" : Path {
        x: root.ox;
        y: root.oy;
        width: root.side;
        height: root.side;
        viewbox-width: 200;
        viewbox-height: 200;
        commands: root.ticks;
        stroke: root.tick-color;
        stroke-width: 3px;
        fill: transparent;
    }
    for l in root.labels : Text {
        x: root.ox + root.side * l.x / 200 - 40px;
        y: root.oy + root.side * l.y / 200 - 18px;
        width: 80px;
        height: 36px;
        text: l.text;
        color: root.label-color;
        font-size: root.label-size;
        font-weight: 800;
        font-family: root.font;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    Text {
        x: root.ox;
        y: root.oy + root.side * 0.58;
        width: root.side;
        height: root.value-size * 1.3;
        text: root.value;
        color: root.value-color;
        font-size: root.value-size;
        font-weight: 900;
        font-family: root.font;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    Text {
        x: root.ox;
        y: root.oy + root.side * 0.58 + root.value-size * 1.25;
        width: root.side;
        height: 30px;
        text: root.unit;
        color: root.unit-color;
        font-size: 22px;
        font-weight: 800;
        font-family: root.font;
        horizontal-alignment: center;
    }
    if root.needle != "" : Path {
        x: root.ox;
        y: root.oy;
        width: root.side;
        height: root.side;
        viewbox-width: 200;
        viewbox-height: 200;
        commands: root.needle;
        stroke: root.needle-color;
        stroke-width: 8px;
        fill: transparent;
    }
    if root.show-hub : Rectangle {
        x: root.ox + root.side / 2 - 18px;
        y: root.oy + root.side / 2 - 18px;
        width: 36px;
        height: 36px;
        border-radius: 18px;
        background: root.needle-color;
        border-width: 4px;
        border-color: #000000;
    }
}

// Centre-zero delta bar (left = faster).
export component DeltaStrip inherits Rectangle {
    in property <float> delta;
    in property <bool> valid;
    in property <string> text;
    in property <string> title: "DELTA";
    in property <color> bg: #1b1c20;
    in property <color> faster: #22c55e;
    in property <color> slower: #e0282b;
    in property <color> title-color: #9a9ca6;
    in property <length> font-size: 80px;
    in property <string> font: "";
    in property <length> radius: 16px;
    property <float> frac: max(-1.0, min(1.0, root.delta));
    property <float> mag: root.frac < 0 ? -root.frac : root.frac;
    min-height: 0px;
    preferred-height: 0px;
    background: root.bg;
    border-radius: root.radius;
    clip: true;
    if root.valid : Rectangle {
        y: 0px;
        height: parent.height;
        width: parent.width / 2 * root.mag;
        x: root.frac < 0 ? parent.width / 2 - self.width : parent.width / 2;
        background: root.frac < 0 ? root.faster : root.slower;
        animate width { duration: 120ms; }
    }
    Rectangle { x: parent.width / 2 - 2px; y: 0px; width: 4px; height: parent.height; background: #ffffff55; }
    Text { x: 16px; y: 8px; text: root.title; color: root.title-color; font-size: 18px; font-weight: 800; letter-spacing: 1.5px; font-family: root.font; }
    Text {
        width: parent.width;
        height: parent.height;
        text: root.valid ? root.text : "NO REF";
        color: #ffffff;
        font-size: root.font-size;
        font-weight: 900;
        font-family: root.font;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Friction circle with a fading trail.
export component GMeter inherits Rectangle {
    in property <float> lat;
    in property <float> long;
    in property <float> max-g: 3.0;
    in property <color> ring: #3a3c43;
    in property <color> dot: #ff2d87;
    in property <brush> face: #0b0c0e;
    in property <bool> show-trail: true;
    property <length> side: min(self.width, self.height);
    property <length> cx: self.width / 2;
    property <length> cy: self.height / 2;
    property <length> r: self.side / 2;
    min-height: 0px;
    min-width: 0px;
    preferred-height: 0px;
    Rectangle {
        x: root.cx - root.r;
        y: root.cy - root.r;
        width: root.side;
        height: root.side;
        border-radius: root.r;
        background: root.face;
        border-width: 4px;
        border-color: root.ring;
    }
    Rectangle {
        x: root.cx - root.r / 2;
        y: root.cy - root.r / 2;
        width: root.r;
        height: root.r;
        border-radius: root.r / 2;
        border-width: 2px;
        border-color: root.ring;
    }
    Rectangle { x: root.cx - 1px; y: root.cy - root.r; width: 2px; height: root.side; background: root.ring; }
    Rectangle { x: root.cx - root.r; y: root.cy - 1px; width: root.side; height: 2px; background: root.ring; }
    if root.show-trail : Rectangle {
        width: root.width;
        height: root.height;
        for t in Sim.g-trail : Rectangle {
            width: 30px;
            height: 30px;
            border-radius: 15px;
            background: root.dot;
            opacity: max(0.0, t.alpha);
            x: root.cx + root.r * t.x - 15px;
            y: root.cy - root.r * t.y - 15px;
        }
    }
    Rectangle {
        width: 44px;
        height: 44px;
        border-radius: 22px;
        background: root.dot;
        border-width: 3px;
        border-color: #ffffff;
        drop-shadow-blur: 22px;
        drop-shadow-color: root.dot;
        x: root.cx + root.r * max(-1.0, min(1.0, root.lat / root.max-g)) - 22px;
        y: root.cy - root.r * max(-1.0, min(1.0, root.long / root.max-g)) - 22px;
        animate x, y { duration: 60ms; }
    }
}

// Standings / relative / lap-list row.
export component RowItem inherits Rectangle {
    in property <SimRow> item;
    in property <color> bg: #1b1c20;
    in property <color> player-bg: #e1060055;
    in property <color> text-color: #ffffff;
    in property <color> player-text: root.text-color;
    in property <color> dim: #9a9ca6;
    in property <color> pit-color: #ffc400;
    in property <length> font-size: 30px;
    in property <string> font: "";
    in property <bool> italic: false;
    in property <length> radius: 8px;
    min-height: 0px;
    preferred-height: 0px;
    border-radius: root.radius;
    background: root.item.player ? root.player-bg : root.bg;
    clip: true;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 16px;
        spacing: 12px;
        Text {
            width: 70px;
            text: root.item.pos > 0 ? "\{root.item.pos}" : "";
            color: root.item.player ? root.player-text : root.text-color;
            font-size: root.font-size;
            font-weight: 900;
            font-italic: root.italic;
            font-family: root.font;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
        Text {
            horizontal-stretch: 1;
            text: root.item.name;
            color: root.item.player ? root.player-text : root.text-color;
            font-size: root.font-size;
            font-weight: root.item.player ? 900 : 700;
            font-italic: root.italic;
            font-family: root.font;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            width: 64px;
            text: root.item.in-pit ? "PIT" : "";
            color: root.pit-color;
            font-size: 22px;
            font-weight: 900;
            font-family: root.font;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        Text {
            width: 90px;
            text: root.item.detail;
            color: root.dim;
            font-size: root.font-size - 6px;
            font-weight: 700;
            font-family: root.font;
            horizontal-alignment: right;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            width: 190px;
            text: root.item.gap;
            color: root.item.player ? root.player-text : root.text-color;
            font-size: root.font-size;
            font-weight: 900;
            font-family: root.font;
            horizontal-alignment: right;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// Overlay shown until telemetry arrives: a card in the game's own colours with its tile art
// and emblem across the top, then the in-game setup steps.
component SimWaiting inherits Rectangle {
    in property <color> accent;
    in property <color> card: #15161a;
    in property <string> font: "";
    in property <image> art;
    in property <bool> has-art: false;
    in property <image> emblem;
    background: #000000c8;
    Rectangle {
        x: 50px;
        y: (parent.height - self.height) / 2;
        width: parent.width - 100px;
        height: min(1080px, parent.height - 60px);
        background: root.card;
        border-radius: 24px;
        border-width: 4px;
        border-color: root.accent;
        drop-shadow-blur: 40px;
        drop-shadow-color: root.accent.transparentize(0.6);
        clip: true;
        VerticalLayout {
            // Header art
            Rectangle {
                height: 300px;
                clip: true;
                background: @linear-gradient(135deg, root.accent.darker(0.5) 0%, root.card 80%);
                if root.has-art : Image { width: parent.width; height: parent.height; source: root.art; image-fit: cover; }
                Rectangle { width: parent.width; height: parent.height; background: @linear-gradient(180deg, transparent 30%, root.card 100%); }
                HorizontalLayout {
                    x: 30px;
                    y: parent.height - 120px;
                    width: parent.width - 60px;
                    height: 100px;
                    spacing: 20px;
                    Rectangle {
                        width: 100px;
                        border-radius: 50px;
                        clip: true;
                        background: #000000;
                        Image { width: parent.width; height: parent.height; source: root.emblem; image-fit: cover; }
                        Rectangle { width: parent.width; height: parent.height; border-radius: 50px; border-width: 3px; border-color: root.accent; }
                    }
                    VerticalLayout {
                        alignment: center;
                        Text { text: "WAITING FOR"; color: root.accent.brighter(0.4); font-size: 22px; font-weight: 900; letter-spacing: 4px; font-family: root.font; }
                        Text { text: Sim.game-name; color: #ffffff; font-size: 44px; font-weight: 900; font-family: root.font; overflow: elide; }
                    }
                    // Pulsing "listening" dot
                    Rectangle {
                        width: 28px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                height: 28px;
                                border-radius: 14px;
                                background: root.accent.transparentize(0.7 - 0.6 * AppState.pulse);
                            }
                        }
                    }
                }
            }
            VerticalLayout {
                padding: 32px;
                padding-top: 16px;
                spacing: 12px;
                Text {
                    text: Sim.data.status-text;
                    color: #ffd400;
                    font-size: 26px;
                    font-weight: 800;
                    font-family: root.font;
                    wrap: word-wrap;
                }
                Rectangle { height: 2px; background: root.accent.transparentize(0.6); }
                Text { text: "SET UP THE GAME"; color: root.accent.brighter(0.4); font-size: 20px; font-weight: 900; letter-spacing: 3px; font-family: root.font; }
                for line[i] in Sim.setup-lines : HorizontalLayout {
                    spacing: 14px;
                    Rectangle {
                        width: 34px;
                        height: 34px;
                        border-radius: 17px;
                        background: root.accent;
                        Text { width: parent.width; height: parent.height; text: "\{i + 1}"; color: #000000; font-size: 20px; font-weight: 900; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Text {
                        horizontal-stretch: 1;
                        text: line;
                        color: #e0e0e6;
                        font-size: 25px;
                        font-weight: 700;
                        font-family: root.font;
                        wrap: word-wrap;
                    }
                }
                Rectangle { vertical-stretch: 1; }
                Text {
                    text: "PI ADDRESS  " + AppState.ip-address + "      TIP: TURN ON DEMO IN SETTINGS TO PREVIEW";
                    color: #8d8da3;
                    font-size: 20px;
                    font-weight: 800;
                    font-family: root.font;
                    wrap: word-wrap;
                }
            }
        }
    }
}
// Shared frame for every non-F1 dash: dashboard area (children) + flag frame + bottom dock.
// Children are page backgrounds and `if Sim.layout == N : Page { y: 0px; width: root.width; height: root.page-height; }`.
export component DashShell inherits Rectangle {
    in property <[TabDef]> tabs;
    in property <color> accent: #e10600;
    in property <color> dock-bg: #08080b;
    in property <color> dock-idle: #1c1c24;
    in property <color> dock-text: #c8cad2;
    in property <color> dock-active-text: #ffffff;
    in property <color> pill-idle: #15151b;
    in property <color> pill-idle-text: #8d8da3;
    in property <string> font: "";
    in property <length> radius: 16px;
    // Waiting-screen art (the game's title tile and emblem) and card colour.
    in property <image> waiting-art;
    in property <bool> waiting-has-art: false;
    in property <image> waiting-emblem;
    in property <color> waiting-card: #15161a;
    // Optional bottom-bar texture (Art.dock-<game>).
    in property <image> dock-texture;
    in property <bool> dock-textured: false;
    // Flag image for the flag that's out, and the personal-best medal while a purple pop-up shows.
    property <int> fk: Sim.data.flag-kind;
    property <image> flag-img: root.fk == 1 ? Art.flag-yellow : (root.fk == 2 ? Art.flag-blue : (root.fk == 3 ? Art.flag-green : (root.fk == 4 ? Art.flag-white : (root.fk == 5 ? Art.flag-red : (root.fk == 6 ? Art.flag-black : Art.flag-chequered)))));
    property <bool> flag-has: root.fk == 1 ? Art.flag-yellow-custom : (root.fk == 2 ? Art.flag-blue-custom : (root.fk == 3 ? Art.flag-green-custom : (root.fk == 4 ? Art.flag-white-custom : (root.fk == 5 ? Art.flag-red-custom : (root.fk == 6 ? Art.flag-black-custom : (root.fk == 7 ? Art.flag-chequered-custom : false))))));
    property <bool> medal: Sim.data.event-text != "" && Sim.data.event-color == #b545ff && Art.pb-medal-custom;    // Height of the dashboard area above the dock. Children of a DashShell resolve parent to
    // the shell itself, so pages must size with root.page-height, not parent.height.
    out property <length> page-height: content.height;

    VerticalLayout {
        content := Rectangle {
            vertical-stretch: 1;
            min-height: 0px;
            clip: true;
            @children
            FlagFrame {
                width: parent.width;
                height: parent.height;
                active: Sim.data.banner-text != "";
                flag-color: Sim.data.banner-color;
                blink: Sim.data.blink;
            }
            PulseFrame {
                width: parent.width;
                height: parent.height;
                // Only celebrate: purple (records) and green (gains) pop-ups.
                active: Sim.data.banner-text == "" && Sim.data.event-text != "" && (Sim.data.event-color == #b545ff || Sim.data.event-color == #22c55e);
                tint: Sim.data.event-color;
            }
            FlagBadge {
                x: parent.width - self.width - 24px;
                y: 24px;
                source: root.flag-has ? root.flag-img : Art.pb-medal;
                show: root.flag-has || root.medal;
            }
            if !Sim.data.connected : SimWaiting {
                width: parent.width;
                height: parent.height;
                accent: root.accent;
                font: root.font;
                art: root.waiting-art;
                has-art: root.waiting-has-art;
                emblem: root.waiting-emblem;
                card: root.waiting-card;
            }
        }
        Dock {
            height: 100px;
            tabs: root.tabs;
            active: Sim.layout;
            accent: root.accent;
            bg: root.dock-bg;
            idle: root.dock-idle;
            text-color: root.dock-text;
            active-text: root.dock-active-text;
            font: root.font;
            radius: root.radius;
            blink: Sim.data.blink;
            pill-icon: root.flag-has ? root.flag-img : Art.pb-medal;
            pill-has-icon: root.flag-has || root.medal;
            texture: root.dock-texture;
            textured: root.dock-textured;
            pill-alert: Sim.data.banner-text != "" || Sim.data.event-text != "";
            pill-text: Sim.data.banner-text != "" ? Sim.data.banner-text
                : (Sim.data.event-text != "" ? Sim.data.event-text
                : (Sim.data.connected ? Sim.data.pos-text + "   " + Sim.data.lap-text : Sim.game-name));
            pill-color: Sim.data.banner-text != "" ? Sim.data.banner-color
                : (Sim.data.event-text != "" ? Sim.data.event-color : root.pill-idle);
            pill-text-color: Sim.data.banner-text != "" ? Sim.data.banner-text-color
                : (Sim.data.event-text != "" ? Sim.data.event-text-color : root.pill-idle-text);
            select(i) => {
                Sim.layout = i;
                AppState.settings-changed();
            }
        }
    }
}
