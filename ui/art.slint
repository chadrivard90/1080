// Swappable artwork. Every slot defaults to the built-in vector art; at start-up Rust replaces
// any slot that has a matching image in the `art` folder (see art/README.md and
// docs/ai-art-prompts.md). The *-custom flags tell layouts a custom image is in use, so they
// can show it at full strength instead of as a faint texture.

export global Art {
    // Title screen
    in property <image> title-bg: @image-url("img/carbon.svg");
    in property <bool> title-bg-custom: false;
    in property <image> title-hero: @image-url("img/hero.svg");

    // Title button background art (optional; buttons use a gradient without it)
    in property <image> tile-f1;
    in property <bool> tile-f1-custom: false;
    in property <image> tile-nascar;
    in property <bool> tile-nascar-custom: false;
    in property <image> tile-acevo;
    in property <bool> tile-acevo-custom: false;
    in property <image> tile-ams2;
    in property <bool> tile-ams2-custom: false;
    in property <image> tile-dr2;
    in property <bool> tile-dr2-custom: false;
    in property <image> tile-wrc;
    in property <bool> tile-wrc-custom: false;
    in property <image> tile-fm;
    in property <bool> tile-fm-custom: false;
    in property <image> tile-fh6;
    in property <bool> tile-fh6-custom: false;

    // Game emblems (title buttons)
    in property <image> emblem-f1: @image-url("img/emblems/f1.svg");
    in property <image> emblem-nascar: @image-url("img/emblems/nascar.svg");
    in property <image> emblem-acevo: @image-url("img/emblems/acevo.svg");
    in property <image> emblem-ams2: @image-url("img/emblems/ams2.svg");
    in property <image> emblem-dr2: @image-url("img/emblems/dr2.svg");
    in property <image> emblem-wrc: @image-url("img/emblems/wrc.svg");
    in property <image> emblem-fm: @image-url("img/emblems/fm.svg");
    in property <image> emblem-fh6: @image-url("img/emblems/fh6.svg");

    // Dash backgrounds (dashboard area above the dock, 1080 x 1800)
    in property <image> bg-f1: @image-url("img/carbon.svg");
    in property <bool> bg-f1-custom: false;
    in property <image> bg-nascar: @image-url("img/carbon.svg");
    in property <bool> bg-nascar-custom: false;
    in property <image> bg-acevo: @image-url("img/carbon.svg");
    in property <bool> bg-acevo-custom: false;
    in property <image> bg-ams2: @image-url("img/blueprint.svg");
    in property <bool> bg-ams2-custom: false;
    in property <image> bg-dr2: @image-url("img/grunge.svg");
    in property <bool> bg-dr2-custom: false;
    in property <image> bg-wrc: @image-url("img/grunge.svg");
    in property <bool> bg-wrc-custom: false;
    in property <image> bg-fm: @image-url("img/carbon.svg");
    in property <bool> bg-fm-custom: false;
    in property <image> bg-fh6: @image-url("img/festival.svg");
    in property <bool> bg-fh6-custom: false;

    // Instruments and vehicles
    in property <image> dr2-tach-face: @image-url("img/tach_face.svg");
    in property <image> dr2-needle: @image-url("img/needle.svg");
    in property <image> dr2-gauge-face: @image-url("img/tach_face.svg");
    in property <bool> dr2-gauge-face-custom: false;
    in property <image> car-gt: @image-url("img/car_gt.svg");
    in property <image> car-drift: @image-url("img/car_drift.svg");
    in property <image> car-rally: @image-url("img/car_rally.svg");
    // Extra top-down cars (optional): F1 tyre layout and NASCAR spotter radar.
    in property <image> car-f1;
    in property <bool> car-f1-custom: false;
    in property <image> car-stock;
    in property <bool> car-stock-custom: false;

    // Panel textures (optional): a subtle material drawn inside each theme's panels.
    in property <image> panel-f1;
    in property <bool> panel-f1-custom: false;
    in property <image> panel-nascar;
    in property <bool> panel-nascar-custom: false;
    in property <image> panel-acevo;
    in property <bool> panel-acevo-custom: false;
    in property <image> panel-ams2;
    in property <bool> panel-ams2-custom: false;
    in property <image> panel-dr2;
    in property <bool> panel-dr2-custom: false;
    in property <image> panel-wrc;
    in property <bool> panel-wrc-custom: false;
    in property <image> panel-fm;
    in property <bool> panel-fm-custom: false;
    in property <image> panel-fh6;
    in property <bool> panel-fh6-custom: false;

    // AMS2 weather icons (optional; shown on the weather desk when present)
    in property <image> weather-clear;
    in property <bool> weather-clear-custom: false;
    in property <image> weather-cloud;
    in property <bool> weather-cloud-custom: false;
    in property <image> weather-rain;
    in property <bool> weather-rain-custom: false;
    in property <image> weather-storm;
    in property <bool> weather-storm-custom: false;
    in property <image> weather-snow;
    in property <bool> weather-snow-custom: false;

    // Wishlist slots (all optional; each is used only when its image exists):
    // flags (corner banner + bottom-bar icon), F1 tyre compounds, personal-best medal,
    // bottom-bar textures, logo mark (title + splash), WRC / FM gauge faces, AMS2 wet icons.
    in property <image> flag-yellow;
    in property <bool> flag-yellow-custom: false;
    in property <image> flag-blue;
    in property <bool> flag-blue-custom: false;
    in property <image> flag-green;
    in property <bool> flag-green-custom: false;
    in property <image> flag-white;
    in property <bool> flag-white-custom: false;
    in property <image> flag-red;
    in property <bool> flag-red-custom: false;
    in property <image> flag-black;
    in property <bool> flag-black-custom: false;
    in property <image> flag-chequered;
    in property <bool> flag-chequered-custom: false;
    in property <image> tyre-soft;
    in property <bool> tyre-soft-custom: false;
    in property <image> tyre-medium;
    in property <bool> tyre-medium-custom: false;
    in property <image> tyre-hard;
    in property <bool> tyre-hard-custom: false;
    in property <image> tyre-inter;
    in property <bool> tyre-inter-custom: false;
    in property <image> tyre-wet;
    in property <bool> tyre-wet-custom: false;
    in property <image> pb-medal;
    in property <bool> pb-medal-custom: false;
    in property <image> dock-f1;
    in property <bool> dock-f1-custom: false;
    in property <image> dock-nascar;
    in property <bool> dock-nascar-custom: false;
    in property <image> dock-acevo;
    in property <bool> dock-acevo-custom: false;
    in property <image> dock-ams2;
    in property <bool> dock-ams2-custom: false;
    in property <image> dock-dr2;
    in property <bool> dock-dr2-custom: false;
    in property <image> dock-wrc;
    in property <bool> dock-wrc-custom: false;
    in property <image> dock-fm;
    in property <bool> dock-fm-custom: false;
    in property <image> dock-fh6;
    in property <bool> dock-fh6-custom: false;
    in property <image> logo;
    in property <bool> logo-custom: false;
    in property <image> wrc-gauge-face;
    in property <bool> wrc-gauge-face-custom: false;
    in property <image> fm-gauge-face;
    in property <bool> fm-gauge-face-custom: false;
    in property <image> weather-puddle;
    in property <bool> weather-puddle-custom: false;
    in property <image> weather-wetline;
    in property <bool> weather-wetline-custom: false;
}
