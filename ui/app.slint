// Root window. page 0 = title screen, page N = dash for title tile N-1.

// Fonts (downloaded by scripts/fetch-fonts.sh before building).
import "../fonts/TitilliumWeb-Bold.ttf";
import "../fonts/TitilliumWeb-Black.ttf";
import "../fonts/ShareTechMono-Regular.ttf";
import "../fonts/RussoOne-Regular.ttf";
import "../fonts/Anton-Regular.ttf";
import "../fonts/BebasNeue-Regular.ttf";
import "../fonts/PermanentMarker-Regular.ttf";

import { TitleScreen } from "title.slint";
import { SettingsScreen } from "settings.slint";
import { F1Dash } from "f1/f1_dash.slint";
import { NascarDash } from "games/nascar.slint";
import { AcEvoDash } from "games/acevo.slint";
import { Ams2Dash } from "games/ams2.slint";
import { Dr2Dash } from "games/dr2.slint";
import { WrcDash } from "games/wrc.slint";
import { FmDash } from "games/fm.slint";
import { Fh6Dash } from "games/fh6.slint";

export { AppState, GameInfo, BestRow } from "globals.slint";
export { MapDot } from "map.slint";
export { Art } from "art.slint";
export { F1, F1Data, Tyre, Part, SectorInfo, StandingRow, LapRow, ForecastRow } from "f1/f1_state.slint";
export { Sim, SimData, Corner, SimRow, CompassMark, DialLabel, TrailDot, DynoBar } from "sim/sim_state.slint";

export component AppWindow inherits Window {
    in-out property <int> page: 0;

    title: "Race Dash";
    background: #000000;
    preferred-width: 1080px;
    preferred-height: 1920px;
    default-font-family: "Titillium Web";

    if root.page == 0 : TitleScreen { width: root.width; height: root.height; }
    if root.page == 1 : F1Dash { width: root.width; height: root.height; }
    if root.page == 2 : NascarDash { width: root.width; height: root.height; }
    if root.page == 3 : AcEvoDash { width: root.width; height: root.height; }
    if root.page == 4 : Ams2Dash { width: root.width; height: root.height; }
    if root.page == 5 : Dr2Dash { width: root.width; height: root.height; }
    if root.page == 6 : WrcDash { width: root.width; height: root.height; }
    if root.page == 7 : FmDash { width: root.width; height: root.height; }
    if root.page == 8 : Fh6Dash { width: root.width; height: root.height; }
    if root.page == 9 : SettingsScreen { width: root.width; height: root.height; }
}
