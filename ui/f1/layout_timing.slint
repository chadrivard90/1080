// TIMING layout — qualifying / hot-lap focus.
// The whole top block turns green or red with the live delta, so you can feel the lap
// going well or badly from the corner of your eye.

import { F1, F1Theme, F1Data } from "f1_state.slint";
import { Panel, ValuePanel, DeltaBar, SectorBox } from "f1_widgets.slint";
import { Caption } from "../common.slint";

export component TimingLayout inherits Rectangle {
    property <F1Data> d: F1.data;

    VerticalLayout {
        padding: 16px;
        spacing: 14px;

        // Delta hero
        Rectangle {
            height: 430px;
            border-radius: 22px;
            clip: true;
            background: !root.d.has-delta ? F1Theme.panel : (root.d.delta <= 0 ? #0b4a2a : #5a0f10);
            VerticalLayout {
                padding: 20px;
                alignment: center;
                Caption { text: "DELTA TO BEST LAP"; horizontal-alignment: center; color: #ffffffaa; }
                Text {
                    text: root.d.delta-text;
                    color: !root.d.has-delta ? F1Theme.dim : (root.d.delta <= 0 ? #3dff9a : #ff5a5a);
                    font-size: 240px;
                    font-weight: 900;
                    horizontal-alignment: center;
                }
            }
        }

        DeltaBar {
            height: 80px;
            delta: root.d.delta;
            valid: root.d.has-delta;
            text: "";
            range: 0.5;
        }

        // Current lap
        Rectangle {
            height: 220px;
            background: F1Theme.panel;
            border-radius: 20px;
            border-width: root.d.lap-invalid ? 6px : 0px;
            border-color: F1Theme.red;
            VerticalLayout {
                padding: 16px;
                alignment: center;
                HorizontalLayout {
                    Caption { text: "CURRENT LAP"; }
                    if root.d.lap-invalid : Text {
                        horizontal-stretch: 1;
                        text: "LAP INVALID";
                        color: F1Theme.red;
                        font-size: 28px;
                        font-weight: 900;
                        horizontal-alignment: right;
                    }
                }
                Text {
                    text: root.d.current-lap;
                    color: root.d.lap-invalid ? #ff5a5a : #ffffff;
                    font-size: 140px;
                    font-weight: 900;
                    horizontal-alignment: center;
                }
            }
        }

        // Sectors
        HorizontalLayout {
            height: 180px;
            spacing: 14px;
            SectorBox { label: "S1"; s: root.d.s1; current: root.d.sector == 0; }
            SectorBox { label: "S2"; s: root.d.s2; current: root.d.sector == 1; }
            SectorBox { label: "S3"; s: root.d.s3; current: root.d.sector == 2; }
        }

        // Lap references
        HorizontalLayout {
            height: 190px;
            spacing: 14px;
            ValuePanel { title: "LAST"; value: root.d.last-lap; value-size: 56px; }
            ValuePanel { title: "PERSONAL BEST"; value: root.d.best-lap; value-size: 56px; value-color: F1Theme.green; }
            ValuePanel { title: "IDEAL"; value: root.d.ideal-lap; value-size: 56px; value-color: #d0d0dc; }
        }

        // Context
        HorizontalLayout {
            vertical-stretch: 1;
            spacing: 14px;
            ValuePanel {
                title: "SESSION BEST";
                value: root.d.session-best;
                value-size: 48px;
                value-color: F1Theme.purple;
            }
            ValuePanel { title: "GEAR"; value: root.d.gear; value-size: 120px; }
            ValuePanel { title: root.d.speed-unit; value: "\{root.d.speed}"; value-size: 84px; }
            ValuePanel {
                title: root.d.is-race ? "POSITION" : "TIME LEFT";
                value: root.d.is-race ? "P\{root.d.position}" : root.d.time-left;
                value-size: 60px;
                sub: "TYRE " + root.d.tyre-compound + " · \{root.d.tyre-age} LAPS";
            }
        }
    }
}
