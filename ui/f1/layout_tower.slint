// TOWER layout - broadcast-style timing tower for the whole field.
// Race: interval to car ahead + gap to leader. Practice/quali: best lap + gap to P1.

import { F1, F1Theme, F1Data, StandingRow } from "f1_state.slint";
import { Caption } from "../common.slint";

component TowerRow inherits Rectangle {
    in property <StandingRow> entry;
    border-radius: 10px;
    background: root.entry.player ? #e1060055 : F1Theme.panel;
    border-width: root.entry.player ? 3px : 0px;
    border-color: F1Theme.red;
    opacity: root.entry.retired ? 0.45 : 1.0;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 14px;
        spacing: 12px;
        Text {
            width: 64px;
            text: "\{root.entry.pos}";
            color: #ffffff;
            font-size: 34px;
            font-weight: 900;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
        Rectangle {
            width: 10px;
            background: root.entry.team-color;
            border-radius: 3px;
        }
        Text {
            horizontal-stretch: 1;
            text: root.entry.name;
            color: #ffffff;
            font-size: 32px;
            font-weight: root.entry.player ? 900 : 700;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.entry.fastest : VerticalLayout {
            alignment: center;
            Rectangle {
                width: 30px;
                height: 30px;
                border-radius: 6px;
                background: F1Theme.purple;
            }
        }
        Text {
            width: 90px;
            text: root.entry.status;
            color: root.entry.status == "PIT" ? F1Theme.yellow : F1Theme.red;
            font-size: 26px;
            font-weight: 900;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        Text {
            width: 160px;
            text: root.entry.interval;
            color: #ffffff;
            font-size: 30px;
            font-weight: 800;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
        Text {
            width: 160px;
            text: root.entry.gap;
            color: #b8b8c8;
            font-size: 30px;
            font-weight: 700;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
        Rectangle {
            width: 44px;
            Rectangle {
                x: 0px;
                y: (parent.height - 44px) / 2;
                width: 44px;
                height: 44px;
                border-radius: 22px;
                border-width: 5px;
                border-color: root.entry.tyre-color;
                background: #000000;
                Text {
                    width: parent.width;
                    height: parent.height;
                    text: root.entry.tyre;
                    color: #ffffff;
                    font-size: 20px;
                    font-weight: 900;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
        Text {
            width: 44px;
            text: "\{root.entry.tyre-age}";
            color: #b8b8c8;
            font-size: 26px;
            font-weight: 800;
            vertical-alignment: center;
        }
        Text {
            width: 40px;
            text: root.entry.pits > 0 ? "\{root.entry.pits}" : "";
            color: F1Theme.dim;
            font-size: 26px;
            font-weight: 800;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
}

export component TowerLayout inherits Rectangle {
    property <F1Data> d: F1.data;

    VerticalLayout {
        padding: 12px;
        spacing: 4px;

        HorizontalLayout {
            height: 84px;
            padding-left: 8px;
            padding-right: 8px;
            spacing: 16px;
            Rectangle {
                width: 220px;
                border-radius: 10px;
                background: F1Theme.red;
                Text {
                    width: parent.width;
                    height: parent.height;
                    text: root.d.session-name;
                    color: #ffffff;
                    font-size: 34px;
                    font-weight: 900;
                    font-italic: true;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            Text {
                horizontal-stretch: 1;
                text: root.d.track-name;
                color: #ffffff;
                font-size: 34px;
                font-weight: 800;
                vertical-alignment: center;
            }
            Text {
                text: root.d.lap-text;
                color: #ffffff;
                font-size: 40px;
                font-weight: 900;
                vertical-alignment: center;
            }
        }

        HorizontalLayout {
            height: 40px;
            padding-left: 8px;
            padding-right: 14px;
            spacing: 12px;
            Caption { width: 64px; text: "POS"; horizontal-alignment: right; vertical-alignment: center; }
            Rectangle { width: 10px; }
            Caption { horizontal-stretch: 1; text: "DRIVER"; vertical-alignment: center; }
            Caption { width: 90px; text: ""; }
            Caption { width: 160px; text: root.d.is-race ? "INTERVAL" : "BEST"; horizontal-alignment: right; vertical-alignment: center; }
            Caption { width: 160px; text: root.d.is-race ? "LEADER" : "GAP"; horizontal-alignment: right; vertical-alignment: center; }
            Caption { width: 44px; text: "TYR"; vertical-alignment: center; }
            Caption { width: 44px; text: "AGE"; vertical-alignment: center; }
            Caption { width: 40px; text: "PIT"; horizontal-alignment: right; vertical-alignment: center; }
        }

        for standing in F1.standings : TowerRow {
            height: 60px;
            entry: standing;
        }

        Rectangle { vertical-stretch: 1; }
    }
}
