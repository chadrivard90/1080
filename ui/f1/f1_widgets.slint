// Building blocks for the F1 25 layouts.

import { F1Theme, Tyre, Part, SectorInfo } from "f1_state.slint";
import { Caption, HBar } from "../common.slint";

// Rounded panel with an optional caption; children are stacked vertically.
export component Panel inherits Rectangle {
    in property <string> title;
    in property <length> pad: 16px;
    background: F1Theme.panel;
    border-radius: 18px;
    VerticalLayout {
        padding: root.pad;
        spacing: 4px;
        if root.title != "" : Caption { text: root.title; }
        @children
    }
}

// Caption over a big centred value.
export component ValuePanel inherits Rectangle {
    in property <string> title;
    in property <string> value;
    in property <string> sub;
    in property <color> value-color: #ffffff;
    in property <length> value-size: 80px;
    background: F1Theme.panel;
    border-radius: 18px;
    VerticalLayout {
        padding: 14px;
        spacing: 2px;
        Caption { text: root.title; horizontal-alignment: center; }
        Text {
            vertical-stretch: 1;
            text: root.value;
            color: root.value-color;
            font-size: root.value-size;
            font-weight: 900;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        if root.sub != "" : Caption { text: root.sub; horizontal-alignment: center; color: #b8b8c8; }
    }
}

// Centre-zero delta bar: green fill left when faster, red fill right when slower.
export component DeltaBar inherits Rectangle {
    in property <float> delta;
    in property <bool> valid;
    in property <string> text;
    in property <string> title;
    in property <float> range: 1.0;
    in property <length> font-size: 96px;
    property <float> frac: max(-1.0, min(1.0, root.delta / root.range));
    property <float> mag: root.frac < 0 ? -root.frac : root.frac;

    background: F1Theme.panel;
    border-radius: 18px;
    clip: true;

    if root.valid : Rectangle {
        y: 0px;
        height: parent.height;
        width: parent.width / 2 * root.mag;
        x: root.frac < 0 ? parent.width / 2 - self.width : parent.width / 2;
        background: root.frac < 0 ? #00b85c : #e0282b;
    }
    Rectangle {
        x: parent.width / 2 - 2px;
        y: 0px;
        width: 4px;
        height: parent.height;
        background: #ffffff55;
    }
    if root.title != "" : Caption {
        x: 18px;
        y: 10px;
        text: root.title;
    }
    if root.text != "" : Text {
        width: parent.width;
        height: parent.height;
        text: root.valid ? root.text : "--.---";
        color: #ffffff;
        font-size: root.font-size;
        font-weight: 900;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Gap to the car ahead / behind.
export component GapPanel inherits Rectangle {
    in property <string> title;
    in property <string> name;
    in property <string> value;
    in property <color> value-color: #ffffff;
    in property <color> accent: F1Theme.line;
    background: F1Theme.panel;
    border-radius: 18px;
    border-width: 4px;
    border-color: root.accent;
    VerticalLayout {
        padding: 16px;
        spacing: 2px;
        HorizontalLayout {
            Caption { text: root.title; }
            Text {
                horizontal-stretch: 1;
                text: root.name;
                color: #d0d0dc;
                font-size: 26px;
                font-weight: 800;
                horizontal-alignment: right;
                overflow: elide;
            }
        }
        Text {
            vertical-stretch: 1;
            text: root.value;
            color: root.value-color;
            font-size: 104px;
            font-weight: 900;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// Compact tyre tile: colour = carcass temperature, shows temp + wear.
export component MiniTyre inherits Rectangle {
    in property <Tyre> t;
    border-radius: 12px;
    background: root.t.inner-color.darker(0.25);
    VerticalLayout {
        alignment: center;
        Text {
            text: "\{root.t.inner}°";
            color: #000000;
            font-size: 40px;
            font-weight: 900;
            horizontal-alignment: center;
        }
        Text {
            text: "\{root.t.wear}%";
            color: #000000cc;
            font-size: 24px;
            font-weight: 800;
            horizontal-alignment: center;
        }
    }
}

// Detailed tyre card for the CAR layout.
export component TyreCard inherits Rectangle {
    in property <Tyre> t;
    in property <string> label;
    in property <string> temp-unit;
    background: F1Theme.panel;
    border-radius: 22px;
    border-width: 5px;
    border-color: root.t.inner-color;
    VerticalLayout {
        padding: 16px;
        spacing: 8px;
        HorizontalLayout {
            Caption { text: root.label; color: #ffffff; font-size: 30px; }
            Text {
                horizontal-stretch: 1;
                text: "\{root.t.wear}% WEAR";
                color: root.t.wear < 40 ? #d0d0dc : (root.t.wear < 65 ? F1Theme.yellow : F1Theme.red);
                font-size: 26px;
                font-weight: 800;
                horizontal-alignment: right;
            }
        }
        Rectangle {
            vertical-stretch: 1;
            border-radius: 14px;
            background: root.t.inner-color;
            VerticalLayout {
                alignment: center;
                Text {
                    text: "\{root.t.inner}°";
                    color: #000000;
                    font-size: 100px;
                    font-weight: 900;
                    horizontal-alignment: center;
                }
                Text {
                    text: "CARCASS";
                    color: #000000aa;
                    font-size: 22px;
                    font-weight: 800;
                    horizontal-alignment: center;
                }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            height: 70px;
            Rectangle {
                border-radius: 10px;
                background: F1Theme.panel-hi;
                VerticalLayout {
                    alignment: center;
                    Caption { text: "SURFACE"; font-size: 18px; horizontal-alignment: center; }
                    Text {
                        text: "\{root.t.surface}°";
                        color: root.t.surface-color;
                        font-size: 32px;
                        font-weight: 900;
                        horizontal-alignment: center;
                    }
                }
            }
            Rectangle {
                border-radius: 10px;
                background: F1Theme.panel-hi;
                VerticalLayout {
                    alignment: center;
                    Caption { text: "PSI"; font-size: 18px; horizontal-alignment: center; }
                    Text {
                        text: root.t.pressure;
                        color: #ffffff;
                        font-size: 32px;
                        font-weight: 900;
                        horizontal-alignment: center;
                    }
                }
            }
        }
        Rectangle {
            height: 56px;
            border-radius: 10px;
            background: F1Theme.panel-hi;
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                Caption { text: "BRAKE"; font-size: 20px; vertical-alignment: center; }
                Text {
                    horizontal-stretch: 1;
                    text: "\{root.t.brake}°";
                    color: root.t.brake-color;
                    font-size: 32px;
                    font-weight: 900;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }
        }
        HBar {
            height: 14px;
            value: 1.0 - root.t.wear * 0.01;
            fill: root.t.wear < 40 ? F1Theme.green : (root.t.wear < 65 ? F1Theme.yellow : F1Theme.red);
        }
    }
}

// Sector time box (S1/S2/S3) coloured purple / green / yellow.
export component SectorBox inherits Rectangle {
    in property <string> label;
    in property <SectorInfo> s;
    in property <bool> current;
    in property <length> font-size: 54px;
    border-radius: 16px;
    background: root.s.color;
    border-width: root.current ? 4px : 0px;
    border-color: #ffffff;
    VerticalLayout {
        padding: 10px;
        alignment: center;
        Text {
            text: root.label;
            color: root.s.text-color;
            font-size: 24px;
            font-weight: 900;
            horizontal-alignment: center;
        }
        Text {
            text: root.s.time;
            color: root.s.text-color;
            font-size: root.font-size;
            font-weight: 900;
            horizontal-alignment: center;
        }
    }
}

// A labelled car part coloured by damage.
export component PartBlock inherits Rectangle {
    in property <string> label;
    in property <Part> p;
    in property <length> font-size: 30px;
    border-radius: 12px;
    background: root.p.color;
    VerticalLayout {
        alignment: center;
        Text {
            text: root.label;
            color: #000000bb;
            font-size: 18px;
            font-weight: 900;
            horizontal-alignment: center;
        }
        Text {
            text: "\{root.p.pct}%";
            color: #000000;
            font-size: root.font-size;
            font-weight: 900;
            horizontal-alignment: center;
        }
    }
}

// Label + percentage + bar for component wear.
export component WearRow inherits Rectangle {
    in property <string> label;
    in property <Part> p;
    HorizontalLayout {
        spacing: 12px;
        Text {
            width: 120px;
            text: root.label;
            color: #d0d0dc;
            font-size: 26px;
            font-weight: 800;
            vertical-alignment: center;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            HBar {
                height: 20px;
                value: root.p.pct * 0.01;
                fill: root.p.color;
            }
        }
        Text {
            width: 80px;
            text: "\{root.p.pct}%";
            color: #ffffff;
            font-size: 26px;
            font-weight: 900;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
}
