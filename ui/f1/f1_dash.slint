// F1 25 - "The Halo MFD". Official-broadcast-meets-steering-wheel look: #15151E base, carbon
// fibre, recessed MFD panels, neon teal / green / red / purple accents, Titillium Web.
// Pages: THE WHEEL (drive), THE ENGINEER (temps, damage & setup), THE STRATEGIST (map, fuel,
// session, relative).
// Sized for a 16" screen about 50-60 cm from the driver: hero numbers stay large, secondary
// data sits in compact stat strips.

import { F1, F1Data, Tyre, StandingRow, SectorInfo, Part } from "f1_state.slint";
import { AppState } from "../globals.slint";
import { Dock, FlagFrame, PulseFrame, FlagBadge, FadePage, Fonts, Texture, StatStrip, Stat, LapChart } from "../kit.slint";
import { TrackMap } from "../map.slint";
import { Art } from "../art.slint";

global FT {
    out property <color> base: #15151e;
    out property <color> panel: #0c0c12;
    out property <color> edge: #2a2a36;
    out property <color> teal: #00d2be;
    out property <color> red: #e10600;
    out property <color> green: #2bff88;
    out property <color> purple: #c04bff;
    out property <color> yellow: #ffd400;
    out property <color> text: #ffffff;
    out property <color> dim: #8d8da3;
    out property <color> bad: #ff5a5a;
    // Panel fills, see-through per the PANELS setting so the background art shows.
    out property <color> mfd-a: rgba(7, 7, 11, AppState.panel);
    out property <color> mfd-b: rgba(16, 16, 26, AppState.panel);
    out property <color> cell: rgba(11, 11, 18, AppState.panel);
    out property <color> ok-bg: rgba(6, 52, 31, AppState.panel);
    out property <color> bad-bg: rgba(61, 10, 10, AppState.panel);
    out property <color> shadow: rgba(0, 0, 0, AppState.shade);
}

// Recessed MFD screen.
component MfdPanel inherits Rectangle {
    in property <string> title;
    in property <color> glow: transparent;
    min-height: 0px;
    preferred-height: 0px;
    min-width: 0px;
    preferred-width: 100px;
    border-radius: 16px;
    background: @linear-gradient(180deg, FT.mfd-a 0%, FT.mfd-b 100%);
    border-width: 2px;
    border-color: root.glow == transparent ? FT.edge : root.glow;
    drop-shadow-blur: 18px;
    drop-shadow-color: root.glow == transparent ? FT.shadow : root.glow.transparentize(1 - 0.5 * AppState.shade);
    clip: true;
    if Art.panel-f1-custom : Image { width: parent.width; height: parent.height; source: Art.panel-f1; image-fit: cover; opacity: 0.25; }
    if root.title != "" : Text {
        x: 16px;
        y: 8px;
        text: root.title;
        color: FT.dim;
        font-family: Fonts.titillium;
        font-size: 18px;
        font-weight: 900;
        letter-spacing: 3px;
    }
}

// Tyre compound sidewall image (soft / medium / hard / inter / wet), when that art exists.
component CompoundIcon inherits Image {
    in property <string> letter;
    out property <bool> has: root.letter == "S" || root.letter == "SS" ? Art.tyre-soft-custom
        : (root.letter == "M" ? Art.tyre-medium-custom
        : (root.letter == "H" ? Art.tyre-hard-custom
        : (root.letter == "I" ? Art.tyre-inter-custom
        : (root.letter == "W" ? Art.tyre-wet-custom : false))));
    source: root.letter == "S" || root.letter == "SS" ? Art.tyre-soft
        : (root.letter == "M" ? Art.tyre-medium
        : (root.letter == "H" ? Art.tyre-hard
        : (root.letter == "I" ? Art.tyre-inter : Art.tyre-wet)));
    image-fit: contain;
    visible: self.has;
}

// F1-styled stat strip.
component F1Strip inherits StatStrip {
    texture: Art.panel-f1;
    textured: Art.panel-f1-custom;
    cell-bg: FT.cell;
    edge: FT.edge;
    label-color: FT.dim;
    font: Fonts.titillium;
    value-size: 34px;
    label-size: 17px;
    radius: 12px;
}

// Sector time box: purple / green / yellow once done, grey (last lap) while upcoming.
component SectorBox inherits Rectangle {
    in property <SectorInfo> s;
    in property <string> label;
    preferred-width: 100px;
    min-width: 0px;
    border-radius: 12px;
    background: root.s.color.transparentize(AppState.fade * 0.4);
    border-width: 1px;
    border-color: FT.edge;
    // Purple (overall best) sectors glow.
    drop-shadow-blur: root.s.color == #c04bff ? 26px : 0px;
    drop-shadow-color: #c04bff;
    VerticalLayout {
        alignment: center;
        padding: 4px;
        Text { text: root.label; color: root.s.text-color; font-family: Fonts.titillium; font-size: 17px; font-weight: 900; horizontal-alignment: center; }
        Text { text: root.s.time; color: root.s.text-color; font-family: Fonts.titillium; font-size: root.s.time == "NO TIME" ? 22px : 36px; font-weight: 900; horizontal-alignment: center; overflow: elide; }
    }
}

// ------------------------------------------------------------------ Page 1: THE WHEEL
component WheelPage inherits FadePage {
    property <F1Data> d: F1.data;
    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        // RPM sweep + gear
        Rectangle {
            vertical-stretch: 6;
            min-height: 0px;
            preferred-height: 0px;
            property <length> w: min(self.width, self.height * 1000 / 640);
            property <length> h: self.w * 0.6;
            property <length> ox: (self.width - self.w) / 2;
            Path {
                x: parent.ox;
                y: 0px;
                width: parent.w;
                height: parent.h;
                viewbox-width: 1000;
                viewbox-height: 600;
                commands: root.d.rpm-track;
                stroke: #1d1d28;
                stroke-width: 56px;
                fill: transparent;
            }
            if root.d.rpm-arc != "" : Path {
                x: parent.ox;
                y: 0px;
                width: parent.w;
                height: parent.h;
                viewbox-width: 1000;
                viewbox-height: 600;
                commands: root.d.rpm-arc;
                stroke: root.d.rpm-color.transparentize(0.7);
                stroke-width: 90px;
                fill: transparent;
            }
            if root.d.rpm-arc != "" : Path {
                x: parent.ox;
                y: 0px;
                width: parent.w;
                height: parent.h;
                viewbox-width: 1000;
                viewbox-height: 600;
                commands: root.d.rpm-arc;
                stroke: root.d.rpm-color;
                stroke-width: 44px;
                fill: transparent;
            }
            Text {
                x: parent.ox;
                y: parent.h * 0.18;
                width: parent.w;
                height: parent.h * 0.7;
                text: root.d.gear;
                color: root.d.rev-max && root.d.blink ? #2f7bff : FT.text;
                font-family: Fonts.titillium;
                font-size: min(280px, parent.h * 0.62);
                font-weight: 900;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            // Suggested gear (when the game's hint differs).
            if root.d.shift-hint : Text {
                x: parent.ox + parent.w * 0.68;
                y: parent.h * 0.3;
                width: 120px;
                text: "> " + root.d.suggested-gear;
                color: FT.yellow;
                font-family: Fonts.titillium;
                font-size: 44px;
                font-weight: 900;
            }
            // Position / speed / lap along the bottom.
            HorizontalLayout {
                y: parent.height - 104px;
                height: 104px;
                width: parent.width;
                padding-left: 14px;
                padding-right: 14px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    preferred-width: 10px;
                    alignment: end;
                    Text { text: "POSITION"; color: FT.dim; font-family: Fonts.titillium; font-size: 18px; font-weight: 900; letter-spacing: 2px; }
                    Text { text: "P\{root.d.position}/\{root.d.num-cars}"; color: FT.text; font-family: Fonts.titillium; font-size: 56px; font-weight: 900; }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    preferred-width: 10px;
                    alignment: end;
                    Text { text: "\{root.d.speed}"; color: FT.text; font-family: Fonts.titillium; font-size: 64px; font-weight: 900; horizontal-alignment: center; }
                    Text { text: root.d.speed-unit; color: FT.dim; font-family: Fonts.titillium; font-size: 18px; font-weight: 900; horizontal-alignment: center; }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    preferred-width: 10px;
                    alignment: end;
                    Text { text: root.d.is-race ? "LAP" : "TIME LEFT"; color: FT.dim; font-family: Fonts.titillium; font-size: 18px; font-weight: 900; letter-spacing: 2px; horizontal-alignment: right; }
                    Text { text: root.d.is-race ? "\{root.d.lap}/\{root.d.total-laps}" : root.d.time-left; color: FT.text; font-family: Fonts.titillium; font-size: 56px; font-weight: 900; horizontal-alignment: right; }
                }
            }
        }

        // Sectors
        HorizontalLayout {
            vertical-stretch: 1.1;
            min-height: 0px;
            preferred-height: 0px;
            spacing: 10px;
            SectorBox { s: root.d.s1; label: "SECTOR 1"; }
            SectorBox { s: root.d.s2; label: "SECTOR 2"; }
            SectorBox { s: root.d.s3; label: "SECTOR 3"; }
        }

        // Lap times
        F1Strip {
            vertical-stretch: 1.1;
            stats: [
                { label: root.d.lap-invalid ? "CURRENT · INVALID" : "CURRENT", value: root.d.current-lap, tint: root.d.lap-invalid ? FT.bad : transparent },
                { label: "LAST", value: root.d.last-lap, tint: transparent },
                { label: "SESSION BEST", value: root.d.best-lap, tint: FT.green },
                { label: "ALL-TIME BEST", value: root.d.pb-lap, tint: FT.purple },
                { label: "LAST VS BEST", value: root.d.pb-gap == "" ? "--" : root.d.pb-gap, tint: root.d.pb-gap == "" ? FT.dim : (root.d.pb-gap-good ? FT.green : FT.bad) }
            ];
        }

        // Hybrid deployment
        MfdPanel {
            vertical-stretch: 3.4;
            title: "HYBRID DEPLOYMENT";
            glow: FT.teal;
            VerticalLayout {
                padding: 14px;
                padding-top: 36px;
                spacing: 10px;
                // ERS battery bar
                Rectangle {
                    vertical-stretch: 1;
                    min-height: 0px;
                    preferred-height: 0px;
                    border-radius: 12px;
                    background: FT.mfd-a;
                    border-width: 3px;
                    border-color: FT.teal;
                    clip: true;
                    Rectangle {
                        x: 6px;
                        y: 6px;
                        height: parent.height - 12px;
                        width: (parent.width - 12px) * root.d.ers-pct;
                        border-radius: 8px;
                        background: @linear-gradient(90deg, #008f82 0%, #00d2be 70%, #7ffff0 100%);
                        animate width { duration: 150ms; easing: ease-out; }
                    }
                    Text {
                        width: parent.width;
                        height: parent.height;
                        text: "ERS  " + root.d.ers-text;
                        color: #ffffff;
                        font-family: Fonts.titillium;
                        font-size: 44px;
                        font-weight: 900;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                HorizontalLayout {
                    vertical-stretch: 1.3;
                    min-height: 0px;
                    preferred-height: 0px;
                    spacing: 12px;
                    Rectangle {
                        width: 230px;
                        border-radius: 12px;
                        background: root.d.ers-mode-color;
                        VerticalLayout {
                            alignment: center;
                            Text { text: "DEPLOY MODE"; color: #000000aa; font-family: Fonts.titillium; font-size: 17px; font-weight: 900; horizontal-alignment: center; }
                            Text { text: root.d.ers-mode; color: #000000; font-family: Fonts.titillium; font-size: 36px; font-weight: 900; horizontal-alignment: center; overflow: elide; }
                        }
                    }
                    // Delta to best
                    Rectangle {
                        horizontal-stretch: 1;
                        min-width: 0px;
                        border-radius: 12px;
                        background: !root.d.has-delta ? FT.cell : (root.d.delta <= 0 ? FT.ok-bg : FT.bad-bg);
                        border-width: 3px;
                        border-color: !root.d.has-delta ? FT.edge : (root.d.delta <= 0 ? FT.green : #ff3b3b);
                        VerticalLayout {
                            alignment: center;
                            Text { text: "DELTA TO SESSION BEST"; color: FT.dim; font-family: Fonts.titillium; font-size: 17px; font-weight: 900; horizontal-alignment: center; }
                            Text {
                                text: root.d.delta-text;
                                color: !root.d.has-delta ? FT.dim : (root.d.delta <= 0 ? FT.green : FT.bad);
                                font-family: Fonts.titillium;
                                font-size: 56px;
                                font-weight: 900;
                                horizontal-alignment: center;
                            }
                        }
                    }
                    // Harvest / deploy this lap
                    VerticalLayout {
                        width: 200px;
                        spacing: 6px;
                        alignment: center;
                        Text { text: "DEPLOYED"; color: FT.dim; font-family: Fonts.titillium; font-size: 16px; font-weight: 900; }
                        Rectangle {
                            height: 14px;
                            border-radius: 7px;
                            background: #ffffff1a;
                            Rectangle { x: 0px; width: parent.width * root.d.ers-deployed-pct; height: parent.height; border-radius: 7px; background: FT.yellow; }
                        }
                        Text { text: "HARVESTED"; color: FT.dim; font-family: Fonts.titillium; font-size: 16px; font-weight: 900; }
                        Rectangle {
                            height: 14px;
                            border-radius: 7px;
                            background: #ffffff1a;
                            Rectangle { x: 0px; width: parent.width * root.d.ers-harvested-pct; height: parent.height; border-radius: 7px; background: FT.green; }
                        }
                    }
                }
            }
        }

        // Cars around you, tyres, fuel
        F1Strip {
            vertical-stretch: 1.1;
            stats: [
                { label: root.d.ahead-name == "" ? "AHEAD" : "AHEAD · " + root.d.ahead-name, value: root.d.gap-ahead, tint: transparent },
                { label: root.d.behind-name == "" ? "BEHIND" : "BEHIND · " + root.d.behind-name, value: root.d.gap-behind, tint: transparent },
                { label: "TO LEADER", value: root.d.gap-leader, tint: transparent },
                { label: "TYRE · AGE · WEAR", value: root.d.tyre-compound + " · \{root.d.tyre-age}L · \{root.d.tyre-wear-avg}%", tint: root.d.tyre-color },
                { label: "FUEL LAPS", value: root.d.fuel-laps, tint: root.d.fuel-ok ? FT.green : FT.bad }
            ];
        }

        // DRS
        drs := Rectangle {
            vertical-stretch: 1.6;
            min-height: 0px;
            preferred-height: 0px;
            property <bool> armed: root.d.drs-allowed && !root.d.drs-open;
            property <bool> lit: root.d.drs-open || (self.armed && root.d.blink);
            border-radius: 20px;
            background: self.lit ? FT.teal : FT.cell;
            border-width: 5px;
            border-color: root.d.drs-open || root.d.drs-allowed ? FT.teal : FT.edge;
            drop-shadow-blur: self.lit ? 40px : 0px;
            drop-shadow-color: FT.teal;
            animate background { duration: 90ms; }
            HorizontalLayout {
                padding-left: 30px;
                padding-right: 30px;
                spacing: 30px;
                Text {
                    text: "DRS";
                    color: drs.lit ? #000000 : (root.d.drs-allowed ? FT.teal : #3a3a48);
                    font-family: Fonts.titillium;
                    font-size: 110px;
                    font-weight: 900;
                    font-italic: true;
                    vertical-alignment: center;
                }
                Text {
                    horizontal-stretch: 1;
                    text: root.d.drs-fault ? "FAULT" : (root.d.drs-open ? "OPEN" : (root.d.drs-allowed ? "ACTIVATE" : (root.d.drs-distance > 0 ? "ZONE IN \{root.d.drs-distance} M" : "CLOSED")));
                    color: drs.lit ? #000000 : (root.d.drs-fault ? FT.red : (root.d.drs-allowed ? FT.teal : #5a5a68));
                    font-family: Fonts.titillium;
                    font-size: 40px;
                    font-weight: 900;
                    letter-spacing: 6px;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
    }
}

// ------------------------------------------------------------------ Page 2: THE ENGINEER
component TireTemp inherits Rectangle {
    in property <Tyre> t;
    in property <string> label;
    in property <string> compound;
    min-height: 0px;
    preferred-height: 0px;
    min-width: 0px;
    preferred-width: 100px;
    // Dark glass card: the surface temperature colours the ring, the core colours the number.
    border-radius: 28px;
    border-width: 5px;
    border-color: root.t.surface-color;
    background: @linear-gradient(180deg, FT.mfd-a 0%, FT.mfd-b 100%);
    drop-shadow-blur: 22px;
    drop-shadow-color: root.t.surface-color.transparentize(1 - 0.4 * AppState.shade);
    clip: true;
    // Soft wash of the core colour behind the number.
    Rectangle {
        x: parent.width * 0.15;
        y: parent.height * 0.22;
        width: parent.width * 0.7;
        height: parent.height * 0.45;
        border-radius: self.height / 2;
        background: @radial-gradient(circle, root.t.inner-color.transparentize(0.72) 0%, transparent 70%);
    }
    CompoundIcon { x: parent.width - 66px; y: 12px; width: 54px; height: 54px; letter: root.compound; }
    VerticalLayout {
        padding: 14px;
        spacing: 0px;
        alignment: center;
        Text { text: root.label; color: FT.dim; font-family: Fonts.titillium; font-size: 19px; font-weight: 900; letter-spacing: 2px; horizontal-alignment: center; }
        Text { text: "\{root.t.inner}°"; color: root.t.inner-color.brighter(0.25); font-family: Fonts.titillium; font-size: 68px; font-weight: 900; horizontal-alignment: center; }
        Text { text: "CORE   ·   SURFACE \{root.t.surface}°"; color: root.t.surface-color.brighter(0.3); font-family: Fonts.titillium; font-size: 21px; font-weight: 900; horizontal-alignment: center; overflow: elide; }
        // Wear bar
        HorizontalLayout {
            padding-top: 8px;
            padding-left: 30px;
            padding-right: 30px;
            Rectangle {
                height: 8px;
                border-radius: 4px;
                background: #ffffff1f;
                Rectangle {
                    x: 0px;
                    height: parent.height;
                    width: parent.width * max(0.0, min(1.0, 1.0 - root.t.wear / 100));
                    border-radius: 4px;
                    background: root.t.wear > 60 ? FT.red : (root.t.wear > 35 ? FT.yellow : FT.teal);
                }
            }
        }
        Text { text: root.t.pressure + " PSI   \{root.t.wear}% WEAR"; color: #ffffffcc; font-family: Fonts.titillium; font-size: 20px; font-weight: 800; horizontal-alignment: center; overflow: elide; }
        // 30-second core temperature trend
        Rectangle {
            height: 34px;
            if root.t.trend != "" : Path {
                x: parent.width * 0.15;
                width: parent.width * 0.7;
                height: parent.height;
                viewbox-width: 300;
                viewbox-height: 60;
                commands: root.t.trend;
                stroke: root.t.inner-color;
                stroke-width: 3px;
                fill: transparent;
            }
        }
        Text {
            text: root.t.damage > 0 || root.t.blister > 0 ? "DAMAGE \{root.t.damage}%   BLISTER \{root.t.blister}%" : "";
            color: FT.yellow;
            font-family: Fonts.titillium;
            font-size: 18px;
            font-weight: 800;
            horizontal-alignment: center;
            overflow: elide;
        }
    }
}
component BrakeBar inherits Rectangle {
    in property <Tyre> t;
    in property <string> label;
    preferred-width: 100px;
    min-width: 0px;
    VerticalLayout {
        spacing: 6px;
        Text { text: "\{root.t.brake}°"; color: root.t.brake-color; font-family: Fonts.titillium; font-size: 30px; font-weight: 900; horizontal-alignment: center; }
        Rectangle {
            vertical-stretch: 1;
            min-height: 0px;
            border-radius: 12px;
            background: FT.mfd-a;
            border-width: 2px;
            border-color: FT.edge;
            clip: true;
            Rectangle {
                x: 6px;
                width: parent.width - 12px;
                height: (parent.height - 12px) * root.t.brake-pct;
                y: parent.height - 6px - self.height;
                border-radius: 8px;
                background: @linear-gradient(0deg, root.t.brake-color.darker(0.4) 0%, root.t.brake-color 100%);
                animate height { duration: 150ms; easing: ease-out; }
            }
        }
        Text { text: root.label; color: FT.dim; font-family: Fonts.titillium; font-size: 20px; font-weight: 900; horizontal-alignment: center; }
    }
}

// Damage / wear cell: label over percent, coloured by severity.
component PartCell inherits Rectangle {
    in property <string> label;
    in property <Part> p;
    preferred-width: 100px;
    min-width: 0px;
    border-radius: 10px;
    background: root.p.color.transparentize(0.75);
    border-width: 2px;
    border-color: root.p.color;
    VerticalLayout {
        alignment: center;
        Text { text: root.label; color: FT.dim; font-family: Fonts.titillium; font-size: 16px; font-weight: 900; horizontal-alignment: center; overflow: elide; }
        Text { text: "\{root.p.pct}%"; color: #ffffff; font-family: Fonts.titillium; font-size: 30px; font-weight: 900; horizontal-alignment: center; }
    }
}

component EngineerPage inherits FadePage {
    property <F1Data> d: F1.data;
    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        // Tyres 2x2
        VerticalLayout {
            vertical-stretch: 7;
            min-height: 0px;
            preferred-height: 0px;
            spacing: 12px;
            HorizontalLayout {
                vertical-stretch: 1;
                spacing: 12px;
                VerticalLayout {
                    spacing: 12px;
                    TireTemp { t: root.d.fl; label: "FRONT LEFT"; compound: root.d.tyre-compound; }
                    TireTemp { t: root.d.rl; label: "REAR LEFT"; compound: root.d.tyre-compound; }
                }
                // Top-down car between the tyres (only with the car-f1 art).
                if Art.car-f1-custom : Image { width: 150px; source: Art.car-f1; image-fit: contain; }
                VerticalLayout {
                    spacing: 12px;
                    TireTemp { t: root.d.fr; label: "FRONT RIGHT"; compound: root.d.tyre-compound; }
                    TireTemp { t: root.d.rr; label: "REAR RIGHT"; compound: root.d.tyre-compound; }
                }
            }
        }
        if root.d.tyre-note != "" : Text {
            height: 30px;
            text: root.d.tyre-note;
            color: FT.yellow;
            font-family: Fonts.titillium;
            font-size: 22px;
            font-weight: 900;
            horizontal-alignment: center;
            overflow: elide;
        }
        // Brake temperatures
        MfdPanel {
            vertical-stretch: 3.4;
            title: "BRAKE TEMPERATURES";
            HorizontalLayout {
                padding: 14px;
                padding-top: 34px;
                spacing: 20px;
                BrakeBar { t: root.d.fl; label: "FL"; }
                BrakeBar { t: root.d.fr; label: "FR"; }
                BrakeBar { t: root.d.rl; label: "RL"; }
                BrakeBar { t: root.d.rr; label: "RR"; }
            }
        }
        // Damage + power unit wear
        MfdPanel {
            vertical-stretch: 3.4;
            title: root.d.engine-failed ? "DAMAGE  ·  ENGINE FAILED" : (root.d.drs-fault || root.d.ers-fault ? "DAMAGE  ·  " + (root.d.drs-fault ? "DRS FAULT " : "") + (root.d.ers-fault ? "ERS FAULT" : "") : "DAMAGE  ·  POWER UNIT WEAR");
            VerticalLayout {
                padding: 12px;
                padding-top: 34px;
                spacing: 8px;
                HorizontalLayout {
                    spacing: 8px;
                    PartCell { label: "FL WING"; p: root.d.wing-fl; }
                    PartCell { label: "FR WING"; p: root.d.wing-fr; }
                    PartCell { label: "REAR WING"; p: root.d.wing-rear; }
                    PartCell { label: "FLOOR"; p: root.d.floor-dmg; }
                    PartCell { label: "DIFFUSER"; p: root.d.diffuser; }
                    PartCell { label: "SIDEPOD"; p: root.d.sidepod; }
                }
                HorizontalLayout {
                    spacing: 8px;
                    PartCell { label: "GEARBOX"; p: root.d.gearbox; }
                    PartCell { label: "ICE"; p: root.d.wear-ice; }
                    PartCell { label: "MGU-H"; p: root.d.wear-mguh; }
                    PartCell { label: "MGU-K"; p: root.d.wear-mguk; }
                    PartCell { label: "ES"; p: root.d.wear-es; }
                    PartCell { label: "CE"; p: root.d.wear-ce; }
                }
            }
        }
        // Setup
        F1Strip {
            vertical-stretch: 1.3;
            value-size: 32px;
            stats: [
                { label: "BRAKE BIAS", value: "\{root.d.brake-bias}%", tint: FT.teal },
                { label: "DIFF", value: "\{root.d.diff}%", tint: transparent },
                { label: "ENG BRAKING", value: "\{root.d.engine-braking}%", tint: transparent },
                { label: "TC", value: root.d.tc, tint: transparent },
                { label: "ABS", value: root.d.abs-on ? "ON" : "OFF", tint: transparent },
                { label: "ENGINE", value: root.d.engine-temp, tint: FT.yellow },
                { label: "MIX", value: root.d.fuel-mix, tint: transparent }
            ];
        }
    }
}

// ------------------------------------------------------------------ Page 3: THE STRATEGIST
component DriverRow inherits Rectangle {
    in property <StandingRow> entry;
    min-height: 0px;
    preferred-height: 0px;
    border-radius: 12px;
    background: root.entry.player ? @linear-gradient(90deg, #e10600aa 0%, #e1060022 100%) : FT.cell;
    border-width: 2px;
    border-color: root.entry.player ? FT.red : FT.edge;
    clip: true;
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 16px;
        spacing: 14px;
        Text { width: 70px; text: "P\{root.entry.pos}"; color: #ffffff; font-family: Fonts.titillium; font-size: 34px; font-weight: 900; vertical-alignment: center; }
        Rectangle { width: 10px; border-radius: 4px; background: root.entry.team-color; }
        Text { horizontal-stretch: 1; text: root.entry.name; color: #ffffff; font-family: Fonts.titillium; font-size: 32px; font-weight: root.entry.player ? 900 : 700; vertical-alignment: center; overflow: elide; }
        Text { width: 80px; text: root.entry.status; color: FT.yellow; font-family: Fonts.titillium; font-size: 20px; font-weight: 900; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
        // Tyre: compound art if present, otherwise a coloured ring with the letter.
        Rectangle {
            width: 44px;
            Rectangle {
                y: (parent.height - 44px) / 2;
                width: 44px;
                height: 44px;
                ci := CompoundIcon { width: parent.width; height: parent.height; letter: root.entry.tyre; }
                if !ci.has : Rectangle {
                    width: parent.width;
                    height: parent.height;
                    border-radius: 22px;
                    border-width: 5px;
                    border-color: root.entry.tyre-color;
                    background: #000000;
                    Text { width: parent.width; height: parent.height; text: root.entry.tyre; color: #ffffff; font-family: Fonts.titillium; font-size: 19px; font-weight: 900; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
        }
        Text { width: 60px; text: "\{root.entry.tyre-age}L"; color: FT.dim; font-family: Fonts.titillium; font-size: 22px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
        Text { width: 170px; text: root.entry.player ? "YOU" : root.entry.interval; color: root.entry.player ? FT.red.brighter(0.6) : #ffffff; font-family: Fonts.titillium; font-size: 34px; font-weight: 900; horizontal-alignment: right; vertical-alignment: center; overflow: elide; }
    }
}

component StrategistPage inherits FadePage {
    property <F1Data> d: F1.data;
    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        MfdPanel {
            vertical-stretch: 5.4;
            title: "TRACK MAP  ·  " + root.d.track-name;
            TrackMap {
                width: parent.width;
                height: parent.height;
                path: F1.map-path;
                dots: F1.map-dots;
                note: F1.map-note;
                track-color: #f2f2f6;
                track-edge: #000000;
                player-color: FT.red;
                use-dot-colors: true;
                label-color: #000000;
                line-width: 14px;
                dot-size: 34px;
            }
        }
        // Fuel delta
        Rectangle {
            vertical-stretch: 1.6;
            min-height: 0px;
            preferred-height: 0px;
            border-radius: 16px;
            background: root.d.fuel-ok ? @linear-gradient(90deg, FT.ok-bg 0%, FT.cell 100%) : @linear-gradient(90deg, FT.bad-bg 0%, FT.cell 100%);
            border-width: 3px;
            border-color: root.d.fuel-ok ? FT.green : #ff3b3b;
            HorizontalLayout {
                padding-left: 24px;
                padding-right: 24px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    Text { text: "FUEL DELTA  ·  " + root.d.fuel-target; color: FT.dim; font-family: Fonts.titillium; font-size: 20px; font-weight: 900; letter-spacing: 2px; }
                    Text { text: root.d.fuel-kg + "   " + root.d.fuel-mix; color: #ffffffcc; font-family: Fonts.titillium; font-size: 26px; font-weight: 800; }
                }
                Text {
                    text: root.d.fuel-laps + " LAPS";
                    color: root.d.fuel-ok ? FT.green : #ff4a4a;
                    font-family: Fonts.titillium;
                    font-size: 72px;
                    font-weight: 900;
                    vertical-alignment: center;
                }
            }
        }
        // Session conditions
        F1Strip {
            vertical-stretch: 1.1;
            stats: [
                { label: "WEATHER", value: root.d.weather, tint: root.d.weather-color },
                { label: "TRACK", value: root.d.track-temp, tint: transparent },
                { label: "AIR", value: root.d.air-temp, tint: transparent },
                { label: "RAIN NEXT", value: "\{root.d.rain-next}%", tint: root.d.rain-next > 40 ? #4fc3f7 : transparent },
                { label: "PIT WINDOW", value: root.d.pit-window, tint: FT.yellow },
                { label: "REJOIN", value: root.d.pit-rejoin > 0 ? "P\{root.d.pit-rejoin}" : "--", tint: transparent }
            ];
        }
        // Race admin
        F1Strip {
            vertical-stretch: 1.1;
            stats: [
                { label: root.d.is-race ? "LAP" : "TIME LEFT", value: root.d.is-race ? "\{root.d.lap}/\{root.d.total-laps}" : root.d.time-left, tint: transparent },
                { label: "STOPS", value: "\{root.d.pit-stops}", tint: transparent },
                { label: "PENALTY", value: "\{root.d.penalties}s", tint: root.d.penalties > 0 ? FT.bad : transparent },
                { label: "WARNINGS", value: "\{root.d.warnings} · \{root.d.cc-warnings} CC", tint: root.d.warnings > 0 ? FT.yellow : transparent },
                { label: "SPEED TRAP", value: root.d.speed-trap, tint: transparent },
                { label: "IDEAL LAP", value: root.d.ideal-lap, tint: FT.purple }
            ];
        }
        MfdPanel {
            vertical-stretch: 2.2;
            LapChart {
                width: parent.width;
                height: parent.height;
                path: root.d.lap-chart;
                count: root.d.lap-chart-count;
                best: root.d.lap-chart-best;
                worst: root.d.lap-chart-worst;
                line-color: FT.teal;
                best-color: FT.green;
                text-color: FT.dim;
                font: Fonts.titillium;
            }
        }
        if root.d.unserved != "" : Rectangle {
            height: 44px;
            border-radius: 10px;
            background: FT.red;
            Text { width: parent.width; height: parent.height; text: "UNSERVED  " + root.d.unserved; color: #ffffff; font-family: Fonts.titillium; font-size: 26px; font-weight: 900; horizontal-alignment: center; vertical-alignment: center; }
        }
        // Relative leaderboard
        VerticalLayout {
            vertical-stretch: 5;
            min-height: 0px;
            preferred-height: 0px;
            spacing: 8px;
            for r in F1.relative : DriverRow { vertical-stretch: 1; entry: r; }
        }
    }
}

// ------------------------------------------------------------------ waiting overlay
component F1Waiting inherits Rectangle {
    background: #000000c8;
    Rectangle {
        x: 50px;
        y: (parent.height - self.height) / 2;
        width: parent.width - 100px;
        height: min(1080px, parent.height - 60px);
        background: #0c0c12;
        border-radius: 24px;
        border-width: 4px;
        border-color: FT.red;
        drop-shadow-blur: 40px;
        drop-shadow-color: #e1060066;
        clip: true;
        VerticalLayout {
            // Header art
            Rectangle {
                height: 300px;
                clip: true;
                background: @linear-gradient(135deg, #5a0300 0%, #0c0c12 80%);
                if Art.tile-f1-custom : Image { width: parent.width; height: parent.height; source: Art.tile-f1; image-fit: cover; }
                Rectangle { width: parent.width; height: parent.height; background: @linear-gradient(180deg, transparent 30%, #0c0c12 100%); }
                HorizontalLayout {
                    x: 30px;
                    y: parent.height - 120px;
                    width: parent.width - 60px;
                    height: 100px;
                    spacing: 20px;
                    Rectangle {
                        width: 100px;
                        border-radius: 50px;
                        clip: true;
                        background: #000000;
                        Image { width: parent.width; height: parent.height; source: Art.emblem-f1; image-fit: cover; }
                        Rectangle { width: parent.width; height: parent.height; border-radius: 50px; border-width: 3px; border-color: FT.red; }
                    }
                    VerticalLayout {
                        alignment: center;
                        Text { text: "WAITING FOR"; color: #ff6b6b; font-family: Fonts.titillium; font-size: 22px; font-weight: 900; letter-spacing: 4px; }
                        Text { text: "F1 25"; color: #ffffff; font-family: Fonts.titillium; font-size: 48px; font-weight: 900; font-italic: true; }
                    }
                    Rectangle {
                        width: 28px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle { height: 28px; border-radius: 14px; background: FT.red.transparentize(0.7 - 0.6 * AppState.pulse); }
                        }
                    }
                }
            }
            VerticalLayout {
                padding: 32px;
                padding-top: 16px;
                spacing: 12px;
                Text { text: F1.data.status-text; color: FT.yellow; font-family: Fonts.titillium; font-size: 26px; font-weight: 800; wrap: word-wrap; }
                Rectangle { height: 2px; background: #e1060066; }
                Text { text: "IN GAME: SETTINGS > TELEMETRY SETTINGS"; color: #ff6b6b; font-family: Fonts.titillium; font-size: 20px; font-weight: 900; letter-spacing: 3px; }
                for line[i] in [
                    "UDP Telemetry:  On",
                    "UDP Broadcast Mode:  Off",
                    "UDP IP Address:  " + AppState.ip-address,
                    "UDP Port:  \{AppState.f1-port}",
                    "UDP Send Rate:  60Hz",
                    "UDP Format:  2025"
                ] : HorizontalLayout {
                    spacing: 14px;
                    Rectangle {
                        width: 34px;
                        height: 34px;
                        border-radius: 17px;
                        background: FT.red;
                        Text { width: parent.width; height: parent.height; text: "\{i + 1}"; color: #ffffff; font-family: Fonts.titillium; font-size: 20px; font-weight: 900; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Text { horizontal-stretch: 1; text: line; color: #e0e0e6; font-family: Fonts.titillium; font-size: 28px; font-weight: 800; vertical-alignment: center; }
                }
                Rectangle { vertical-stretch: 1; }
                Text { text: "TIP: TURN ON DEMO IN SETTINGS TO PREVIEW THE DASH"; color: FT.dim; font-family: Fonts.titillium; font-size: 20px; font-weight: 800; }
            }
        }
    }
}
export component F1Dash inherits Rectangle {
    background: FT.base;
    property <int> fk: F1.data.flag-kind;
    property <image> flag-img: root.fk == 1 ? Art.flag-yellow : (root.fk == 2 ? Art.flag-blue : Art.flag-red);
    property <bool> flag-has: root.fk == 1 ? Art.flag-yellow-custom : (root.fk == 2 ? Art.flag-blue-custom : (root.fk == 5 ? Art.flag-red-custom : false));
    property <bool> medal: F1.data.event-text != "" && F1.data.event-color == #b545ff && Art.pb-medal-custom;

    VerticalLayout {
        Rectangle {
            vertical-stretch: 1;
            min-height: 0px;
            clip: true;
            Texture { width: parent.width; height: parent.height; source: Art.bg-f1; opacity: Art.bg-f1-custom ? 1.0 : 0.3; }
            if F1.layout == 0 : WheelPage { width: parent.width; height: parent.height; }
            if F1.layout == 1 : EngineerPage { width: parent.width; height: parent.height; }
            if F1.layout >= 2 : StrategistPage { width: parent.width; height: parent.height; }
            FlagFrame {
                width: parent.width;
                height: parent.height;
                active: F1.data.banner-text != "";
                flag-color: F1.data.banner-color;
                blink: F1.data.blink;
            }
            PulseFrame {
                width: parent.width;
                height: parent.height;
                // Only celebrate: purple (records) and green (gains) pop-ups.
                active: F1.data.banner-text == "" && F1.data.event-text != "" && (F1.data.event-color == #b545ff || F1.data.event-color == #00d26a);
                tint: F1.data.event-color;
            }
            FlagBadge {
                x: parent.width - self.width - 24px;
                y: 24px;
                source: root.flag-has ? root.flag-img : Art.pb-medal;
                show: root.flag-has || root.medal;
            }
            if !F1.data.connected : F1Waiting { width: parent.width; height: parent.height; }
        }
        Dock {
            height: 100px;
            tabs: [
                { label: "WHEEL", icon: @image-url("../img/icons/wheel.svg") },
                { label: "ENGINEER", icon: @image-url("../img/icons/wrench.svg") },
                { label: "STRATEGY", icon: @image-url("../img/icons/map.svg") }
            ];
            active: F1.layout;
            accent: FT.red;
            bg: #08080c;
            idle: #191922;
            font: Fonts.titillium;
            blink: F1.data.blink;
            pill-icon: root.flag-has ? root.flag-img : Art.pb-medal;
            pill-has-icon: root.flag-has || root.medal;
            texture: Art.dock-f1;
            textured: Art.dock-f1-custom;
            pill-alert: F1.data.banner-text != "" || F1.data.event-text != "";
            pill-text: F1.data.banner-text != "" ? F1.data.banner-text
                : (F1.data.event-text != "" ? F1.data.event-text
                : (F1.data.connected ? "P\{F1.data.position}/\{F1.data.num-cars}   " + F1.data.lap-text : "F1 25"));
            pill-color: F1.data.banner-text != "" ? F1.data.banner-color
                : (F1.data.event-text != "" ? F1.data.event-color : #15151b);
            pill-text-color: F1.data.banner-text != "" ? F1.data.banner-text-color
                : (F1.data.event-text != "" ? F1.data.event-text-color : FT.dim);
            select(i) => {
                F1.layout = i;
                AppState.settings-changed();
            }
        }
    }
}
