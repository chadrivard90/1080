// MFD layout - "The Halo MFD". Default F1 tab.
//
// Top (eye level): huge gear inside a curved 15-LED shift sweep, delta to best lap.
// Middle: hybrid management - ERS battery, deploy mode, DRS light that flashes on zone entry.
// Bottom: four-tyre matrix showing surface (outer tread colour) vs core (inner) temperature,
// with brake temperature beside each wheel.

import { F1, F1Theme, F1Data, Tyre } from "f1_state.slint";
import { Panel, DeltaBar } from "f1_widgets.slint";
import { Caption, HBar } from "../common.slint";

struct LedPos {
    x: length,
    y: length,
}

// Tyre drawn as a tread (surface temp colour) around a core panel (core temp).
component TyreCore inherits Rectangle {
    in property <Tyre> t;
    in property <string> label;
    border-radius: 34px;
    background: root.t.surface-color;

    Rectangle {
        x: 20px;
        y: 20px;
        width: parent.width - 40px;
        height: parent.height - 40px;
        border-radius: 18px;
        background: #0b0c0e;
        border-width: 5px;
        border-color: root.t.inner-color;
        VerticalLayout {
            padding: 8px;
            spacing: 0px;
            alignment: center;
            HorizontalLayout {
                Text { text: root.label; color: #ffffff; font-size: 22px; font-weight: 900; }
                Text {
                    horizontal-stretch: 1;
                    text: "\{root.t.wear}% WEAR";
                    color: root.t.wear < 40 ? F1Theme.dim : (root.t.wear < 65 ? F1Theme.yellow : F1Theme.red);
                    font-size: 20px;
                    font-weight: 800;
                    horizontal-alignment: right;
                }
            }
            Text {
                text: "\{root.t.inner}°";
                color: root.t.inner-color;
                font-size: 56px;
                font-weight: 900;
                horizontal-alignment: center;
            }
            Text {
                text: "SURF \{root.t.surface}°";
                color: root.t.surface-color;
                font-size: 22px;
                font-weight: 900;
                horizontal-alignment: center;
            }
        }
    }
}

// Brake disc vector coloured by brake temperature.
component BrakeDisc inherits Rectangle {
    in property <Tyre> t;
    VerticalLayout {
        alignment: center;
        spacing: 6px;
        Rectangle {
            height: 100px;
            Rectangle {
                x: (parent.width - 100px) / 2;
                width: 100px;
                height: 100px;
                border-radius: 50px;
                border-width: 14px;
                border-color: root.t.brake-color;
                background: #0b0c0e;
                drop-shadow-blur: 14px;
                drop-shadow-color: root.t.brake-color.transparentize(0.5);
                Text {
                    width: parent.width;
                    height: parent.height;
                    text: "BRK";
                    color: F1Theme.dim;
                    font-size: 18px;
                    font-weight: 900;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
        Text {
            text: "\{root.t.brake}°";
            color: root.t.brake-color;
            font-size: 32px;
            font-weight: 900;
            horizontal-alignment: center;
        }
    }
}

export component MfdLayout inherits Rectangle {
    property <F1Data> d: F1.data;

    // LED centres lie on a 440px-radius arc (190deg..350deg) around (524, 470) in a
    // 1048x640 frame; these are the 60x60 LED top-left corners.
    property <[LedPos]> leds: [
        { x: 61px, y: 364px }, { x: 84px, y: 279px }, { x: 124px, y: 201px },
        { x: 179px, y: 133px }, { x: 246px, y: 77px }, { x: 323px, y: 35px },
        { x: 407px, y: 9px }, { x: 494px, y: 0px }, { x: 581px, y: 9px },
        { x: 665px, y: 35px }, { x: 742px, y: 77px }, { x: 809px, y: 133px },
        { x: 864px, y: 201px }, { x: 904px, y: 279px }, { x: 927px, y: 364px }
    ];

    VerticalLayout {
        padding: 16px;
        spacing: 14px;

        // ---- Halo: LED sweep + gear -------------------------------------------------------
        halo := Rectangle {
            height: 640px;
            property <length> ox: (self.width - 1048px) / 2;

            // Dark track behind the LEDs and a thin red inner arc.
            Path {
                x: halo.ox;
                y: 0px;
                width: 1048px;
                height: 640px;
                viewbox-width: 1048;
                viewbox-height: 640;
                commands: "M 91 394 A 440 440 0 0 1 957 394";
                stroke: #1c1d22;
                stroke-width: 86px;
                fill: transparent;
            }
            Path {
                x: halo.ox;
                y: 0px;
                width: 1048px;
                height: 640px;
                viewbox-width: 1048;
                viewbox-height: 640;
                commands: "M 169.5 407.5 A 360 360 0 0 1 878.5 407.5";
                stroke: F1Theme.red;
                stroke-width: 5px;
                fill: transparent;
            }

            for led[i] in root.leds : Rectangle {
                property <bool> lit: i < root.d.rev-count;
                property <color> on-color: i < 5 ? F1Theme.green : (i < 10 ? #ff2d2d : F1Theme.purple);
                x: halo.ox + led.x;
                y: led.y;
                width: 60px;
                height: 60px;
                border-radius: 30px;
                border-width: 3px;
                border-color: #2c2e34;
                background: root.d.rev-max
                    ? (root.d.blink ? F1Theme.blue : #0c1430)
                    : (self.lit ? self.on-color : #141518);
                drop-shadow-blur: (self.lit || root.d.rev-max) ? 22px : 0px;
                drop-shadow-color: root.d.rev-max ? F1Theme.blue : self.on-color;
            }

            // Gear
            Text {
                x: halo.ox + 274px;
                y: 210px;
                width: 500px;
                height: 380px;
                text: root.d.gear;
                color: root.d.rev-max && root.d.blink ? F1Theme.blue : #ffffff;
                font-size: 340px;
                font-weight: 900;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            // Speed under the gear
            Text {
                x: halo.ox + 324px;
                y: 568px;
                width: 400px;
                height: 70px;
                text: "\{root.d.speed} " + root.d.speed-unit;
                color: #c8cad2;
                font-size: 52px;
                font-weight: 900;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            // Position (bottom-left) and lap / time (bottom-right)
            VerticalLayout {
                x: 0px;
                y: 470px;
                width: 260px;
                height: 170px;
                alignment: end;
                Caption { text: "POSITION"; }
                Text { text: "P\{root.d.position}"; color: #ffffff; font-size: 92px; font-weight: 900; }
            }
            VerticalLayout {
                x: parent.width - 260px;
                y: 470px;
                width: 260px;
                height: 170px;
                alignment: end;
                Caption { text: root.d.is-race ? "LAP" : "TIME LEFT"; horizontal-alignment: right; }
                Text {
                    text: root.d.is-race ? "\{root.d.lap}/\{root.d.total-laps}" : root.d.time-left;
                    color: #ffffff;
                    font-size: 64px;
                    font-weight: 900;
                    horizontal-alignment: right;
                }
            }
        }

        DeltaBar {
            height: 150px;
            title: "DELTA TO BEST";
            delta: root.d.delta;
            valid: root.d.has-delta;
            text: root.d.delta-text;
            range: 1.0;
            font-size: 96px;
        }

        // ---- Hybrid management --------------------------------------------------------------
        HorizontalLayout {
            height: 320px;
            spacing: 14px;

            Panel {
                title: "ERS BATTERY";
                HorizontalLayout {
                    height: 150px;
                    Rectangle {
                        horizontal-stretch: 1;
                        border-radius: 16px;
                        border-width: 6px;
                        border-color: #3a3c43;
                        background: #0b0c0e;
                        clip: true;
                        Rectangle {
                            x: 10px;
                            y: 10px;
                            height: parent.height - 20px;
                            width: (parent.width - 20px) * root.d.ers-pct;
                            border-radius: 8px;
                            background: F1Theme.ers;
                            animate width { duration: 120ms; }
                        }
                        for i in 9 : Rectangle {
                            x: 10px + (parent.width - 20px) * ((i + 1) * 0.1) - 2px;
                            y: 10px;
                            width: 4px;
                            height: parent.height - 20px;
                            background: #0b0c0e;
                        }
                        Text {
                            width: parent.width;
                            height: parent.height;
                            text: root.d.ers-text;
                            color: root.d.ers-pct > 0.55 ? #000000 : #ffffff;
                            font-size: 84px;
                            font-weight: 900;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    // Battery terminal
                    Rectangle {
                        width: 24px;
                        Rectangle {
                            x: 0px;
                            y: (parent.height - 64px) / 2;
                            width: 20px;
                            height: 64px;
                            border-radius: 4px;
                            background: #3a3c43;
                        }
                    }
                }
                HorizontalLayout {
                    vertical-stretch: 1;
                    spacing: 18px;
                    padding-top: 8px;
                    Rectangle {
                        width: 250px;
                        border-radius: 12px;
                        background: root.d.ers-mode-color;
                        VerticalLayout {
                            alignment: center;
                            Text { text: "DEPLOY"; color: #000000aa; font-size: 18px; font-weight: 900; horizontal-alignment: center; }
                            Text { text: root.d.ers-mode; color: #000000; font-size: 38px; font-weight: 900; horizontal-alignment: center; }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 4px;
                        Caption { text: "DEPLOYED THIS LAP"; font-size: 18px; }
                        HBar { height: 16px; value: root.d.ers-deployed-pct; fill: F1Theme.ers; }
                        Caption { text: "HARVESTED THIS LAP"; font-size: 18px; }
                        HBar { height: 16px; value: root.d.ers-harvested-pct; fill: F1Theme.green; }
                    }
                }
            }

            // DRS light: dark = unavailable, flashing green = in zone / press DRS, solid = open.
            Rectangle {
                width: 330px;
                property <bool> armed: root.d.drs-allowed && !root.d.drs-open;
                border-radius: 22px;
                border-width: 6px;
                border-color: root.d.drs-open || root.d.drs-allowed ? F1Theme.green : #3a3c43;
                background: root.d.drs-open ? F1Theme.green
                    : (self.armed && root.d.blink ? #2bff8855 : F1Theme.panel);
                drop-shadow-blur: root.d.drs-open ? 34px : 0px;
                drop-shadow-color: F1Theme.green;
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: "DRS";
                        color: root.d.drs-open ? #000000 : (root.d.drs-allowed ? F1Theme.green : #4a4c55);
                        font-size: 120px;
                        font-weight: 900;
                        font-italic: true;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: root.d.drs-fault ? "FAULT" : (root.d.drs-open ? "OPEN" : (root.d.drs-allowed ? "ACTIVATE" : "CLOSED"));
                        color: root.d.drs-open ? #000000 : (root.d.drs-fault ? F1Theme.red : (root.d.drs-allowed ? F1Theme.green : #4a4c55));
                        font-size: 30px;
                        font-weight: 900;
                        horizontal-alignment: center;
                    }
                }
            }
        }

        // ---- Tyre matrix --------------------------------------------------------------------
        Rectangle {
            vertical-stretch: 1;
            background: F1Theme.panel;
            border-radius: 18px;
            VerticalLayout {
                padding: 14px;
                spacing: 10px;
                HorizontalLayout {
                    height: 40px;
                    spacing: 14px;
                    Caption { text: "TYRES  CORE / SURFACE"; vertical-alignment: center; }
                    Text {
                        horizontal-stretch: 1;
                        text: root.d.tyre-note;
                        color: F1Theme.orange;
                        font-size: 22px;
                        font-weight: 900;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Rectangle {
                        width: 40px;
                        height: 40px;
                        border-radius: 20px;
                        border-width: 6px;
                        border-color: root.d.tyre-color;
                        background: #000000;
                        Text {
                            width: parent.width;
                            height: parent.height;
                            text: root.d.tyre-compound;
                            color: #ffffff;
                            font-size: 18px;
                            font-weight: 900;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    Text {
                        text: "\{root.d.tyre-age} LAPS";
                        color: #c8cad2;
                        font-size: 24px;
                        font-weight: 800;
                        vertical-alignment: center;
                    }
                }
                HorizontalLayout {
                    vertical-stretch: 1;
                    spacing: 12px;
                    TyreCore { width: 290px; t: root.d.fl; label: "FL"; }
                    BrakeDisc { width: 150px; t: root.d.fl; }
                    Caption { horizontal-stretch: 1; text: "FRONT"; horizontal-alignment: center; vertical-alignment: center; }
                    BrakeDisc { width: 150px; t: root.d.fr; }
                    TyreCore { width: 290px; t: root.d.fr; label: "FR"; }
                }
                HorizontalLayout {
                    vertical-stretch: 1;
                    spacing: 12px;
                    TyreCore { width: 290px; t: root.d.rl; label: "RL"; }
                    BrakeDisc { width: 150px; t: root.d.rl; }
                    Caption { horizontal-stretch: 1; text: "REAR"; horizontal-alignment: center; vertical-alignment: center; }
                    BrakeDisc { width: 150px; t: root.d.rr; }
                    TyreCore { width: 290px; t: root.d.rr; label: "RR"; }
                }
            }
        }
    }
}
